@dataclass
class PGNode:
    spec: PLangSpec
    unified: UnifiedField
    codex: Dict[str, Any]
    edges: List[int] = None

class ProblemGraph:
    def __init__(self):
        self.nodes: List[PGNode] = []
    
    def add(self, spec: PLangSpec, unified: UnifiedField, codex: Dict[str, Any]) -> int:
        node = PGNode(spec=spec, unified=unified, codex=codex, edges=[])
        self.nodes.append(node)
        return len(self.nodes) - 1
    
    def connect(self, a: int, b: int):
        self.nodes[a].edges.append(b)
        self.nodes[b].edges.append(a)
    
    def summary(self) -> Dict[str, Any]:
        return {"nodes": len(self.nodes), "edges": sum(len(n.edges) for n in self.nodes)}

