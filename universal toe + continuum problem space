# 13. COLLAPSE OPERATOR
# ============================================

@dataclass
class CollapseResult:
    resolved: Any
    metadata: dict = None

class CollapseOperator:
    def __init__(self, mode: str = "stabilize"):
        self.mode = mode
    
    def collapse_metric(self, metric_field: np.ndarray) -> np.ndarray:
        return np.clip(metric_field, -10.0, 10.0)
    
    def collapse_modes(self, modes: list) -> list:
        if len(modes) == 0:
            return modes
        modes_sorted = sorted(modes, key=lambda m: m.metadata.get("eigenvalue", 0.0))
        base = modes_sorted[0]
        base.amplitude = base.amplitude / (1.0 + np.abs(base.amplitude))
        return [base]
    
    def collapse_causal(self, causal: CausalStructure) -> CausalStructure:
        cones = np.clip(causal.cones, 0.0, 5.0)
        return CausalStructure(adjacency=causal.adjacency, cones=cones, metadata={"collapsed": True})
    
    def collapse(self, obj: Any) -> CollapseResult:
        if isinstance(obj, np.ndarray):
            return CollapseResult(resolved=self.collapse_metric(obj), metadata={"type": "metric"})
        if isinstance(obj, list):
            return CollapseResult(resolved=self.collapse_modes(obj), metadata={"type": "modes"})
        if isinstance(obj, CausalStructure):
            return CollapseResult(resolved=self.collapse_causal(obj), metadata={"type": "causal"})
        return CollapseResult(resolved=obj, metadata={"type": "unknown"})

# ============================================
# 14. PROBLEM LANGUAGE (PLang)
# ============================================

class PLangParser:
    def parse(self, text: str) -> PLangSpec:
        t = text.lower()
        
        if any(w in t for w in ["metric", "geometry", "space"]):
            pc = ProblemClass.GEOMETRIC_STRUCTURE
        elif any(w in t for w in ["curvature", "gravity"]):
            pc = ProblemClass.CURVATURE_DISTRIBUTION
        elif any(w in t for w in ["mode", "field"]):
            pc = ProblemClass.FIELD_CONFIGURATION
        elif any(w in t for w in ["causal", "cone", "time"]):
            pc = ProblemClass.CAUSAL_STRUCTURE
        elif any(w in t for w in ["interference", "interaction"]):
            pc = ProblemClass.INTERFERENCE_PATTERN
        elif any(w in t for w in ["eigen", "spectrum"]):
            pc = ProblemClass.MODE_FAMILY
        elif any(w in t for w in ["evolve", "pde", "dynamic"]):
            pc = ProblemClass.PDE_EVOLUTION
        else:
            pc = ProblemClass.GEOMETRIC_STRUCTURE
        
        params = {}
        for w in t.split():
            if w.startswith("freq="): params["freq"] = float(w.split("=")[1])
            if w.startswith("steps="): params["steps"] = int(w.split("=")[1])
            if w.startswith("dt="): params["dt"] = float(w.split("=")[1])
            if w.startswith("k="): params["k"] = int(w.split("=")[1])
        
        return PLangSpec(problem_class=pc, params=params, raw_text=text)

