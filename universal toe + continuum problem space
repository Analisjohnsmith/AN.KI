# 17. SOLUTION EXTRACTION ENGINE
# ============================================

@dataclass
class Solution:
    node_id: int
    invariants: Dict[str, Any]
    stable: bool
    summary: Dict[str, Any]

class SolutionExtractionEngine:
    def extract_invariants(self, unified: UnifiedField, codex: Dict[str, Any]) -> Dict[str, Any]:
        inv = {}
        ms = codex.get("metric_signature", {})
        inv["lorentzian"] = ms.get("valid_lorentzian", False)
        cb = codex.get("curvature_bounds", {})
        inv["curvature_bounded"] = cb.get("bounded", True)
        cc = codex.get("causal_consistency", {})
        inv["ctc_free"] = not cc.get("ctc_admissible", False)
        gp = codex.get("gauge_presence", {})
        inv["has_gauge"] = gp.get("has_gauge", False)
        return inv
    
    def is_stable(self, invariants: Dict[str, Any]) -> bool:
        return all(invariants.values())
    
    def summarize(self, unified: UnifiedField, invariants: Dict[str, Any]) -> Dict[str, Any]:
        return {"metric_shape": unified.metric.shape, "invariants": invariants}
    
    def extract(self, idx: int, sdg: StructuralDynamicsGraph) -> Solution:
        node = sdg.nodes[idx]
        inv = self.extract_invariants(node.unified, node.codex)
        stable = self.is_stable(inv)
        return Solution(node_id=idx, invariants=inv, stable=stable, summary=self.summarize(node.unified, inv))

