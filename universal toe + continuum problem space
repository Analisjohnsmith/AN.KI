        self.state.spec = spec
        self.state.structural = structural
        self.state.unified = unified
        self.state.solution = sol.summary

        return {
            "pg_id": pg_id,
            "sdg_id": sdg_id,
            "solution": sol.summary,
            "stable": sol.stable,
            "codex": codex_results
        }


