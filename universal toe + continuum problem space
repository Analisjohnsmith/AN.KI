        if spec.problem_class == ProblemClass.CAUSAL_STRUCTURE:
            causal = self.api.causal(grid_x=grid_x, grid_y=grid_y)
        if spec.problem_class == ProblemClass.PDE_EVOLUTION:
            pde_history = self.api.evolve(grid_x=grid_x,
                                          grid_y=grid_y,
                                          steps=merged.get("steps", 10),
                                          dt=merged.get("dt", 0.05),
                                          freq=merged.get("freq", 1.0))

        return StructuralState(
            metric=metric,
            curvature=curvature,
            modes=modes,
            causal=causal,
            pde_history=pde_history,
            metadata={"problem_class": spec.problem_class.value}
        )

    def process(self, text: str, **kwargs) -> Dict[str, Any]:
        parser = PLangParser()
