                               **kwargs) -> StructuralState:
        merged = {**kwargs, **spec.params}
        grid_x = merged.get("grid_x", np.linspace(-1, 1, 128))
        grid_y = merged.get("grid_y", np.linspace(-1, 1, 128))

        metric = self.api.metric(grid_x=grid_x, grid_y=grid_y)

        curvature = None
        modes = None
        causal = None
        pde_history = None

        if spec.problem_class == ProblemClass.CURVATURE_DISTRIBUTION:
            curvature = self.api.curvature(grid_x=grid_x, grid_y=grid_y)
        if spec.problem_class == ProblemClass.MODE_FAMILY:
            modes = self.api.modes(grid_x=grid_x, grid_y=grid_y,
