@dataclass
class PLangSpec:
    problem_class: ProblemClass
    params: Dict[str, Any]
    raw_text: str


class PLangParser:
    def parse(self, text: str) -> PLangSpec:
        t = text.lower()
        if "metric" in t or "geometry" in t or "space" in t:
            pc = ProblemClass.GEOMETRIC_STRUCTURE
        elif "curvature" in t or "gravity" in t:
            pc = ProblemClass.CURVATURE_DISTRIBUTION
        elif "mode" in t or "field" in t:
            pc = ProblemClass.FIELD_CONFIGURATION
        elif "causal" in t or "cone" in t or "time" in t:
            pc = ProblemClass.CAUSAL_STRUCTURE
        elif "interference" in t or "interaction" in t:
            pc = ProblemClass.INTERFERENCE_PATTERN
        elif "eigen" in t or "spectrum" in t:
            pc = ProblemClass.MODE_FAMILY
        elif "evolve" in t or "pde" in t or "dynamic" in t:
            pc = ProblemClass.PDE_EVOLUTION
        else:
            pc = ProblemClass.GEOMETRIC_STRUCTURE

        params: Dict[str, Any] = {}
        for w in t.split():
            if w.startswith("freq="):
                params["freq"] = float(w.split("=")[1])
            elif w.startswith("steps="):
                params["steps"] = int(w.split("=")[1])
            elif w.startswith("dt="):
                params["dt"] = float(w.split("=")[1])
            elif w.startswith("k="):
                params["k"] = int(w.split("=")[1])

        return PLangSpec(problem_class=pc, params=params, raw_text=text)


