# 12. CODEX (STRUCTURAL LOGIC)
# ============================================

class StructuralCodex:
    def __init__(self, rules: List[CodexRule] = None):
        self.rules = rules or []
    
    def add_rule(self, rule: CodexRule):
        self.rules.append(rule)
    
    def evaluate(self, uf: UnifiedField) -> Dict[str, Any]:
        results = {}
        for rule in self.rules:
            results[rule.name] = rule.apply(uf)
        return results

def rule_metric_signature(uf: UnifiedField) -> Dict[str, Any]:
    g00, g11, g22, g33 = uf.metric[..., 0, 0], uf.metric[..., 1, 1], uf.metric[..., 2, 2], uf.metric[..., 3, 3]
    ok = bool((g00 < 0).all() and (g11 > 0).all() and (g22 > 0).all() and (g33 > 0).all())
    return {"valid_lorentzian": ok, "g00_range": (float(g00.min()), float(g00.max()))}

def rule_curvature_bounds(uf: UnifiedField) -> Dict[str, Any]:
    if uf.curvature is None:
        return {"has_curvature": False}
    R = uf.curvature.scalar
    return {"has_curvature": True, "bounded": bool((abs(R) < 1e6).all())}

def rule_causal_consistency(uf: UnifiedField) -> Dict[str, Any]:
    if uf.causal is None:
        return {"has_causal": False}
    return {"has_causal": True, "ctc_admissible": uf.causal.metadata.get("ctc_admissible", False)}

def rule_gauge_presence(uf: UnifiedField) -> Dict[str, Any]:
    if uf.gauge is None:
        return {"has_gauge": False}
    return {"has_gauge": True, "group": uf.gauge.group}

