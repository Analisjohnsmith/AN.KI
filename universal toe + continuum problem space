        self.edges: List[List[int]] = []
    
    def add(self, unified: UnifiedField, codex: Dict[str, Any]) -> int:
        node = SDGNode(unified=unified, codex=codex, events=[])
        self.nodes.append(node)
        self.edges.append([])
        return len(self.nodes) - 1
    
