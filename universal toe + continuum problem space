pub fn ricci_tensor(
    gamma: &Array4<f64>,
    dgamma_dx: &Array4<f64>,
    dgamma_dy: &Array4<f64>,
) -> Array4<f64> {
    let (ny, nx, _, _) = gamma.dim();
    let mut ricci = Array4::<f64>::zeros((ny, nx, 4, 4));
    for j in 0..ny {
        for i in 0..nx {
            for a in 0..4 {
                for b in 0..4 {
                    let mut sum = 0.0;
                    for k in 0..4 {
                        let idx_kij = k * 16 + a * 4 + b;
                        let dgamma_kij = if k == 1 {
                            dgamma_dx[(j, i, k, idx_kij)]
                        } else if k == 2 {
                            dgamma_dy[(j, i, k, idx_kij)]
                        } else {
                            0.0
                        };
                        let idx_kik = k * 16 + a * 4 + k;
                        let dgamma_jik = if b == 1 {
                            dgamma_dx[(j, i, k, idx_kik)]
                        } else if b == 2 {
                            dgamma_dy[(j, i, k, idx_kik)]
                        } else {
                            0.0
                        };
                        let mut gamma_term = 0.0;
                        for l in 0..4 {
                            let idx_il = a * 16 + l * 4 + k;
                            let idx_jk = l * 16 + b * 4 + k;
                            gamma_term += gamma[(j, i, a, idx_il)] * gamma[(j, i, l, idx_jk)];
                        }
                        sum += dgamma_kij - dgamma_jik + gamma_term;
                    }
                    ricci[(j, i, a, b)] = sum;
                }
            }
        }
    }
    ricci
}

pub fn riemann_tensor(
    gamma: &Array4<f64>,
    dgamma_dx: &Array4<f64>,
    dgamma_dy: &Array4<f64>,
) -> Array4<f64> {
    let (ny, nx, _, _) = gamma.dim();
    let mut riemann = Array4::<f64>::zeros((ny, nx, 4, 4 * 4 * 4));
    for j in 0..ny {
        for i in 0..nx {
            for a in 0..4 {
                for b in 0..4 {
                    for c in 0..4 {
                        for d in 0..4 {
                            let idx_bd = a * 16 + b * 4 + d;
                            let dgamma_c_bd = if c == 1 {
                                dgamma_dx[(j, i, a, idx_bd)]
                            } else if c == 2 {
                                dgamma_dy[(j, i, a, idx_bd)]
                            } else {
                                0.0
                            };
                            let idx_bc = a * 16 + b * 4 + c;
                            let dgamma_d_bc = if d == 1 {
                                dgamma_dx[(j, i, a, idx_bc)]
                            } else if d == 2 {
                                dgamma_dy[(j, i, a, idx_bc)]
                            } else {
                                0.0
                            };
                            let mut gamma_terms = 0.0;
                            for e in 0..4 {
                                let idx_ce = a * 16 + c * 4 + e;
                                let idx_bd_e = e * 16 + b * 4 + d;
                                let idx_de = a * 16 + d * 4 + e;
                                let idx_bc_e = e * 16 + b * 4 + c;
                                gamma_terms += gamma[(j, i, a, idx_ce)]
                                    * gamma[(j, i, e, idx_bd_e)]
                                    - gamma[(j, i, a, idx_de)] * gamma[(j, i, e, idx_bc_e)];
                            }
                            let idx_abcd = a * 64 + b * 16 + c * 4 + d;
                            riemann[(j, i, a, idx_abcd)] =
                                dgamma_c_bd - dgamma_d_bc + gamma_terms;
                        }
                    }
                }
            }
        }
    }
    riemann
}

// ------------------------------------------------------------
// CURVATURE UPDATE
// ------------------------------------------------------------
pub fn scalar_curvature(metric: &Array4<f64>, grid_x: &Array1<f64>, grid_y: &Array1<f64>) -> Array2<f64> {
    let (ny, nx, _, _) = metric.dim();
    let mut curv = Array2::<f64>::zeros((ny, nx));
    let dx = grid_x[1] - grid_x[0];
    let dy = grid_y[1] - grid_y[0];
    for j in 1..ny - 1 {
        for i in 1..nx - 1 {
            let g11 = metric[(j, i, 1, 1)];
            let g22 = metric[(j, i, 2, 2)];
            let d2g11_dx2 =
                (metric[(j, i + 1, 1, 1)] - 2.0 * metric[(j, i, 1, 1)] + metric[(j, i - 1, 1, 1)])
                    / (dx * dx);
            let d2g22_dy2 =
                (metric[(j + 1, i, 2, 2)] - 2.0 * metric[(j, i, 2, 2)] + metric[(j - 1, i, 2, 2)])
                    / (dy * dy);
            curv[(j, i)] = d2g11_dx2 / g11 + d2g22_dy2 / g22;
        }
    }
    curv
}

// ------------------------------------------------------------
// PDE EVOLUTION
// ------------------------------------------------------------
pub fn pde_step(
    field: &Array2<f64>,
    metric: &Array4<f64>,
    grid_x: &Array1<f64>,
    grid_y: &Array1<f64>,
    dt: f64,
    c: f64,
) -> Array2<f64> {
    let (ny, nx) = field.dim();
    let dx = grid_x[1] - grid_x[0];
    let dy = grid_y[1] - grid_y[0];
    let mut next = field.clone();
    for j in 1..ny - 1 {
        for i in 1..nx - 1 {
            let g11 = metric[(j, i, 1, 1)];
            let g22 = metric[(j, i, 2, 2)];
            let d2phi_dx2 =
                (field[(j, i + 1)] - 2.0 * field[(j, i)] + field[(j, i - 1)]) / (dx * dx);
            let d2phi_dy2 =
                (field[(j + 1, i)] - 2.0 * field[(j, i)] + field[(j - 1, i)]) / (dy * dy);
            let lap = (1.0 / g11) * d2phi_dx2 + (1.0 / g22) * d2phi_dy2;
            next[(j, i)] = field[(j, i)] + dt * c * lap;
        }
    }
    next
}

// ------------------------------------------------------------
// GRAPH ADAPTER (graph -> metric/causal)
// ------------------------------------------------------------
pub fn graph_to_structural(
    adjacency: &Array2<f64>,
    grid_x: &Array1<f64>,
    grid_y: &Array1<f64>,
) -> (Array4<f64>, Array2<f64>) {
    let (ny, nx) = (grid_y.len(), grid_x.len());
    let mut metric = Array4::<f64>::zeros((ny, nx, 4, 4));
    let mut causal = Array2::<f64>::zeros((ny, nx));
    for j in 0..ny {
        for i in 0..nx {
            let x = grid_x[i];
            let y = grid_y[j];
            let mut g = general_metric_tensor(x, y, 0.0);
            let idx = j * nx + i;
            if idx < adjacency.shape()[0] {
                for a in 0..4 {
                    for b in 0..4 {
                        g[(a, b)] += adjacency[(idx, idx % adjacency.shape()[0])] * 0.01;
                    }
                }
            }
            for a in 0..4 {
                for b in 0..4 {
                    metric[(j, i, a, b)] = g[(a, b)];
                }
            }
            causal[(j, i)] = (i as f64 - nx as f64 / 2.0).abs() + (j as f64 - ny as f64 / 2.0).abs();
        }
    }
    (metric, causal)
}

