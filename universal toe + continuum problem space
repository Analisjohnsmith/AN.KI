# 18. PERSONA KERNEL
# ============================================

@dataclass
class PersonaState:
    spec: Optional[PLangSpec] = None
    structural: Optional[StructuralState] = None
    unified: Optional[UnifiedField] = None
    solution: Optional[Dict[str, Any]] = None

class PersonaKernel:
    def __init__(self, api: 'SpacetimeAPI', pg: ProblemGraph, sdg: StructuralDynamicsGraph):
        self.api = api
        self.pg = pg
        self.sdg = sdg
        self.state = PersonaState()
        self.see = SolutionExtractionEngine()
    
    def process(self, text: str, **kwargs) -> Dict[str, Any]:
        parser = PLangParser()
        spec = parser.parse(text)
        
        # Solve structural problem
        structural = self.api.engine.solve_structural_problem(spec.problem_class, **kwargs, **spec.params)
        
        # Build unified state
        builder = StructuralStateBuilder()
        state = builder.build(
            metric=self.api.metric(**kwargs),
            curvature=structural if isinstance(structural, CurvatureField) else None,
            modes=structural if isinstance(structural, list) and all(isinstance(m, FieldMode) for m in structural) else None,
            causal=structural if isinstance(structural, CausalStructure) else None,
            interaction=structural if isinstance(structural, InteractionField) else None,
            pde_history=structural if isinstance(structural, list) and all(isinstance(m, np.ndarray) for m in structural) else None
        )
        
        # Handle gauge if requested
        gauge = None
        if "gauge" in text.lower() or "u1" in text.lower() or "su" in text.lower():
            group = "U1"
