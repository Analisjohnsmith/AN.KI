#!/usr/bin/env python3
"""
HELLA - Sovereign Package Manager for VALARI Platform
Lossless compression | Cryptographic verification | Dependency management

Patched: 2026-04-26 — All COE validation findings resolved.
v1.2.0: FIX #17 (type confusion in from_dict) + FIX #18 (backup recovery).
v1.3.0: FIX #19-#26 — Security hardening (signing, decompression limits,
        name/input sanitization, thread locking, TOCTOU protection, auth hooks).
"""

__version__ = "1.3.0"

import hashlib
import hmac
import io
import json
import logging
import os
import re
import sys
import tarfile
import gzip
import zlib
import base64
import time
import shutil
import threading
from functools import cmp_to_key
from pathlib import Path
from typing import Dict, List, Optional, Any, Set
from dataclasses import dataclass, field
from datetime import datetime
import argparse

# ============================================================================
# LOGGING
# ============================================================================

logger = logging.getLogger("hella")
handler = logging.StreamHandler()
handler.setFormatter(logging.Formatter("[%(levelname)s] %(message)s"))
logger.addHandler(handler)
logger.setLevel(logging.INFO)

# ============================================================================
# CONSTANTS — Security Limits (FIX #20, #22, #23)
# ============================================================================

# Name / version / author
MAX_NAME_LENGTH = 128
MAX_VERSION_LENGTH = 32
MAX_AUTHOR_LENGTH = 256
MAX_DESCRIPTION_LENGTH = 10 * 1024   # 10 KB
MAX_DEPENDENCIES = 200
MAX_DECOMPRESSED_SIZE = 500 * 1024 * 1024  # 500 MB — FIX #20

# FIX #23: Package name allowlist — alphanumeric, hyphens, underscores, dots.
_VALID_NAME_RE = re.compile(r'^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$')


# ============================================================================
# UTILITIES
# ============================================================================

def semver_key(v: str) -> tuple:
    """Parse a version string into a tuple of ints for correct ordering."""
    parts = []
    for segment in v.split('.'):
        try:
            parts.append(int(segment))
        except ValueError:
            parts.append(0)
    return tuple(parts)


def validate_name(name: str) -> None:
    """FIX #21/#23: Validate a package name. Raises ValueError on bad input."""
    if not name:
        raise ValueError("Package name cannot be empty.")
    if len(name) > MAX_NAME_LENGTH:
        raise ValueError(
            f"Package name exceeds {MAX_NAME_LENGTH} chars: {len(name)}"
        )
    if '\x00' in name:
        raise ValueError("Package name contains null byte.")
    if not _VALID_NAME_RE.match(name):
        raise ValueError(
            f"Invalid package name '{name[:60]}'. "
            f"Allowed: A-Z, a-z, 0-9, '.', '-', '_'. "
            f"Must start with an alphanumeric character."
        )


def validate_version(version: str) -> None:
    """FIX #22: Validate a version string."""
    if not version:
        raise ValueError("Version cannot be empty.")
    if len(version) > MAX_VERSION_LENGTH:
        raise ValueError(
            f"Version exceeds {MAX_VERSION_LENGTH} chars: {len(version)}"
        )
    if '\x00' in version or '/' in version or '\\' in version:
        raise ValueError(f"Version contains illegal characters: {version!r}")


def validate_metadata(
    author: str, description: str, dependencies: Optional[List[str]]
) -> None:
    """FIX #22: Validate metadata field lengths."""
    if len(author) > MAX_AUTHOR_LENGTH:
        raise ValueError(f"Author exceeds {MAX_AUTHOR_LENGTH} chars.")
    if len(description) > MAX_DESCRIPTION_LENGTH:
        raise ValueError(
            f"Description exceeds {MAX_DESCRIPTION_LENGTH} bytes."
        )
    if dependencies and len(dependencies) > MAX_DEPENDENCIES:
        raise ValueError(
            f"Too many dependencies: {len(dependencies)} (max {MAX_DEPENDENCIES})."
        )

# ============================================================================
# PACKAGE STRUCTURE
# ============================================================================

@dataclass
class Package:
    name: str
    version: str
    author: str
    description: str
    dependencies: List[str] = field(default_factory=list)
    files: List[str] = field(default_factory=list)
    compression_method: str = "gzip"          # FIX #8: persist compression method
    signature: str = ""                       # FIX #19: HMAC-SHA256 signature
    hash: str = ""
    size: int = 0
    compressed_size: int = 0
    created: float = field(default_factory=time.time)

    def compute_hash(self, data: bytes) -> str:
        """Compute SHA-256 hash of the given data."""
        return hashlib.sha256(data).hexdigest()

    def to_dict(self) -> Dict[str, Any]:
        return {
            "name": self.name,
            "version": self.version,
            "author": self.author,
            "description": self.description,
            "dependencies": self.dependencies,
            "files": self.files,
            "compression_method": self.compression_method,
            "signature": self.signature,
            "hash": self.hash,
            "size": self.size,
            "compressed_size": self.compressed_size,
            "created": self.created,
        }

    @classmethod
    def from_dict(cls, data: Dict[str, Any]) -> "Package":
        # FIX #17: Type-coerce every field to survive hostile/corrupt registry JSON
        def _safe_int(val: Any, default: int = 0) -> int:
            try:
                return int(val)
            except (TypeError, ValueError):
                return default

        def _safe_float(val: Any, default: float = 0.0) -> float:
            try:
                return float(val)
            except (TypeError, ValueError):
                return default

        def _safe_list(val: Any) -> List[str]:
            if isinstance(val, list):
                return [str(item) for item in val]
            return []

        def _safe_str(val: Any, default: str = "") -> str:
            try:
                return str(val) if val is not None else default
            except (TypeError, ValueError):
                return default

        return cls(
            name=_safe_str(data.get("name", ""), ""),
            version=_safe_str(data.get("version", "0.0.0"), "0.0.0"),
            author=_safe_str(data.get("author", ""), ""),
            description=_safe_str(data.get("description", ""), ""),
            dependencies=_safe_list(data.get("dependencies", [])),
            files=_safe_list(data.get("files", [])),
            compression_method=_safe_str(data.get("compression_method", "gzip"), "gzip"),
            signature=_safe_str(data.get("signature", ""), ""),
            hash=_safe_str(data.get("hash", ""), ""),
            size=_safe_int(data.get("size", 0)),
            compressed_size=_safe_int(data.get("compressed_size", 0)),
            created=_safe_float(data.get("created", time.time()), time.time()),
        )


# ============================================================================
# HELLA PACKAGE MANAGER
# ============================================================================

class HELLAPackageManager:
    """Sovereign package manager with lossless compression"""

    # Supported compression methods
    COMPRESSION_METHODS = {
        "gzip": lambda data: gzip.compress(data, compresslevel=9),
        "zlib": lambda data: zlib.compress(data, level=9),
        "none": lambda data: data,
    }

    DECOMPRESSION_METHODS = {
        "gzip": gzip.decompress,
        "zlib": zlib.decompress,
        "none": lambda data: data,
    }

    def __init__(
        self,
        registry_path: str = "./hella_registry",
        signing_key: Optional[str] = None,
        max_decompressed_size: int = MAX_DECOMPRESSED_SIZE,
        auth_provider: Optional[callable] = None,
    ) -> None:
        self.registry_path = Path(registry_path)
        self.packages_path = self.registry_path / "packages"
        self.metadata_path = self.registry_path / "metadata"
        self.cache_path = self.registry_path / "cache"
        # FIX #19: Signing key for HMAC-SHA256 package authentication
        self._signing_key: Optional[bytes] = (
            signing_key.encode() if signing_key else None
        )
        # FIX #20: Max decompressed payload size (default 500 MB)
        self._max_decompressed_size = max_decompressed_size
        # FIX #24: Thread lock for registry access
        self._lock = threading.Lock()
        # FIX #25: Track registry mtime for TOCTOU protection
        self._registry_mtime: float = 0.0
        # FIX #26: Optional auth provider callback for publish/uninstall
        self._auth_provider = auth_provider
        self._init_directories()
        self.registry: Dict[str, Dict[str, Package]] = {}
        self._load_registry()

    def _init_directories(self) -> None:
        self.packages_path.mkdir(parents=True, exist_ok=True)
        self.metadata_path.mkdir(parents=True, exist_ok=True)
        self.cache_path.mkdir(parents=True, exist_ok=True)

    # ── Registry I/O (FIX #13: robust JSON error handling) ────────────────

    def _load_registry(self) -> None:
        """Load registry from disk with corruption recovery and TOCTOU tracking."""
        registry_file = self.registry_path / "registry.json"
        backup_file = registry_file.with_suffix(".json.bak")

        def _try_load(path: Path) -> bool:
            if not path.exists():
                return False
            try:
                with open(path, "r") as f:
                    data = json.load(f)
                for name, versions in data.items():
                    self.registry[name] = {}
                    for ver, pkg_data in versions.items():
                        self.registry[name][ver] = Package.from_dict(pkg_data)
                return True
            except (json.JSONDecodeError, KeyError, TypeError):
                return False

        with self._lock:  # FIX #24: thread-safe load
            if _try_load(registry_file):
                # FIX #25: record mtime for TOCTOU detection
                self._registry_mtime = registry_file.stat().st_mtime
                return

            if not registry_file.exists():
                return

            logger.warning(
                "Registry corrupted. Attempting recovery from backup %s",
                backup_file,
            )
            self.registry = {}
            if _try_load(backup_file):
                shutil.copy2(backup_file, registry_file)
                self._registry_mtime = registry_file.stat().st_mtime
                logger.info(
                    "Registry recovered from backup (%d packages).",
                    sum(len(v) for v in self.registry.values()),
                )
                return

            corrupt_archive = registry_file.with_suffix(".json.corrupt")
            shutil.copy2(registry_file, corrupt_archive)
            logger.warning(
                "Backup also unusable. Archived to %s and starting fresh.",
                corrupt_archive,
            )
            self.registry = {}

    def _save_registry(self) -> None:
        """Save registry with atomic write, backup, locking, and TOCTOU check."""
        registry_file = self.registry_path / "registry.json"
        backup_file = registry_file.with_suffix(".json.bak")
        tmp_file = registry_file.with_suffix(".json.tmp")
        data: Dict[str, Dict[str, Any]] = {}
        for name, versions in self.registry.items():
            data[name] = {}
            for ver, pkg in versions.items():
                data[name][ver] = pkg.to_dict()

        with self._lock:  # FIX #24: thread-safe save
            try:
                # FIX #25: TOCTOU — warn if file changed externally
                if registry_file.exists():
                    current_mtime = registry_file.stat().st_mtime
                    if (
                        self._registry_mtime > 0
                        and current_mtime != self._registry_mtime
                    ):
                        logger.warning(
                            "Registry modified externally since last load. "
                            "Overwriting with in-memory state."
                        )
                    shutil.copy2(registry_file, backup_file)

                with open(tmp_file, "w") as f:
                    json.dump(data, f, indent=2)
                tmp_file.replace(registry_file)
                self._registry_mtime = registry_file.stat().st_mtime
            except OSError as exc:
                logger.error("Failed to save registry: %s", exc)

    # ── Compression ───────────────────────────────────────────────────────

    def _compress_data(self, data: bytes, method: str = "gzip") -> bytes:
        """Losslessly compress data."""
        if method not in self.COMPRESSION_METHODS:
            logger.warning("Unknown compression method '%s', falling back to gzip.", method)
            method = "gzip"
        return self.COMPRESSION_METHODS[method](data)

    def _decompress_data(self, data: bytes, method: str = "gzip") -> bytes:
        """Decompress data."""
        if method not in self.DECOMPRESSION_METHODS:
            logger.warning("Unknown decompression method '%s', falling back to gzip.", method)
            method = "gzip"
        return self.DECOMPRESSION_METHODS[method](data)

    # ── Package creation (FIX #9: filename collision guard) ───────────────

    # ── Signing (FIX #19) ─────────────────────────────────────────────────

    def _sign(self, payload: bytes) -> str:
        """Produce an HMAC-SHA256 hex signature. Returns '' if no key."""
        if self._signing_key is None:
            return ""
        return hmac.new(self._signing_key, payload, hashlib.sha256).hexdigest()

    def _verify_signature(
        self, package: 'Package', compressed_data: bytes
    ) -> bool:
        """Verify HMAC-SHA256 signature. Skips if no signing key."""
        if self._signing_key is None:
            return True  # unsigned mode — accept
        if not package.signature:
            logger.error("Package %s-%s is unsigned but signing is enforced.",
                         package.name, package.version)
            return False
        expected = hmac.new(
            self._signing_key, compressed_data, hashlib.sha256
        ).hexdigest()
        return hmac.compare_digest(expected, package.signature)

    # ── Package creation ─────────────────────────────────────────────────

    def create_package(
        self,
        name: str,
        version: str,
        author: str,
        description: str,
        files: List[str],
        dependencies: Optional[List[str]] = None,
        compress: bool = True,
        compression_method: str = "gzip",
    ) -> str:
        """Create a package from files."""

        # FIX #21/#22/#23: Validate all inputs upfront
        validate_name(name)
        validate_version(version)
        validate_metadata(author, description, dependencies)

        temp_dir = self.cache_path / f"{name}-{version}"
        temp_dir.mkdir(exist_ok=True)

        package_files: List[str] = []
        seen_names: set = set()

        for file_path in files:
            src = Path(file_path)
            if not src.exists():
                raise FileNotFoundError(f"File not found: {file_path}")

            # FIX #9 — detect filename collisions
            dest = temp_dir / src.name
            if src.name in seen_names:
                raise ValueError(
                    f"Filename collision: '{src.name}' appears more than once "
                    f"in the input file list. Preserve directory structure or "
                    f"rename the file."
                )
            seen_names.add(src.name)

            if src.is_dir():
                shutil.copytree(src, dest)
                for f in dest.rglob("*"):
                    if f.is_file():
                        package_files.append(str(f.relative_to(temp_dir)))
            else:
                shutil.copy2(src, dest)
                package_files.append(src.name)

        # Create tarball
        tar_path = self.cache_path / f"{name}-{version}.tar"
        with tarfile.open(tar_path, "w") as tar:
            tar.add(temp_dir, arcname=".")

        with open(tar_path, "rb") as f:
            tar_data = f.read()

        original_size = len(tar_data)

        if compress:
            compressed_data = self._compress_data(tar_data, compression_method)
            compressed_size = len(compressed_data)
            extension = ".tar.gz"
        else:
            compressed_data = tar_data
            compressed_size = original_size
            compression_method = "none"
            extension = ".tar"

        package_hash = hashlib.sha256(compressed_data).hexdigest()

        package_path = self.packages_path / f"{name}-{version}{extension}"
        with open(package_path, "wb") as f:
            f.write(compressed_data)

        # FIX #19: Sign the compressed payload
        package_signature = self._sign(compressed_data)

        package = Package(
            name=name,
            version=version,
            author=author,
            description=description,
            dependencies=dependencies or [],
            files=package_files,
            compression_method=compression_method,
            signature=package_signature,
            hash=package_hash,
            size=original_size,
            compressed_size=compressed_size,
        )

        metadata_path = self.metadata_path / f"{name}-{version}.json"
        with open(metadata_path, "w") as f:
            json.dump(package.to_dict(), f, indent=2)

        if name not in self.registry:
            self.registry[name] = {}
        self.registry[name][version] = package
        self._save_registry()

        # Cleanup
        shutil.rmtree(temp_dir)
        tar_path.unlink()

        compression_ratio = (1 - compressed_size / original_size) * 100 if original_size > 0 else 0.0
        logger.info("📦 Created package: %s-%s", name, version)
        logger.info("   Size: %s → %s bytes (%.1f%% compression)",
                     f"{original_size:,}", f"{compressed_size:,}", compression_ratio)
        logger.info("   Hash: %s...", package_hash[:16])

        return str(package_path)

    # ── Publish ───────────────────────────────────────────────────────────

    def publish(
        self,
        name: str,
        version: str,
        author: str,
        description: str,
        files: List[str],
        dependencies: Optional[List[str]] = None,
        registry_url: Optional[str] = None,
    ) -> bool:
        """Publish package to registry."""

        # FIX #26: Auth gate — deny if auth_provider rejects
        if self._auth_provider is not None:
            if not self._auth_provider("publish", name, version):
                logger.error("Auth denied for publish of %s-%s", name, version)
                return False

        # FIX #21/#22/#23: Validate inputs at publish boundary too
        validate_name(name)
        validate_version(version)
        validate_metadata(author, description, dependencies)

        # FIX #4 — pre-check file existence before handing off to create_package
        missing = [f for f in files if not Path(f).exists()]
        if missing:
            logger.error(
                "❌ Cannot publish '%s': the following source files are missing: %s",
                name, ", ".join(missing),
            )
            return False

        package_path = self.create_package(
            name, version, author, description, files, dependencies
        )

        if registry_url:
            logger.info("📤 Publishing to %s...", registry_url)
            # Upload logic placeholder
        else:
            logger.info("✅ Package published locally to %s", package_path)

        return True

    # ── Install (FIX #1, #3, #5, #6) ─────────────────────────────────────

    def install(
        self,
        name: str,
        version: Optional[str] = None,
        target_dir: str = "./installed",
        _visited: Optional[Set[str]] = None,        # FIX #5: cycle guard
    ) -> bool:
        """Install a package and its dependencies."""

        # FIX #5 — circular-dependency detection
        if _visited is None:
            _visited = set()

        install_key = f"{name}@{version or 'latest'}"
        if install_key in _visited:
            logger.warning("⚠️  Circular dependency detected for %s — skipping.", install_key)
            return True
        _visited.add(install_key)

        if name not in self.registry:
            logger.error("❌ Package '%s' not found in registry", name)
            return False

        versions = self.registry[name]

        # FIX #3 — proper semantic-version resolution
        if version is None:
            version = max(versions.keys(), key=semver_key)

        if version not in versions:
            logger.error("❌ Version '%s' not found for '%s'", version, name)
            return False

        package = versions[version]

        # Install dependencies (with visited set forwarded)
        for dep in package.dependencies:
            dep_name, dep_ver = dep.split("@") if "@" in dep else (dep, None)
            self.install(dep_name, dep_ver, target_dir, _visited)

        # Locate package file
        package_file: Optional[Path] = None
        for ext in [".tar.gz", ".tar"]:
            candidate = self.packages_path / f"{name}-{version}{ext}"
            if candidate.exists():
                package_file = candidate
                break

        if not package_file:
            logger.error("❌ Package file not found for %s-%s", name, version)
            return False

        # Read compressed archive
        with open(package_file, "rb") as f:
            compressed_data = f.read()

        # COE FIX — Verify hash BEFORE decompression.
        computed_hash = hashlib.sha256(compressed_data).hexdigest()
        if computed_hash != package.hash:
            logger.error("Package hash mismatch! Possible corruption or tampering.")
            return False

        # FIX #19: Verify HMAC signature if signing is enforced
        if not self._verify_signature(package, compressed_data):
            logger.error("Package signature mismatch for %s-%s! Rejecting.",
                         name, version)
            return False

        # FIX #8 — use stored compression_method
        method = package.compression_method
        try:
            decompressed_data = self._decompress_data(compressed_data, method)
        except Exception as exc:
            logger.error("Decompression failed for %s-%s: %s", name, version, exc)
            return False

        # FIX #20: Enforce decompression size limit
        if len(decompressed_data) > self._max_decompressed_size:
            logger.error(
                "Decompressed size %s bytes exceeds limit %s for %s-%s. "
                "Possible decompression bomb.",
                f"{len(decompressed_data):,}",
                f"{self._max_decompressed_size:,}",
                name, version,
            )
            return False

        # Extract to target directory
        target_path = Path(target_dir) / name
        target_path.mkdir(parents=True, exist_ok=True)

        # FIX #1 — wrap bytes in BytesIO for tarfile
        # FIX #6 — use filter='data' to prevent path-traversal attacks
        try:
            with tarfile.open(fileobj=io.BytesIO(decompressed_data), mode="r:") as tar:
                tar.extractall(target_path, filter="data")
        except Exception as exc:
            logger.error("❌ Extraction failed for %s-%s: %s", name, version, exc)
            return False

        logger.info("✅ Installed %s-%s to %s", name, version, target_path)
        return True

    # ── Uninstall (FIX #7: real implementation) ───────────────────────────

    def uninstall(self, name: str, version: Optional[str] = None) -> bool:
        """Uninstall a package — removes files, metadata, and registry entry."""

        # FIX #26: Auth gate — deny if auth_provider rejects
        if self._auth_provider is not None:
            if not self._auth_provider("uninstall", name, version):
                logger.error("Auth denied for uninstall of %s-%s", name, version)
                return False

        if name not in self.registry:
            logger.error("❌ Package '%s' not found in registry", name)
            return False

        versions = self.registry[name]

        if version is None:
            version = max(versions.keys(), key=semver_key)

        if version not in versions:
            logger.error("❌ Version '%s' not found for '%s'", version, name)
            return False

        # Check for reverse dependencies
        dependents = []
        for pkg_name, pkg_versions in self.registry.items():
            for _ver, pkg in pkg_versions.items():
                for dep in pkg.dependencies:
                    dep_name = dep.split("@")[0] if "@" in dep else dep
                    if dep_name == name:
                        dependents.append(f"{pkg_name}@{_ver}")

        if dependents:
            logger.warning(
                "⚠️  The following packages depend on '%s': %s. "
                "Uninstalling anyway — dependent packages may break.",
                name, ", ".join(dependents),
            )

        # Remove package archive
        for ext in [".tar.gz", ".tar"]:
            archive = self.packages_path / f"{name}-{version}{ext}"
            if archive.exists():
                archive.unlink()
                logger.info("   Removed archive %s", archive.name)

        # Remove metadata
        meta_file = self.metadata_path / f"{name}-{version}.json"
        if meta_file.exists():
            meta_file.unlink()
            logger.info("   Removed metadata %s", meta_file.name)

        # Remove installed directory (best-effort)
        installed_dir = Path("./installed") / name
        if installed_dir.exists():
            shutil.rmtree(installed_dir)
            logger.info("   Removed installed files at %s", installed_dir)

        # Update registry
        del self.registry[name][version]
        if not self.registry[name]:
            del self.registry[name]
        self._save_registry()

        logger.info("🗑️  Uninstalled %s-%s", name, version)
        return True

    # ── Query methods ─────────────────────────────────────────────────────

    def list_packages(self) -> List[str]:
        """List all available packages."""
        return list(self.registry.keys())

    def search(self, query: str) -> List[Dict[str, Any]]:
        """Search for packages."""
        results: List[Dict[str, Any]] = []
        for name, versions in self.registry.items():
            if query.lower() in name.lower():
                for ver, pkg in versions.items():
                    results.append({
                        "name": name,
                        "version": ver,
                        "description": pkg.description,
                        "author": pkg.author,
                        "size": pkg.compressed_size,
                    })
        return results

    def info(self, name: str, version: Optional[str] = None) -> Optional[Dict[str, Any]]:
        """Get package information."""
        if name not in self.registry:
            return None

        versions = self.registry[name]

        # FIX #3 — semver sort
        if version is None:
            version = max(versions.keys(), key=semver_key)

        if version not in versions:
            return None

        pkg = versions[version]

        # FIX #2 — division-by-zero guard
        compression_ratio = (1 - pkg.compressed_size / pkg.size) * 100 if pkg.size > 0 else 0.0

        return {
            "name": pkg.name,
            "version": pkg.version,
            "author": pkg.author,
            "description": pkg.description,
            "dependencies": pkg.dependencies,
            "files": len(pkg.files),
            "size_bytes": pkg.size,
            "compressed_bytes": pkg.compressed_size,
            "compression_ratio": compression_ratio,
            "compression_method": pkg.compression_method,
            "hash": pkg.hash[:16] + "..." if pkg.hash else "",
            "created": datetime.fromtimestamp(pkg.created).isoformat(),
        }


