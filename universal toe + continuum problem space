// ENGINE - CONTAINS ALL PROBLEMS
// ------------------------------------------------------------
pub struct StructuralEngine {
    params: HashMap<String, f64>,
}

impl StructuralEngine {
    pub fn new(params: HashMap<String, f64>) -> Self {
        Self { params }
    }

    pub fn solve(&self, class: ProblemClass, grid_x: &Array1<f64>, grid_y: &Array1<f64>) -> StructuralObject {
        let t = *self.params.get("t").unwrap_or(&0.0);
        let nx = grid_x.len();
        let ny = grid_y.len();

        let mut metric = Array4::<f64>::zeros((ny, nx, 4, 4));
        for j in 0..ny {
            for i in 0..nx {
                let x = grid_x[i];
                let y = grid_y[j];
                let g = general_metric_tensor(x, y, t);
                for a in 0..4 {
                    for b in 0..4 {
                        metric[(j, i, a, b)] = g[(a, b)];
                    }
                }
            }
        }

        let curvature = scalar_curvature(&metric, grid_x, grid_y);
        let field = Array2::<f64>::zeros((ny, nx));
        let causal = Array2::<f64>::zeros((ny, nx));
        let modes = vec![Array2::<f64>::zeros((ny, nx))];

        let mut graph = None;
        let mut mesh = None;
        let mut constraints = None;

        match class {
            ProblemClass::Metric => {}
            ProblemClass::Curvature => {}
            ProblemClass::Field => {}
            ProblemClass::Causal => {}
            ProblemClass::ModeFamily => {}
            ProblemClass::PdeEvolution => {}
            ProblemClass::CoupledEvolution => {}
            ProblemClass::GraphPath => {
                let mut adj = Array2::<f64>::zeros((ny * nx, ny * nx));
                for j in 0..ny {
                    for i in 0..nx {
                        let idx = j * nx + i;
                        if j > 0 {
                            adj[(idx, idx - nx)] = 1.0;
                        }
                        if j < ny - 1 {
                            adj[(idx, idx + nx)] = 1.0;
                        }
                        if i > 0 {
                            adj[(idx, idx - 1)] = 1.0;
                        }
                        if i < nx - 1 {
                            adj[(idx, idx + 1)] = 1.0;
                        }
                    }
                }
                graph = Some(adj);
            }
            ProblemClass::MeshAnalysis => {
                let mut m = Array4::<f64>::zeros((ny, nx, 3, 3));
                for j in 0..ny {
                    for i in 0..nx {
                        for a in 0..3 {
                            for b in 0..3 {
                                m[(j, i, a, b)] = metric[(j, i, a, b)];
                            }
                        }
                    }
                }
                mesh = Some(m);
            }
            ProblemClass::ConstraintSolve => {
                let mut c = Array2::<f64>::zeros((ny, nx));
                for j in 0..ny {
                    for i in 0..nx {
                        c[(j, i)] = ((i as f64 - nx as f64 / 2.0).abs()
                            + (j as f64 - ny as f64 / 2.0).abs())
                            * 0.1;
                    }
                }
                constraints = Some(c);
            }
        }

        StructuralObject {
            metric,
            curvature,
            field,
            causal,
            modes,
            graph,
            mesh,
            constraints,
            metadata: self.params.clone(),
        }
    }
}

