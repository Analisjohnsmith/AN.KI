# ============================================
# 3. UTILITY FUNCTIONS
# ============================================

def numerical_derivative(field: np.ndarray, axis: int, dx: float) -> np.ndarray:
    der = np.zeros_like(field)
    if axis == 0:
        der[1:-1, :] = (field[2:, :] - field[:-2, :]) / (2*dx)
    else:
        der[:, 1:-1] = (field[:, 2:] - field[:, :-2]) / (2*dx)
    return der

# ============================================
# 4. VALIDATION FUNCTIONS
# ============================================

def validate_metric(metric: np.ndarray) -> bool:
    return not np.any(np.isnan(metric)) and not np.any(np.isinf(metric))

def validate_curvature(curvature: np.ndarray) -> bool:
    return not np.any(np.isnan(curvature)) and not np.any(np.isinf(curvature))

def validate_pde_stability(dx: float, dy: float, dt: float, c: float) -> bool:
    return c * dt / min(dx, dy) < 1.0

# ============================================
# 5. FALLBACK FUNCTIONS
# ============================================

def fallback_metric(grid_x: np.ndarray, grid_y: np.ndarray) -> np.ndarray:
    H, W = len(grid_x), len(grid_y)
    metric = np.zeros((H, W, 4, 4))
    metric[..., 0, 0] = -1.0
    metric[..., 1, 1] = 1.0
    metric[..., 2, 2] = 1.0
    metric[..., 3, 3] = 1.0
    return metric

def fallback_curvature(H: int, W: int) -> np.ndarray:
    return np.zeros((H, W))

def fallback_pde(H: int, W: int, steps: int) -> list:
    return [np.zeros((H, W)) for _ in range(steps)]

# ============================================
# 6. SPACETIME ENGINE — CORE
# ============================================

class SpacetimeEngineError(Exception):
    pass

class SpacetimeEngine:
    def __init__(self, curvature_atom: CurvatureAtom = None):
        self.curvature_atom = curvature_atom or CurvatureAtom(params={"kappa": 0.1, "lambda": -0.05, "sigma": 0.02})
    
    def generate_metric_field(self, grid_x: np.ndarray, grid_y: np.ndarray, t: float = 0.0) -> np.ndarray:
        return self.curvature_atom.generate(grid_x, grid_y, t)
    
    def generate_field_mode(self, metric_field: np.ndarray, freq: float) -> FieldMode:
        H, W, _, _ = metric_field.shape
        x = np.linspace(-1, 1, W)
        y = np.linspace(-1, 1, H)
        X, Y = np.meshgrid(x, y, indexing='ij')
        amplitude = np.exp(1j * 2 * np.pi * freq * X) * np.exp(1j * 2 * np.pi * freq * Y)
        return FieldMode(amplitude=amplitude, metric=metric_field, metadata={"freq": freq})
    
    def generate_eigenmodes(self, grid_x: np.ndarray, grid_y: np.ndarray, k: int = 6) -> list:
        H, W = len(grid_x), len(grid_y)
        dx = grid_x[1] - grid_x[0]
        dy = grid_y[1] - grid_y[0]
        
        # Build flat Laplacian
        N = H * W
        main = -2.0 * (1.0/(dx*dx) + 1.0/(dy*dy))
        off_x = 1.0/(dx*dx)
        off_y = 1.0/(dy*dy)
        offsets = [0, -1, 1, -W, W]
        data = [np.full(N, main), np.full(N-1, off_x), np.full(N-1, off_x),
                np.full(N-W, off_y), np.full(N-W, off_y)]
        L = diags(data, offsets, shape=(N, N), format="csr")
        
        vals, vecs = eigsh(L, k=min(k, N-1), which="SM")
        
        modes = []
        for i in range(len(vals)):
            amp = vecs[:, i].reshape(H, W)
            modes.append(FieldMode(amplitude=amp, metric=None, metadata={"eigenvalue": float(vals[i])}))
        return modes
    
    def compute_scalar_curvature(self, metric_field: np.ndarray, grid_x: np.ndarray, grid_y: np.ndarray) -> CurvatureField:
        H, W, _, _ = metric_field.shape
        g11 = metric_field[..., 1, 1]
        g22 = metric_field[..., 2, 2]
        
        dx = grid_x[1] - grid_x[0] if len(grid_x) > 1 else 1.0
        dy = grid_y[1] - grid_y[0] if len(grid_y) > 1 else 1.0
        
        dg11_dx = numerical_derivative(g11, axis=1, dx=dx)
        dg22_dy = numerical_derivative(g22, axis=0, dx=dy)
        d2g11_dx2 = numerical_derivative(dg11_dx, axis=1, dx=dx)
        d2g22_dy2 = numerical_derivative(dg22_dy, axis=0, dx=dy)
        
        scalar = (1.0/g11) * d2g11_dx2 + (1.0/g22) * d2g22_dy2
        
        return CurvatureField(scalar=scalar, metadata={"method": "finite_difference_diagonal", "dx": dx, "dy": dy})
    
    def evolve_wave_equation(self, initial_field: np.ndarray, grid_x: np.ndarray, grid_y: np.ndarray,
                             steps: int, dt: float, c: float = 1.0) -> List[np.ndarray]:
        H, W = initial_field.shape
        dx = grid_x[1] - grid_x[0]
        dy = grid_y[1] - grid_y[0]
        
        if not validate_pde_stability(dx, dy, dt, c):
            raise SpacetimeEngineError("PDE stability condition violated")
        
        phi = initial_field.copy()
        phi_prev = initial_field.copy()
        history = []
        
        for _ in range(steps):
            lap = np.zeros_like(phi)
            lap[1:-1, :] += (phi[2:, :] - 2*phi[1:-1, :] + phi[:-2, :]) / (dy*dy)
            lap[:, 1:-1] += (phi[:, 2:] - 2*phi[:, 1:-1] + phi[:, :-2]) / (dx*dx)
            phi_next = 2*phi - phi_prev + (c*c)*(dt*dt)*lap
            history.append(phi_next.copy())
            phi_prev, phi = phi, phi_next
        
        return history
    
    def solve_structural_problem(self, problem_class: ProblemClass, **kwargs) -> Any:
        grid_x = kwargs.get("grid_x", np.linspace(-1, 1, 128))
        grid_y = kwargs.get("grid_y", np.linspace(-1, 1, 128))
        t = kwargs.get("t", 0.0)
        freq = kwargs.get("freq", 1.0)
        
        metric_field = self.generate_metric_field(grid_x, grid_y, t)
        
        if not validate_metric(metric_field):
            metric_field = fallback_metric(grid_x, grid_y)
        
        if problem_class == ProblemClass.GEOMETRIC_STRUCTURE:
            return metric_field
        
        elif problem_class == ProblemClass.FIELD_CONFIGURATION:
            return self.generate_field_mode(metric_field, freq)
        
        elif problem_class == ProblemClass.CURVATURE_DISTRIBUTION:
            return self.compute_scalar_curvature(metric_field, grid_x, grid_y)
        
        elif problem_class == ProblemClass.CAUSAL_STRUCTURE:
            H, W, _, _ = metric_field.shape
            cones = np.ones((H, W, 2))
            adjacency = np.zeros((H*W, H*W), dtype=int)
            for j in range(H):
                for i in range(W):
                    k = j*W + i
                    if j > 0: adjacency[k, (j-1)*W + i] = 1
                    if j < H-1: adjacency[k, (j+1)*W + i] = 1
                    if i > 0: adjacency[k, j*W + (i-1)] = 1
                    if i < W-1: adjacency[k, j*W + (i+1)] = 1
            return CausalStructure(adjacency=adjacency, cones=cones)
        
        elif problem_class == ProblemClass.INTERFERENCE_PATTERN:
            mode1 = self.generate_field_mode(metric_field, freq)
            mode2 = self.generate_field_mode(metric_field, freq * 1.5)
            return InteractionField(amplitude=mode1.amplitude + mode2.amplitude, metric=metric_field)
        
        elif problem_class == ProblemClass.MODE_FAMILY:
            return self.generate_eigenmodes(grid_x, grid_y, k=kwargs.get("k", 6))
        
        elif problem_class == ProblemClass.PDE_EVOLUTION:
            initial = self.generate_field_mode(metric_field, freq).amplitude.real
            steps = kwargs.get("steps", 10)
            dt = kwargs.get("dt", 0.05)
            return self.evolve_wave_equation(initial, grid_x, grid_y, steps, dt)
        
        raise SpacetimeEngineError(f"Unsupported problem class: {problem_class}")

# ============================================
# 7. GAUGE FIELD GENERATORS
# ============================================

def generate_u1_field(metric_field: np.ndarray, strength: float = 0.1) -> GaugeField:
    g11 = metric_field[..., 1, 1]
    dx, dy = 1.0, 1.0
    Ax = numerical_derivative(g11, axis=1, dx=dx)
    Ay = numerical_derivative(g11, axis=0, dx=dy)
    return GaugeField(A=np.stack([Ax, Ay], axis=-1), group="U1", metadata={"strength": strength})

def generate_su2_field(metric_field: np.ndarray, strength: float = 0.05) -> GaugeField:
    g22 = metric_field[..., 2, 2]
    dx, dy = 1.0, 1.0
    comp1 = numerical_derivative(g22, axis=1, dx=dx)
    comp2 = numerical_derivative(g22, axis=0, dx=dy)
    comp3 = comp1 - comp2
    return GaugeField(A=np.stack([comp1, comp2, comp3], axis=-1), group="SU2", metadata={"strength": strength})

def generate_su3_field(metric_field: np.ndarray, strength: float = 0.02) -> GaugeField:
    g33 = metric_field[..., 3, 3]
    dx, dy = 1.0, 1.0
    comps = [numerical_derivative(g33, axis=i%2, dx=dx if i%2 else dy) for i in range(8)]
    return GaugeField(A=np.stack(comps, axis=-1), group="SU3", metadata={"strength": strength})

# ============================================
# 8. METRIC-COUPLED PDE
# ============================================

def laplacian_metric_weighted(field: np.ndarray, metric_field: np.ndarray, dx: float, dy: float) -> np.ndarray:
    g11 = metric_field[..., 1, 1]
    g22 = metric_field[..., 2, 2]
    lap = np.zeros_like(field)
    lap[:, 1:-1] += g11[:, 1:-1] * (field[:, 2:] - 2*field[:, 1:-1] + field[:, :-2]) / (dx*dx)
    lap[1:-1, :] += g22[1:-1, :] * (field[2:, :] - 2*field[1:-1, :] + field[:-2, :]) / (dy*dy)
    return lap

# ============================================
# 9. RENORMALIZER
# ============================================

class Renormalizer:
    def __init__(self, step_factor: float = 1.1):
        self.step_factor = step_factor
    
    def flow_metric(self, metric: np.ndarray, scale: float) -> np.ndarray:
        g = metric / (1.0 + 0.01 * scale)
        return np.clip(g, -20.0, 20.0)
    
    def flow_curvature(self, curvature: CurvatureField, scale: float) -> CurvatureField:
        R = curvature.scalar / (1.0 + 0.05 * scale)
        return CurvatureField(scalar=R, metadata={"scale": scale})
    
    def flow_modes(self, modes: list, scale: float) -> list:
        new_modes = []
        for m in modes:
            amp = m.amplitude / (1.0 + 0.02 * scale)
            ev = m.metadata.get("eigenvalue", 0.0) / (1.0 + 0.03 * scale)
            new_modes.append(MetricEigenMode(amplitude=amp, eigenvalue=ev, metric=m.metric, metadata={"scale": scale}))
        return new_modes
    
    def step(self, state: StructuralState, scale: float) -> RGState:
        return RGState(
            scale=scale,
            metric=self.flow_metric(state.metric, scale),
            curvature=self.flow_curvature(state.curvature, scale) if state.curvature else None,
            modes=self.flow_modes(state.modes, scale) if state.modes else None,
            metadata={"step_factor": self.step_factor}
        )
    
    def run(self, state: StructuralState, steps: int = 5) -> list:
        results = []
        scale = 1.0
        for _ in range(steps):
            results.append(self.step(state, scale))
            scale *= self.step_factor
        return results

