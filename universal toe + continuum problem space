@dataclass
class CodexRule:
    name: str
    apply: Callable[[UnifiedField], Dict[str, Any]]


class StructuralCodex:
    def __init__(self, rules: Optional[List[CodexRule]] = None):
        self.rules = rules or []

    def add_rule(self, rule: CodexRule):
        self.rules.append(rule)

    def evaluate(self, uf: UnifiedField) -> Dict[str, Any]:
        out: Dict[str, Any] = {}
        for rule in self.rules:
            out[rule.name] = rule.apply(uf)
        return out


def rule_metric_signature(uf: UnifiedField) -> Dict[str, Any]:
    g00 = uf.metric[..., 0, 0]
    g11 = uf.metric[..., 1, 1]
    g22 = uf.metric[..., 2, 2]
    g33 = uf.metric[..., 3, 3]

    ok = bool((g00 < 0).all() and (g11 > 0).all() and (g22 > 0).all() and (g33 > 0).all())
    return {
        "valid_lorentzian": ok,
        "g00_range": (float(g00.min()), float(g00.max())),
        "g11_range": (float(g11.min()), float(g11.max()))
    }


def rule_curvature_bounds(uf: UnifiedField) -> Dict[str, Any]:
    if uf.curvature is None:
        return {"has_curvature": False}
    R = uf.curvature
    return {
        "has_curvature": True,
        "min_R": float(R.min()),
        "max_R": float(R.max()),
        "bounded": bool((np.abs(R) < 1e6).all())
    }


def rule_causal_consistency(uf: UnifiedField) -> Dict[str, Any]:
    if uf.causal is None:
        return {"has_causal": False}
    cones = uf.causal.cones
    return {
        "has_causal": True,
        "cone_angle_range": (float(cones[..., 0].min()), float(cones[..., 0].max())),
        "ctc_admissible": uf.causal.metadata.get("ctc_admissible", False)
    }


class CodexEngine:
    def __init__(self):
        self.codex = StructuralCodex()
        self.codex.add_rule(CodexRule("metric_signature", rule_metric_signature))
        self.codex.add_rule(CodexRule("curvature_bounds", rule_curvature_bounds))
        self.codex.add_rule(CodexRule("causal_consistency", rule_causal_consistency))

    def evaluate(self, uf: UnifiedField) -> Dict[str, Any]:
        return self.codex.evaluate(uf)


