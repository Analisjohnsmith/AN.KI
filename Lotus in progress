// ---- Monad definition ----
pub struct Monad<T, G, Phi, M>
where
    T: Fn(usize) -> usize,
    G: Fn(usize, usize, usize) -> Point,
    Phi: Fn(&Layer, &Layer) -> Vec<Connection>,
    M: Fn(&State) -> f64,
{
    pub t: T,
    pub g: G,
    pub phi: Phi,
    pub m: M,
}

impl<T, G, Phi, M> Monad<T, G, Phi, M>
where
    T: Fn(usize) -> usize,
    G: Fn(usize, usize, usize) -> Point,
    Phi: Fn(&Layer, &Layer) -> Vec<Connection>,
    M: Fn(&State) -> f64,
{
    pub fn new(t: T, g: G, phi: Phi, m: M) -> Self { Self { t, g, phi, m } }

    pub fn raw_step(&self, state: &State) -> State {
        let n_next = (self.t)(state.layer.len());
        let mut next_layer = Vec::with_capacity(n_next);
        for i in 0..n_next {
            let pt = (self.g)(state.layer.len(), i, n_next);
            next_layer.push(pt);
        }
        let connections = (self.phi)(&state.layer, &next_layer);
        State::new(next_layer, connections)
    }

    pub fn step_enforced(&self, state: &State) -> (State, bool) {
        let mut next_state = self.raw_step(state);
        let mut corrected = false;
        let mut scale = 1.0;
        while (self.m)(&next_state) < (self.m)(state) && scale < 10.0 {
            let new_layer: Layer = next_state.layer.iter()
                .map(|p| Point::new(p.x * scale, p.y * scale))
                .collect();
            let connections = (self.phi)(&state.layer, &new_layer);
            next_state = State::new(new_layer, connections);
            scale += 0.1;
            corrected = true;
        }
        (next_state, corrected)
    }

    pub fn shell(&self, seed: State, n: usize) -> Vec<(State, bool)> {
        let mut states = Vec::new();
        let mut cur = seed;
        for _ in 0..n {
            let (next, corr) = self.step_enforced(&cur);
            states.push((next.clone(), corr));
            cur = next;
        }
        states
    }
}

