
```rust
use std::collections::HashMap;

// -----------------------------------------------------------------------------
// Core data types
// -----------------------------------------------------------------------------

/// A point in 2D space.
#[derive(Debug, Clone, Copy, PartialEq)]
pub struct Point {
    pub x: f64,
    pub y: f64,
}

impl Point {
    pub fn new(x: f64, y: f64) -> Self {
        Self { x, y }
    }

    /// Euclidean distance between two points.
    pub fn distance(&self, other: &Self) -> f64 {
        ((self.x - other.x).powi(2) + (self.y - other.y).powi(2)).sqrt()
    }
}

/// A layer is simply a list of points.
pub type Layer = Vec<Point>;

/// A connection is an edge between a point in layer `k` and a point in layer `k+1`.
/// Stored as (index_in_current_layer, index_in_next_layer).
pub type Connection = (usize, usize);

/// A state consists of the current layer and the connections that led to it
/// (i.e., the mapping from the previous layer to this one).
/// For the initial state, `prev_connections` is empty.
#[derive(Debug, Clone)]
pub struct State {
    pub layer: Layer,
    pub prev_connections: Vec<Connection>, // from previous layer to this one
}

impl State {
    pub fn new(layer: Layer, prev_connections: Vec<Connection>) -> Self {
        Self {
            layer,
            prev_connections,
        }
    }
}

// -----------------------------------------------------------------------------
// The Monad – parameterized by T, G, Φ and M
// -----------------------------------------------------------------------------

/// A Monad is defined by three functions:
/// - `T`:  how many points in the next layer (usize → usize)
/// - `G`:  where the points go (step index, point index, total count → Point)
/// - `Φ`:  how the current layer connects to the next (two layers → connections)
/// - `M`:  a measurement function for self‑strengthening (State → f64)
pub struct Monad<T, G, Phi, M>
where
    T: Fn(usize) -> usize,
    G: Fn(usize, usize, usize) -> Point,
    Phi: Fn(&Layer, &Layer) -> Vec<Connection>,
    M: Fn(&State) -> f64,
{
    pub t: T,
    pub g: G,
    pub phi: Phi,
    pub m: M,
}

impl<T, G, Phi, M> Monad<T, G, Phi, M>
where
    T: Fn(usize) -> usize,
    G: Fn(usize, usize, usize) -> Point,
    Phi: Fn(&Layer, &Layer) -> Vec<Connection>,
    M: Fn(&State) -> f64,
{
    /// Create a new Monad from its defining functions.
    pub fn new(t: T, g: G, phi: Phi, m: M) -> Self {
        Self { t, g, phi, m }
    }

    /// Evolve one step from a given state.
    /// Returns the next state and a boolean indicating whether
    /// the self‑strengthening condition held.
    pub fn step(&self, state: &State) -> (State, bool) {
        let k = state.layer.len(); // we use the length as the "step" index (0-based)
        let n_next = (self.t)(state.layer.len());

        // Build next layer using G
        let mut next_layer = Vec::with_capacity(n_next);
        for i in 0..n_next {
            // We pass `k` as the step number (which we interpret as the current layer's index)
            // and `n_next` as the total count for the new layer.
            let pt = (self.g)(k, i, n_next);
            next_layer.push(pt);
        }

        // Compute connections from current layer to next layer using Phi
        let connections = (self.phi)(&state.layer, &next_layer);

        let next_state = State::new(next_layer, connections);

        // Check self‑strengthening
        let m_cur = (self.m)(state);
        let m_next = (self.m)(&next_state);
        let strengthened = m_next >= m_cur;

        (next_state, strengthened)
    }

    /// Generate an infinite iterator of states and strengthening flags.
    pub fn stream(&self, seed: State) -> impl Iterator<Item = (State, bool)> + '_ {
        let mut current = seed;
        std::iter::from_fn(move || {
            let (next, ok) = self.step(&current);
            let result = (next.clone(), ok);
            current = next;
            Some(result)
        })
    }

    /// Generate the entire shell (the infinite sequence) – here we just take `n` steps.
    pub fn shell(&self, seed: State, n: usize) -> Vec<(State, bool)> {
        self.stream(seed).take(n).collect()
    }
}

// -----------------------------------------------------------------------------
// Example: a simple radial monad with nearest‑neighbour connections
// -----------------------------------------------------------------------------

/// A simple T: linear growth
fn t_linear(n: usize) -> usize {
    n + 2 // each layer grows by 2 points
}

/// A simple G: points placed on a circle with radius increasing with step
fn g_radial(step: usize, i: usize, n: usize) -> Point {
    let angle = 2.0 * std::f64::consts::PI * (i as f64) / (n as f64);
    let radius = 1.0 + 0.5 * (step as f64); // radius grows with step
    Point::new(radius * angle.cos(), radius * angle.sin())
}

/// A simple Φ: for each point in the current layer, connect to the nearest point in the next layer.
/// (If ties, the first encountered is taken.)
fn phi_nearest(current: &Layer, next: &Layer) -> Vec<Connection> {
    let mut connections = Vec::with_capacity(current.len());
    for (i, p_cur) in current.iter().enumerate() {
        let mut best_j = 0;
        let mut best_dist = f64::INFINITY;
        for (j, p_next) in next.iter().enumerate() {
            let d = p_cur.distance(p_next);
            if d < best_dist {
                best_dist = d;
                best_j = j;
            }
        }
        connections.push((i, best_j));
    }
    connections
}

/// A simple measurement M: sum of squared distances from origin (as a proxy for "complexity")
fn m_energy(state: &State) -> f64 {
    state.layer.iter().map(|p| p.x.powi(2) + p.y.powi(2)).sum()
}

/// A simple measurement that always increases (to demonstrate self‑strengthening)
/// This one is actually guaranteed to increase if radius grows and count grows, but we keep it generic.

fn main() {
    // Define the monad
    let monad = Monad::new(t_linear, g_radial, phi_nearest, m_energy);

    // Seed state: one point at origin, no previous connections
    let seed_layer = vec![Point::new(0.0, 0.0)];
    let seed = State::new(seed_layer, vec![]);

    // Generate the first 5 states
    let shell = monad.shell(seed, 5);

    // Print each state
    for (k, (state, strengthened)) in shell.iter().enumerate() {
        println!("=== State {} ===", k);
        println!("Layer ({} points):", state.layer.len());
        for (i, pt) in state.layer.iter().enumerate() {
            println!("  point[{}]: ({:.3}, {:.3})", i, pt.x, pt.y);
        }
        println!("Connections from previous layer:");
        if state.prev_connections.is_empty() && k == 0 {
            println!("  (none – initial state)");
        } else {
            for (from, to) in &state.prev_connections {
                println!("  {} → {}", from, to);
            }
        }
        println!("Measurement M = {:.3}", (monad.m)(state));
        println!("Self‑strengthening condition: {}", strengthened);
        println!();
    }
}
