struct LogisticT {
    r: f64,
    max: f64,
    current: Cell<f64>,
}
impl LogisticT {
    fn new(r: f64, max: f64, initial: f64) -> Self {
        Self { r, max, current: Cell::new(initial) }
    }
}
impl FnOnce<(usize,)> for LogisticT {
    type Output = usize;
    extern "rust-call" fn call_once(self, args: (usize,)) -> Self::Output { self.call(args) }
}
impl FnMut<(usize,)> for LogisticT {
    extern "rust-call" fn call_mut(&mut self, args: (usize,)) -> Self::Output { self.call(args) }
}
impl Fn<(usize,)> for LogisticT {
    extern "rust-call" fn call(&self, _args: (usize,)) -> Self::Output {
        let x = self.r * self.current.get() * (1.0 - self.current.get() / self.max);
        let new_val = x.max(0.0).min(self.max);
        self.current.set(new_val);
        (new_val.round() as usize).max(1)
    }
}

// ---- Helper functions ----
fn frequencies_from_state(state: &State, base: f64) -> Vec<f64> {
    state.layer.iter()
        .map(|p| {
            let dist = (p.x.powi(2) + p.y.powi(2)).sqrt();
            base * 2.0f64.powf(dist / 12.0)
        })
        .collect()
}

fn print_ascii_state(state: &State, width: usize, height: usize) {
    let mut grid = vec![vec![' '; width]; height];
    for p in &state.layer {
        // scale to [-2,2] range
        let x = ((p.x + 2.0) / 4.0 * (width as f64)) as usize;
        let y = ((p.y + 2.0) / 4.0 * (height as f64)) as usize;
        if x < width && y < height {
            grid[height - 1 - y][x] = '*';
        }
    }
    for row in grid {
        println!("{}", row.iter().collect::<String>());
    }
}

// ---- Main ----
fn main() {
    // Define the monad components
    let t = LogisticT::new(3.7, 100.0, 10.0);
    let g = |step: usize, i: usize, n: usize| {
        let angle = 2.0 * std::f64::consts::PI * (i as f64) / (n as f64) + 0.1 * (step as f64);
        let radius = 0.5 + 0.3 * (step as f64) + 0.1 * (i as f64);
        Point::new(radius * angle.cos(), radius * angle.sin())
    };
    let phi = |curr: &Layer, next: &Layer| -> Vec<Connection> {
        let mut conns = Vec::with_capacity(curr.len());
        for (i, p_cur) in curr.iter().enumerate() {
            let mut best_j = 0;
            let mut best_dist = f64::INFINITY;
            for (j, p_next) in next.iter().enumerate() {
                let d = p_cur.distance(p_next);
                if d < best_dist { best_dist = d; best_j = j; }
            }
            conns.push((i, best_j));
        }
        conns
    };
    let m = |state: &State| -> f64 {
        state.layer.iter().map(|p| p.x.powi(2) + p.y.powi(2)).sum()
    };

    let monad = Monad::new(t, g, phi, m);

    // Seed: 5 points on a unit circle
    let seed_layer: Layer = (0..5).map(|i| {
        let angle = 2.0 * std::f64::consts::PI * (i as f64) / 5.0;
        Point::new(angle.cos(), angle.sin())
    }).collect();
    let seed = State::new(seed_layer, vec![]);

    // Generate first 15 states
    let shell = monad.shell(seed, 15);

    for (step, (state, corrected)) in shell.iter().enumerate() {
        println!("\n========== Step {} ==========", step);
        println!("Number of points: {}", state.layer.len());
        print_ascii_state(state, 40, 20);
        println!("Frequencies (first 5): {:?}", 
                 frequencies_from_state(state, 440.0).iter().take(5).collect::<Vec<_>>());
        println!("Energy M = {:.3}", (monad.m)(state));
        if *corrected { println!("(Correction applied to maintain self‑strengthening)"); }

        // Show one projection every 3 steps
        if step % 3 == 0 {
            println!("Radii projection: {:?}", state.projection_radii());
        }
    }
}
