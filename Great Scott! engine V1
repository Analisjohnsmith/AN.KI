        T_theta_theta = T_kinetic - 0.5 * metric['g_theta_theta'] * (T_kinetic - 2*V)
        T_uu = -0.5 * metric['g_uu'] * (T_kinetic - 2*V)
        
        return {
            'T_tt': T_tt,
            'T_theta_theta': T_theta_theta,
            'T_uu': T_uu
        }
    
    def einstein_tensor_mode3(self, theta: np.ndarray, N: np.ndarray, 
                             omega: np.ndarray) -> Dict[str, np.ndarray]:
