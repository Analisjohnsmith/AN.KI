        self.r = r
        self.R = R
        self.Sigma = lambda theta: R + r * np.cos(theta)
    
    def mode3_ctc_family(self, theta0: float, A: float, mu: float, 
                        C1: float, C2: float) -> Dict[str, float]:
        """
        Analytic CTC family for Mode 3.
        CTC condition: |λ - 1| < C₂·(R + r·cosθ₀)/|C₁|
        """
        # Compute g(θ₀)
        g0 = 4 * np.pi * A**2 * (np.sin(theta0)**2 / self.r**2 + mu * np.cos(theta0)**2)
        
        # Lapse and twist at θ₀
        integral_g0 = (theta0 / (2 * self.r**2) - np.sin(2*theta0) / (4 * self.r**2) + 
                      mu * theta0 / 2 + mu * np.sin(2*theta0) / 4)
        integral_g0 *= 4 * np.pi * A**2
        
        N0 = C2 * np.exp(integral_g0)
        omega0 = C1 * np.exp(integral_g0)
        
        # CTC condition: |λ - 1| < N0 * Sigma0 / |omega0|
        Sigma0 = self.Sigma(theta0)
        ctc_bound = N0 * Sigma0 / np.abs(omega0)
        
        return {
            'N0': N0,
            'omega0': omega0,
            'Sigma0': Sigma0,
            'ctc_bound': ctc_bound,
            'ctc_condition': f'|λ - 1| < {ctc_bound:.4f}'
        }
    
