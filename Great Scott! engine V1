    uint n
) {
    uint idx = get_global_id(0);
    
    if (idx >= n) return;
    
    // Compute indices (with padding)
    uint idx_prev = (idx == 0) ? 1 : idx - 1;
    uint idx_next = (idx == n - 1) ? n - 2 : idx + 1;
    
    // Load values
    double theta_prev = theta[idx_prev];
    double theta_curr = theta[idx];
    double theta_next = theta[idx_next];
    
    double h_prev = values[idx_prev];
    double h_curr = values[idx];
    double h_next = values[idx_next];
    
    // Compute second derivative
    double dt = (theta_next - theta_prev) / 2.0;
    double inv_dt_sq = 1.0 / (dt * dt);
    double d2h = (h_prev + h_next - 2.0 * h_curr) * inv_dt_sq;
    
    // Compute PDE residual: κ·ΔH + μ·H - λ·H³
    double res = kappa * d2h + mu * h_curr - lambda * h_curr * h_curr * h_curr;
    
    residual[idx] = res;
}
