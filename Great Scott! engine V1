## CUDA Kernel (kernels/curvature.ptx)

```ptx
//
// Canonical Curvature Theory - CUDA Kernels
// Computation of PDE residual on GPU
//

.version 7.0
.target sm_50

//
// compute_residual: Compute κ·ΔH + μ·H - λ·H³
//
.visible .entry compute_residual(
    .param .u64 param_theta,
    .param .u64 param_values,
    .param .u64 param_residual,
    .param .f64 param_kappa,
    .param .f64 param_mu,
    .param .f64 param_lambda,
    .param .u32 param_n
) {
    .local .u64 theta_ptr, values_ptr, residual_ptr;
    .local .f64 kappa, mu, lambda;
    .local .u32 n, idx;
    
    // Load parameters
    ld.param.u64 theta_ptr, [param_theta];
    ld.param.u64 values_ptr, [param_values];
    ld.param.u64 residual_ptr, [param_residual];
    ld.param.f64 kappa, [param_kappa];
    ld.param.f64 mu, [param_mu];
    ld.param.f64 lambda, [param_lambda];
    ld.param.u32 n, [param_n];
    
    // Get thread index
    mov.u32 idx, %tid.x;
    add.u32 idx, idx, %ctaid.x * %ntid.x;
    
    // Check bounds
    setp.ge.u32 %p0, idx, n;
    @%p0 bra .exit;
    
    // Load current value and neighbors
    .local.f64 h_prev, h_curr, h_next;
    .local.f64 theta_prev, theta_curr, theta_next;
    
    // Compute indices (with padding)
    .local.u32 idx_prev, idx_next;
    mov.u32 idx_prev, idx;
    mov.u32 idx_next, idx;
    setp.eq.u32 %p1, idx, 0;
    @%p1 mov.u32 idx_prev, 1;
    @%p1 mov.u32 idx_next, 2;
    setp.eq.u32 %p2, idx, n-1;
    @%p2 mov.u32 idx_prev, n-3;
    @%p2 mov.u32 idx_next, n-2;
    
    // Load values
    cvta.to.global.u64 %rd1, theta_ptr;
    mul.wide.u32 %rd2, idx_prev, 8;
    add.u64 %rd3, %rd1, %rd2;
    ld.global.f64 theta_prev, [%rd3];
    
    mul.wide.u32 %rd4, idx, 8;
    add.u64 %rd5, %rd1, %rd4;
    ld.global.f64 theta_curr, [%rd5];
    
    mul.wide.u32 %rd6, idx_next, 8;
    add.u64 %rd7, %rd1, %rd6;
    ld.global.f64 theta_next, [%rd7];
    
    cvta.to.global.u64 %rd8, values_ptr;
    mul.wide.u32 %rd9, idx_prev, 8;
    add.u64 %rd10, %rd8, %rd9;
    ld.global.f64 h_prev, [%rd10];
    
    mul.wide.u32 %rd11, idx, 8;
    add.u64 %rd12, %rd8, %rd11;
    ld.global.f64 h_curr, [%rd12];
    
    mul.wide.u32 %rd13, idx_next, 8;
    add.u64 %rd14, %rd8, %rd13;
    ld.global.f64 h_next, [%rd14];
    
    // Compute second derivative: d²H/dθ²
    .local.f64 dt, inv_dt_sq;
    sub.f64 dt, theta_next, theta_prev;
    mul.f64 dt, dt, 0.5;  // average spacing
    div.f64 inv_dt_sq, 1.0, dt;
    mul.f64 inv_dt_sq, inv_dt_sq, inv_dt_sq;
    
    .local.f64 d2h;
    add.f64 d2h, h_prev, h_next;
    sub.f64 d2h, d2h, 2.0 * h_curr;
    mul.f64 d2h, d2h, inv_dt_sq;
    
    // Compute PDE residual: κ·ΔH + μ·H - λ·H³
    .local.f64 residual;
    mul.f64 residual, kappa, d2h;
    mul.f64 %rd15, mu, h_curr;
    add.f64 residual, residual, %rd15;
    mul.f64 %rd16, lambda, h_curr;
    mul.f64 %rd17, %rd16, h_curr;
    mul.f64 %rd18, %rd17, h_curr;
    sub.f64 residual, residual, %rd18;
    
    // Store residual
    cvta.to.global.u64 %rd19, residual_ptr;
    mul.wide.u32 %rd20, idx, 8;
    add.u64 %rd21, %rd19, %rd20;
    st.global.f64 [%rd21], residual;
    
.exit:
    ret;
}
