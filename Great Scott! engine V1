// CTC (CLOSED TIMELIKE CURVE) FAMILY
// ============================================================================

pub struct CTCClosure {
    pub r: f64,
    pub R: f64,
}

impl CTCClosure {
    pub fn new(r: f64, R: f64) -> Self {
        Self { r, R }
    }

    pub fn sigma(&self, theta: f64) -> f64 {
        self.R + self.r * theta.cos()
    }

    /// Mode 3 CTC family
    pub fn mode3_ctc_family(&self, theta0: f64, A: f64, mu: f64, C1: f64, C2: f64) -> CTCFamily {
        // g(θ₀) = 4π·A²·(sin²θ₀/r² + μ·cos²θ₀)
        let g0 = 4.0 * PI * A.powi(2) * (theta0.sin().powi(2) / self.r.powi(2) + mu * theta0.cos().powi(2));
        
        // ∫g(θ₀)dθ₀ (analytic)
        let integral_g0 = 4.0 * PI * A.powi(2) * (
            theta0 / (2.0 * self.r.powi(2)) 
            - (2.0 * theta0).sin() / (4.0 * self.r.powi(2))
            + mu * theta0 / 2.0
            + mu * (2.0 * theta0).sin() / 4.0
        );
        
        let exp_integral = integral_g0.exp();
        let N0 = C2 * exp_integral;
        let omega0 = C1 * exp_integral;
        let Sigma0 = self.sigma(theta0);
        
        let ctc_bound = N0 * Sigma0 / omega0.abs();
        
        CTCFamily {
            theta0,
            lambda_range: (-ctc_bound + 1.0, ctc_bound + 1.0),
            N0,
            omega0,
            Sigma0,
            ctc_bound,
            exists: ctc_bound > 0.0,
        }
    }

    /// Mode 7 CTC family
    pub fn mode7_ctc_family(&self, theta0: f64, C1: f64, C2: f64) -> CTCFamily {
        let Sigma0 = self.sigma(theta0);
        let N0 = C2 + C1.powi(2) / Sigma0.powi(2);
        let omega0 = C1 / Sigma0;
        
        let ctc_bound = N0 * Sigma0 / omega0.abs();
        
        CTCFamily {
            theta0,
            lambda_range: (-ctc_bound + 1.0, ctc_bound + 1.0),
            N0,
            omega0,
            Sigma0,
            ctc_bound,
            exists: ctc_bound > 0.0,
        }
    }

    /// Parametric CTC curve: φ(t) = φ₀ - ω₀·t
    pub fn ctc_curve(&self, t: &Array1<f64>, omega0: f64, phi0: f64) -> Array1<f64> {
        t.mapv(|t_val| phi0 - omega0 * t_val)
    }
}

