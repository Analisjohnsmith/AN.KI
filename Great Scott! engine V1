// ============================================================================
// CURVATURE PDE FOUNDATION
// ============================================================================

pub struct CurvaturePDE {
    pub params: PDEParams,
}

impl CurvaturePDE {
    pub fn new(kappa: f64, mu: f64, lambda: f64, r: f64, R: f64, k: f64) -> Self {
        Self {
            params: PDEParams { kappa, mu, lambda, r, R, k },
        }
    }

    /// Analytic solution: Mode 1 - Soliton (Simple Shell)
    pub fn mode1_soliton(&self, theta: &Array1<f64>, A1: f64) -> CurvatureField {
        let values = theta.mapv(|t| A1 / (self.params.k * t).cosh());
        
        // Verify PDE constraints: μ = -κ·k², λ = -2κ·k²
        let mu_check = self.params.mu + self.params.kappa * self.params.k.powi(2);
        let lambda_check = self.params.lambda + 2.0 * self.params.kappa * self.params.k.powi(2);
        
        assert!(mu_check.abs() < 1e-10, "Mode 1: μ constraint violated");
        assert!(lambda_check.abs() < 1e-10, "Mode 1: λ constraint violated");
        
        CurvatureField {
            theta: theta.clone(),
            values,
            mode: CurvatureMode::Mode1,
        }
    }

    /// Analytic solution: Mode 3 - Cosine (Toroidal Shell)
    pub fn mode3_cosine(&self, theta: &Array1<f64>, A: f64) -> CurvatureField {
        let values = theta.mapv(|t| A * t.cos());
        
        // Verify PDE constraints: λ = 0, μ = κ/r² + κ/(r·R)
        let lambda_check = self.params.lambda;
        let mu_check = self.params.mu - self.params.kappa / self.params.r.powi(2) 
                       - self.params.kappa / (self.params.r * self.params.R);
        
        assert!(lambda_check.abs() < 1e-10, "Mode 3: λ must be 0");
        assert!(mu_check.abs() < 1e-10, "Mode 3: μ constraint violated");
        assert!(self.params.R > self.params.r, "Mode 3: R >> r required");
        
        CurvatureField {
            theta: theta.clone(),
            values,
            mode: CurvatureMode::Mode3,
        }
    }

    /// Analytic solution: Mode 5 - Multi-soliton (Minimal Branching)
    pub fn mode5_multisoliton(&self, theta: &Array1<f64>, A5: f64, theta_b: f64) -> CurvatureField {
        let values = theta.mapv(|t| A5 * (1.0 / (self.params.k * t).cosh() 
                                        + 1.0 / (self.params.k * (t - theta_b)).cosh()));
        
        // Same constraints as Mode 1
        let mu_check = self.params.mu + self.params.kappa * self.params.k.powi(2);
        let lambda_check = self.params.lambda + 2.0 * self.params.kappa * self.params.k.powi(2);
        
        assert!(mu_check.abs() < 1e-10, "Mode 5: μ constraint violated");
        assert!(lambda_check.abs() < 1e-10, "Mode 5: λ constraint violated");
        
        CurvatureField {
            theta: theta.clone(),
            values,
            mode: CurvatureMode::Mode5,
        }
    }

    /// Analytic solution: Mode 7 - Constant (Flat/Degenerate)
    pub fn mode7_constant(&self, theta: &Array1<f64>, H0: f64) -> CurvatureField {
        let values = Array1::from_elem(theta.len(), H0);
        
        // Verify: H₀ = 0 OR H₀² = μ/λ
        if self.params.lambda.abs() > 1e-10 {
            let h0_sq = self.params.mu / self.params.lambda;
            if H0.abs() > 1e-10 {
                assert!((H0.powi(2) - h0_sq).abs() < 1e-10, 
                        "Mode 7: H₀² must equal μ/λ");
            }
        }
        
        CurvatureField {
            theta: theta.clone(),
            values,
            mode: CurvatureMode::Mode7,
        }
    }

    /// Compute the PDE residual for any field
    pub fn pde_residual(&self, field: &CurvatureField) -> Array1<f64> {
        let dt = field.theta[1] - field.theta[0];
        let n = field.theta.len();
        let mut residual = Array1::zeros(n);
        
        // Compute second derivative via finite difference
        let d2 = (1..n-1).into_par_iter().map(|i| {
            (field.values[i+1] - 2.0 * field.values[i] + field.values[i-1]) / dt.powi(2)
        }).collect::<Vec<_>>();
        
        // Boundary: zero second derivative at edges
        let d2_full = {
            let mut arr = Array1::zeros(n);
            arr.slice_mut(s![1..n-1]).assign(&Array1::from_vec(d2));
            arr
        };
        
        // PDE: κ·ΔH + μ·H - λ·H³ = 0
        for i in 0..n {
            residual[i] = self.params.kappa * d2_full[i] 
                        + self.params.mu * field.values[i]
                        - self.params.lambda * field.values[i].powi(3);
        }
        
        residual
    }
}

// ============================================================================
// EINSTEIN TENSOR CLOSURE
// ============================================================================

pub struct EinsteinTensorClosure {
    pub r: f64,
    pub R: f64,
}

impl EinsteinTensorClosure {
    pub fn new(r: f64, R: f64) -> Self {
        Self { r, R }
    }

    /// Compute Sigma(θ) = R + r·cos(θ)
    pub fn sigma(&self, theta: &Array1<f64>) -> Array1<f64> {
        theta.mapv(|t| self.R + self.r * t.cos())
    }

    /// Mode 3: Lapse N(θ) and twist ω(θ)
    pub fn mode3_lapse_twist(&self, theta: &Array1<f64>, A: f64, mu: f64, 
                             C1: f64, C2: f64) -> (Array1<f64>, Array1<f64>) {
        // g(θ) = 4π·A²·(sin²θ/r² + μ·cos²θ)
        let dt = theta[1] - theta[0];
        let n = theta.len();
        
        let g: Array1<f64> = theta.mapv(|t| {
            4.0 * PI * A.powi(2) * (t.sin().powi(2) / self.r.powi(2) + mu * t.cos().powi(2))
        });
        
        // Integrate g(θ) numerically
        let mut integral_g = Array1::zeros(n);
        for i in 1..n {
            integral_g[i] = integral_g[i-1] + 0.5 * (g[i-1] + g[i]) * dt;
        }
        
        // N(θ) = C₂·exp(∫g(θ)dθ)
        // ω(θ) = C₁·exp(∫g(θ)dθ)
        let exp_integral = integral_g.mapv(|x| x.exp());
        let N = C2 * &exp_integral;
        let omega = C1 * exp_integral;
        
        (N, omega)
    }

    /// Mode 7: Lapse N(θ) and twist ω(θ)
    pub fn mode7_lapse_twist(&self, theta: &Array1<f64>, C1: f64, C2: f64) -> (Array1<f64>, Array1<f64>) {
        let Sigma = self.sigma(theta);
        let omega = C1 / &Sigma;
        let N = C2 + C1.powi(2) / Sigma.mapv(|s| s.powi(2));
        
        (N, omega)
    }

    /// Compute Einstein tensor for Mode 3 metric
    pub fn einstein_tensor_mode3(&self, theta: &Array1<f64>, N: &Array1<f64>, 
                                 omega: &Array1<f64>) -> EinsteinTensor {
        let dt = theta[1] - theta[0];
        let Sigma = self.sigma(theta);
        let dSigma = theta.mapv(|t| -self.r * t.sin());
        let dN = self.derivative(N, dt);
        let d2N = self.derivative(&dN, dt);
        let domega = self.derivative(omega, dt);
        
        // G_tt = (Σ'·N')/(N·Σ) + N''/N + Σ''/Σ - (Σ²·ω'²)/2
        // G_tφ = (Σ²·ω'')/2 + (Σ²·ω'·Σ')/Σ
        // G_φφ = (Σ²·N'')/N + (Σ²·Σ'·N')/(N·Σ) - (Σ⁴·ω'²)/2
        
        let n = theta.len();
        let mut G_tt = Array1::zeros(n);
        let mut G_tphi = Array1::zeros(n);
        let mut G_uu = Array1::zeros(n);
        let mut G_theta_theta = Array1::zeros(n);
        let mut G_phi_phi = Array1::zeros(n);
        
        for i in 0..n {
            if N[i].abs() > 1e-10 {
                G_tt[i] = (dSigma[i] * dN[i]) / (N[i] * Sigma[i]) 
                        + d2N[i] / N[i]
                        + Sigma[i] * dSigma[i] / Sigma[i].powi(2)
                        - (Sigma[i].powi(2) * domega[i].powi(2)) / 2.0;
                
                G_tphi[i] = (Sigma[i].powi(2) * domega[i]) / 2.0
                          + (Sigma[i].powi(2) * domega[i] * dSigma[i]) / Sigma[i];
                
                G_phi_phi[i] = (Sigma[i].powi(2) * d2N[i]) / N[i]
                             + (Sigma[i].powi(2) * dSigma[i] * dN[i]) / (N[i] * Sigma[i])
                             - (Sigma[i].powi(4) * domega[i].powi(2)) / 2.0;
            }
        }
        
        EinsteinTensor {
            G_tt,
            G_tphi,
            G_uu,
            G_theta_theta,
            G_phi_phi,
        }
    }

    /// Compute stress-energy tensor for Mode 3
    pub fn stress_energy_mode3(&self, theta: &Array1<f64>, field: &CurvatureField,
                               metric: &Metric) -> StressEnergyTensor {
        let dt = theta[1] - theta[0];
        let dH = self.derivative(&field.values, dt);
        
        // H' = -A·sin(θ)/r
        // Kinetic term: T_kinetic = H'^2
        let T_kinetic = dH.mapv(|h| h.powi(2));
        
        // Potential: V = -½·μ·H²
        let V = field.values.mapv(|h| -0.5 * self.params_mu(field) * h.powi(2));
        
        // T_μν = ∂_μH·∂_νH - ½g_μν·(g^{αβ}∂_αH∂_βH + 2V)
        // For stationary metric: T_θθ includes kinetic term
        
        let n = theta.len();
        let mut T_tt = Array1::zeros(n);
        let mut T_tphi = Array1::zeros(n);
        let mut T_uu = Array1::zeros(n);
        let mut T_theta_theta = Array1::zeros(n);
        let mut T_phi_phi = Array1::zeros(n);
        
        for i in 0..n {
            let g_field = T_kinetic[i] - 2.0 * V[i];
            T_tt[i] = -0.5 * metric.g_tt[i] * g_field;
            T_tphi[i] = -0.5 * metric.g_tphi[i] * g_field;
            T_uu[i] = -0.5 * metric.g_uu[i] * g_field;
            T_theta_theta[i] = T_kinetic[i] - 0.5 * metric.g_theta_theta[i] * g_field;
            T_phi_phi[i] = -0.5 * metric.g_phi_phi[i] * g_field;
        }
        
        StressEnergyTensor {
            T_tt,
            T_tphi,
            T_uu,
            T_theta_theta,
            T_phi_phi,
        }
    }

    fn derivative(&self, arr: &Array1<f64>, dt: f64) -> Array1<f64> {
        let n = arr.len();
        let mut deriv = Array1::zeros(n);
        if n > 2 {
            for i in 1..n-1 {
                deriv[i] = (arr[i+1] - arr[i-1]) / (2.0 * dt);
            }
            deriv[0] = (arr[1] - arr[0]) / dt;
            deriv[n-1] = (arr[n-1] - arr[n-2]) / dt;
        }
        deriv
    }

    fn params_mu(&self, field: &CurvatureField) -> f64 {
        match field.mode {
            CurvatureMode::Mode3 => {
                // μ = κ/r² + κ/(r·R) - this needs to be passed in
                // For now, return a default
                1.0
            }
            _ => 1.0,
        }
    }
}

// ============================================================================
// STABILITY ANALYSIS
// ============================================================================

pub struct StabilityClosure {
    pub kappa: f64,
}

impl StabilityClosure {
    pub fn new(kappa: f64) -> Self {
        Self { kappa }
    }

    /// Mode 3 stability matrix: M(θ₀) = g(θ₀)·[[1,1],[1,1]]
    pub fn mode3_stability_matrix(&self, theta0: f64, A: f64, mu: f64, r: f64) -> StabilityResult {
        let g0 = 4.0 * PI * A.powi(2) * (theta0.sin().powi(2) / r.powi(2) + mu * theta0.cos().powi(2));
        
        // Standard (unstable) matrix
        let mut M_standard = Array2::<f64>::zeros((2, 2));
        M_standard[[0,0]] = g0;
        M_standard[[0,1]] = g0;
        M_standard[[1,0]] = g0;
        M_standard[[1,1]] = g0;
        
        // Exotic (stable) matrix with sign flip
        let mut M_exotic = Array2::<f64>::zeros((2, 2));
        M_exotic[[0,0]] = -g0;
        M_exotic[[0,1]] = -g0;
        M_exotic[[1,0]] = -g0;
        M_exotic[[1,1]] = -g0;
        
        // Compute eigenvalues for exotic matrix
        // λ₁ = -2g₀, λ₂ = 0
        let eigenvalues = Array1::from_vec(vec![-2.0 * g0, 0.0]);
        let eigenmodes = Array2::<f64>::zeros((2, 2));
        // eigenmodes are the standard basis for this matrix
        
        StabilityResult {
            is_stable: -2.0 * g0 < 0.0,  // Always true for g0 > 0
            eigenvalues,
            eigenmodes,
            perturbation_growth_rate: -2.0 * g0,  // Negative = stable
        }
    }

    /// Mode 7 is automatically stable
    pub fn mode7_stability_matrix(&self) -> StabilityResult {
        let eigenvalues = Array1::from_vec(vec![0.0, 0.0]);
        let eigenmodes = Array2::<f64>::zeros((2, 2));
        
        StabilityResult {
            is_stable: true,
            eigenvalues,
            eigenmodes,
