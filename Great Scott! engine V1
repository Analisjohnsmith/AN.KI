#[cfg(feature = "cuda")]
mod gpu {
    use cust::{CudaContext, Device, Module, Stream};
    use cust::memory::{DeviceBuffer, HostBuffer};
    use ndarray::{Array1, ArrayView1};
    
    pub struct GPUSolver {
        context: CudaContext,
        stream: Stream,
        module: Module,
    }
    
    impl GPUSolver {
        pub fn new() -> Result<Self, cust::Error> {
            let device = Device::get_device(0)?;
            let context = CudaContext::new(device)?;
            let stream = Stream::new(&context)?;
            
            // Load PTX kernel module
            let ptx = include_str!("../kernels/curvature.ptx");
            let module = Module::load_from_string(&context, ptx)?;
            
            Ok(Self { context, stream, module })
        }
        
        pub fn compute_pde_residual(&self, theta: &Array1<f64>, values: &Array1<f64>, 
                                    kappa: f64, mu: f64, lambda: f64) -> Array1<f64> {
            let n = theta.len();
            
            // Copy data to GPU
            let d_theta = DeviceBuffer::from_slice(&self.context, theta.as_slice().unwrap()).unwrap();
            let d_values = DeviceBuffer::from_slice(&self.context, values.as_slice().unwrap()).unwrap();
            let mut d_residual = DeviceBuffer::zeros(&self.context, n).unwrap();
            
            // Launch kernel
            let kernel = self.module.get_function("compute_residual").unwrap();
            let grid_size = (n + 255) / 256;
            let block_size = 256;
            
            unsafe {
                kernel.launch(
                    &self.context,
                    (grid_size as u32, 1, 1),
                    (block_size as u32, 1, 1),
                    (0, self.stream),
                    &mut [&d_theta, &d_values, &mut d_residual, &kappa, &mu, &lambda, &(n as u32)],
                ).unwrap();
            }
            
            self.stream.synchronize().unwrap();
            
            // Copy result back
            let mut residual = Array1::zeros(n);
            let host_buffer = d_residual.to_host(&self.context).unwrap();
            residual.assign(&Array1::from_vec(host_buffer.as_slice().unwrap().to_vec()));
            
            residual
        }
    }
}

