                    Sigma**2 * dN**2 / N**2 + 
                    Sigma**2 * omega**2 * dSigma**2 / Sigma**2)
        
        # Analytic G_theta_theta
        G_theta_theta = -(N * d2N + (N * dN * dSigma / Sigma) + 
                         (N * dN * dSigma / Sigma) * Sigma**2 * omega**2)
        
        return {
            'G_tt': G_tt,
            'G_phi_phi': G_phi_phi,
            'G_theta_theta': G_theta_theta
