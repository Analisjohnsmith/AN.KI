use crate::nn::net::NeuralNet;

pub fn learn(net: &mut NeuralNet, rate: f32) {
    for conn in &mut net.connections {
        if let (Some(from), Some(to)) =
            (net.neurons.get(&conn.from.0), net.neurons.get(&conn.to.0))
        {
            let signal = from.activation * to.activation;
            let delta = rate * signal * to.attention;
            conn.weight = (conn.weight + delta).clamp(0.0, 2.0);
        }
    }
}

