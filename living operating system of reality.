type Hexagram = String  -- 6 bits, e.g. "111111"

allHexagrams :: [Hexagram]
allHexagrams = [ let bits = [0,1] in
                 concatMap show bits ]
-- Actually generate all 2^6 = 64
allHexagrams' :: [Hexagram]
allHexagrams' = [ map (\i -> if testBit n i then '1' else '0') [5,4..0] |
                  n <- [0..63] ]
  where testBit n i = n `mod` (2^(i+1)) >= 2^i

