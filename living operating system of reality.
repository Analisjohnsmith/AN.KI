{-# LANGUAGE DeriveFunctor #-}
module Sovereign where

import Data.List (foldl')
import Data.Maybe (catMaybes)

------------------------------------------------------------
-- 1. Core Types
------------------------------------------------------------

data Polarity = Outward | Inward deriving (Show, Eq)

data Layer
  = Emanate | Permit | Project | Extend | Illuminate | Invite | Resonate
  | Amplify | Manifest | Stabilize | Integrate | Expand | Transfer | Radiate
  | Withdraw | Contract | Shield | Contain | Silence | Obscure | Compress
  | Descend | Dissolve | Purify | Nullify | Reverse | Reclaim | Gravitate
  deriving (Show, Eq, Enum, Bounded)

layerPolarity :: Layer -> Polarity
layerPolarity l =
  case l of
    Emanate   -> Outward
    Permit    -> Outward
    Project   -> Outward
    Extend    -> Outward
    Illuminate-> Outward
    Invite    -> Outward
    Resonate  -> Outward
    Amplify   -> Outward
    Manifest  -> Outward
    Stabilize -> Outward
    Integrate -> Outward
    Expand    -> Outward
    Transfer  -> Outward
    Radiate   -> Outward
    _         -> Inward

------------------------------------------------------------
-- 2. Fractal Tree (Haskell-style)
------------------------------------------------------------

data Fractal a = Node a [Fractal a]
  deriving (Show, Functor)

instance Foldable Fractal where
  foldMap f (Node a children) = f a <> foldMap (foldMap f) children

instance Traversable Fractal where
  traverse f (Node a children) = Node <$> f a <*> traverse (traverse f) children

------------------------------------------------------------
-- 3. Neural Core (Algebraic)
------------------------------------------------------------

data NeuronKind = Thought | SpiritModulator | IdentityCore
  deriving (Show, Eq)

data Neuron = Neuron
  { neuronId   :: Int
  , neuronKind :: NeuronKind
  , activation :: Double
  , attention  :: Double
  , bias       :: Double
  } deriving (Show)

data Connection = Connection
  { fromId :: Int
  , toId   :: Int
  , weight :: Double
  } deriving (Show)

data NeuralNet = NeuralNet
  { neurons     :: [(Int, Neuron)]
  , connections :: [Connection]
  , nextId      :: Int
  } deriving (Show)

initNet :: NeuralNet
initNet =
  let n0 = Neuron 0 IdentityCore 1.0 1.0 0.0
      n1 = Neuron 1 Thought 0.5 1.0 0.0
      n2 = Neuron 2 Thought 0.2 1.0 0.0
      n3 = Neuron 3 SpiritModulator 0.3 1.0 0.0
      conns =
        [ Connection 0 1 0.8
        , Connection 1 2 0.6
        , Connection 3 0 0.5
        , Connection 0 3 0.4
        ]
  in NeuralNet [(0,n0),(1,n1),(2,n2),(3,n3)] conns 4

------------------------------------------------------------
-- 4. Pulse, Attention, Learning (Pure)
------------------------------------------------------------

pulse :: NeuralNet -> Double -> NeuralNet
pulse net decay =
  let -- 1. Decay
      decayed = map (\(id,n) -> (id, n { activation = max 0 (activation n * decay) }))
                    (neurons net)
      -- 2. Gather contributions
      contribs = foldl' (\acc conn ->
        case (lookup (fromId conn) decayed, lookup (toId conn) decayed) of
          (Just from, Just _to) ->
            let add = activation from * weight conn
            in  (toId conn, add) : acc
          _ -> acc
        ) [] (connections net)
      -- 3. Apply contributions + attention
      updated = map (\(id,n) ->
        let contrib = sum [c | (tid,c) <- contribs, tid == id]
            raw = max 0 contrib
            newAct = min 1 (raw * attention n)
        in (id, n { activation = newAct })
        ) decayed
  in net { neurons = updated }

attentionUpdate :: NeuralNet -> Personality -> Goal -> Era -> NeuralNet
attentionUpdate net pers goal era =
  let attFor n =
        let base = case neuronKind n of
              IdentityCore -> curious pers
              Thought      -> curious pers * 0.8 + calm pers * 0.2
              SpiritModulator -> harmonic pers
            goalBias = case goal of
              Growth     -> expansive pers
              Balance    -> harmonic pers
              Exploration-> curious pers
              Harmony    -> calm pers
              Clarity    -> focused pers
            eraBias = case era of
              Roots      -> calm pers
              Branches   -> expansive pers
              Storms     -> bold pers
              Echoes     -> reflective pers
              Harmony    -> harmonic pers
        in (base + goalBias + eraBias) / 3.0
      newNeurons = map (\(id,n) -> (id, n { attention = clamp 0.1 1.0 (attFor n) }))
                     (neurons net)
  in net { neurons = newNeurons }

learn :: NeuralNet -> Double -> NeuralNet
learn net rate =
  let newConns = map (\conn ->
        case (lookup (fromId conn) (neurons net), lookup (toId conn) (neurons net)) of
          (Just from, Just to) ->
            let signal = activation from * activation to
                delta = rate * signal * attention to
                newW = clamp 0.0 2.0 (weight conn + delta)
            in conn { weight = newW }
          _ -> conn
        ) (connections net)
  in net { connections = newConns }

clamp :: Ord a => a -> a -> a -> a
clamp lo hi x = max lo (min hi x)

------------------------------------------------------------
-- 5. Personality, Goals, Eras
------------------------------------------------------------

data Personality = Personality
  { curious    :: Double
  , calm       :: Double
  , bold       :: Double
  , reflective :: Double
  , adaptive   :: Double
  , harmonic   :: Double
  , focused    :: Double
  , expansive  :: Double
  } deriving (Show)

defaultCurious :: Personality
defaultCurious = Personality 0.9 0.4 0.7 0.5 0.8 0.6 0.7 0.8

defaultCalm :: Personality
defaultCalm = Personality 0.4 0.9 0.3 0.6 0.5 0.8 0.6 0.4

defaultBold :: Personality
defaultBold = Personality 0.7 0.3 0.9 0.4 0.8 0.5 0.8 0.7

data Goal = Growth | Balance | Exploration | Harmony | Clarity
  deriving (Show, Eq)

data Era = Roots | Branches | Storms | Echoes | HarmonyEra
  deriving (Show, Eq)

nextEra :: Era -> Era
nextEra Roots      = Branches
nextEra Branches   = Storms
nextEra Storms     = Echoes
nextEra Echoes     = HarmonyEra
nextEra HarmonyEra = Roots

eraName :: Era -> String
eraName Roots      = "Era of Roots"
eraName Branches   = "Era of Branches"
eraName Storms     = "Era of Storms"
eraName Echoes     = "Era of Echoes"
eraName HarmonyEra = "Era of Harmony"

goalName :: Goal -> String
goalName Growth      = "Growth"
goalName Balance     = "Balance"
goalName Exploration = "Exploration"
goalName Harmony     = "Harmony"
goalName Clarity     = "Clarity"

------------------------------------------------------------
-- 6. Balance & Orbit
------------------------------------------------------------

balanceCheck :: [Layer] -> Bool
balanceCheck layers =
  let out = length $ filter ((== Outward) . layerPolarity) layers
      inn = length layers - out
  in out == inn

data BalanceState = Balanced | Unbalanced deriving (Show, Eq)
data OrbitMode = OrbitOn | OrbitOff deriving (Show, Eq)

balanceState :: [Layer] -> BalanceState
balanceState layers = if balanceCheck layers then Balanced else Unbalanced

orbitState :: BalanceState -> OrbitMode
orbitState Balanced = OrbitOn
orbitState _        = OrbitOff

------------------------------------------------------------
-- 7. Game State
------------------------------------------------------------

data GameState = GameState
  { gsCore    :: String             -- intent
  , gsNet     :: NeuralNet
  , gsPers    :: Personality
  , gsGoal    :: Goal
  , gsEra     :: Era
  , gsHistory :: [Layer]
  , gsTick    :: Integer
  } deriving (Show)

initialState :: GameState
initialState =
  GameState "TRUTH" initNet defaultCurious Growth Branches [] 0

stepGame :: Layer -> GameState -> GameState
stepGame layer st =
  let newHistory = layer : gsHistory st
      net1 = gsNet st
      net2 = attentionUpdate net1 (gsPers st) (gsGoal st) (gsEra st)
      net3 = pulse net2 0.95
      net4 = learn net3 0.01
      era' = if gsTick st `mod` 250 == 0 && gsTick st > 0
             then nextEra (gsEra st)
             else gsEra st
      tick' = gsTick st + 1
  in st { gsNet = net4, gsEra = era', gsHistory = newHistory, gsTick = tick' }

runGame :: GameState -> [Layer] -> (GameState, OrbitMode, BalanceState)
runGame initial layers =
  let final = foldl' (flip stepGame) initial layers
      bal = balanceState (gsHistory final)
      orb = orbitState bal
  in (final, orb, bal)

