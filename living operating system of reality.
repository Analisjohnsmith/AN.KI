use std::collections::HashMap;

#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub enum NeuronKind {
    Thought,
    SpiritModulator,
    IdentityCore,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct NeuronId(pub usize);

#[derive(Debug, Clone)]
pub struct Neuron {
    pub id: NeuronId,
    pub kind: NeuronKind,
    pub activation: f32,
    pub attention: f32,
    pub bias: f32,
}

#[derive(Debug, Clone)]
pub struct Connection {
    pub from: NeuronId,
    pub to: NeuronId,
    pub weight: f32,
}

#[derive(Debug, Clone)]
pub struct NeuralNet {
    pub neurons: HashMap<usize, Neuron>,
    pub connections: Vec<Connection>,
    pub next_neuron_id: usize,
}

impl NeuralNet {
    pub fn new() -> Self {
        Self {
            neurons: HashMap::new(),
            connections: Vec::new(),
            next_neuron_id: 0,
        }
    }

    pub fn add_neuron(&mut self, kind: NeuronKind, activation: f32) -> NeuronId {
        let id = self.next_neuron_id;
        self.next_neuron_id += 1;
        let nid = NeuronId(id);
        self.neurons.insert(
            id,
            Neuron {
                id: nid,
                kind,
                activation,
                attention: 1.0,
                bias: 0.0,
            },
        );
        nid
    }

    pub fn connect(&mut self, from: NeuronId, to: NeuronId, weight: f32) {
        self.connections.push(Connection { from, to, weight });
    }

    pub fn get_neuron(&self, id: &NeuronId) -> Option<&Neuron> {
        self.neurons.get(&id.0)
    }

    pub fn get_neuron_mut(&mut self, id: &NeuronId) -> Option<&mut Neuron> {
        self.neurons.get_mut(&id.0)
    }
}

