------------------------------------------------------------
-- 9. Oracle (Interpretation)
------------------------------------------------------------

data Reading = Reading
  { rPath :: [Layer]
  , rHex  :: Hexagram
  , rCoord :: (Int, Int)  -- 8x8 grid
  , rMeaning :: String
  } deriving (Show)

pathToHex :: [Layer] -> Hexagram
pathToHex layers =
  let bits = take 6 $ map (\l -> if layerPolarity l == Outward then '1' else '0') layers
  in bits ++ replicate (6 - length bits) '0'

hexToCoord :: Hexagram -> (Int, Int)
hexToCoord h =
  let upper = take 3 h
      lower = drop 3 h
      x = foldl' (\acc c -> acc*2 + (if c == '1' then 1 else 0)) 0 upper
      y = foldl' (\acc c -> acc*2 + (if c == '1' then 1 else 0)) 0 lower
  in (x, y)

interpret :: GameState -> Reading
interpret st =
  let path = gsHistory st
      hex = pathToHex path
      coord = hexToCoord hex
      meaning = "The path through " ++ show (length path) ++ " layers yields hexagram " ++ hex
  in Reading path hex coord meaning

