# =========================================================================
# 8. THE KERNEL RUNTIME (pure Python, no external deps)
# =========================================================================
class WowKernel:
    """Boots the archive, binds opcodes, decodes the bitstream, checkpoints."""

    def __init__(self):
        self.metrics = {
            "frequency": 1420.0,
            "duration": 72.0,
            "bitstream_load": 0.0,
            "bitstream_remaining": 0.0,
        }
        self.decoded = []          # (opcode, symbol, meaning, lab_op)
        self.recognized = set()    # set of opcodes seen
        self.booted = False

    # -- boot sequence ----------------------------------------------------
    def boot(self):
        for stage, desc in enumerate(
            ["seed_initialization", "lexicon_activation", "planet_encoding",
             "protocol_handshake", "archive_lock", "recursion_engine",
             "runtime_execution"], 1):
            print(f"  [boot] stage_{stage}: {desc}")
        self.booted = True

    # -- decoder ----------------------------------------------------------
    @staticmethod
    def _lookup(code):
        """Return (symbol, meaning, lab_op) for an opcode or None."""
        entry = OPCODES.get(code)
        if not entry:
            return None
        symbol, meaning = entry
        return symbol, meaning, LAB_OPS.get(code, "unknown_op")

    def decode_canonical(self, line):
        """Decode a space-separated line (authoritative, lossless)."""
        for tok in line.split():
            hit = self._lookup(tok)
            if hit:
                self.decoded.append((tok,) + hit)
                self.recognized.add(tok)
            else:
                self.decoded.append((tok, "RAW", "unmapped", "unknown_op"))

    def decode_flattened(self, line):
        """Greedy longest-match over a separator-less bit run."""
        i = 0
        n = len(line)
        while i < n:
            matched = None
            for length in range(min(8, n - i), 0, -1):
                chunk = line[i:i + length]
                if chunk in OPCODES:
                    hit = self._lookup(chunk)
                    matched = (chunk,) + hit
                    break
            if matched:
                self.decoded.append(matched)
                self.recognized.add(matched[0])
                i += len(matched[0])
            else:
                self.decoded.append((line[i], "RAW", "unmapped", "unknown_op"))
                i += 1

    def feed(self, lines, flattened=False):
        func = self.decode_flattened if flattened else self.decode_canonical
        for line in lines:
            func(line)
        self.metrics["bitstream_remaining"] = float(len(lines))
        self.metrics["bitstream_load"] = float(len(lines))
        print(f"  [decode] fed {len(lines)} line(s)")

    # -- schedule loop ----------------------------------------------------
    def schedule_loop(self, interval_ms=100):
        passes = 0
        while self.metrics["bitstream_remaining"] > 0 and passes < 500:
            self.metrics["bitstream_remaining"] -= 1
            self.metrics["bitstream_load"] = self.metrics["bitstream_remaining"]
            passes += 1
        print(f"  [loop]   {passes} pass(es) @ {interval_ms}ms interval")
        print(f"  [gate]   bitstream_remaining={int(self.metrics['bitstream_remaining'])}"
              f" -> decode-complete={self.metrics['bitstream_remaining'] <= 0}")

    # -- output -----------------------------------------------------------
    def report(self):
        print("\n=== DECODED ARCHIVE (usable form) ===")
        seen = set()
        for code, symbol, meaning, lab_op in self.decoded:
            key = (code, symbol)
            if key in seen:
                continue
            seen.add(key)
            print(f"  {code:<6} -> {symbol:<22} : {meaning:<12} -> {lab_op}")
        print(f"\n  {len(self.recognized)} unique opcodes recognized")
        print(f"  {len(self.decoded)} total opcode tokens decoded")

    def checkpoint(self, path="wowkernel_checkpoint.json"):
        payload = {
            "schema": "wowkernel/1",
            "timestamp": datetime.now(timezone.utc).isoformat(),
            "recognized_opcodes": sorted(self.recognized),
            "decoded": [
                {"opcode": c, "symbol": s, "meaning": m, "lab_op": op}
                for c, s, m, op in self.decoded
            ],
            "metrics": self.metrics,
            "digest": hashlib.sha256(
                json.dumps(sorted(self.recognized), sort_keys=True).encode()
            ).hexdigest(),
        }
        with open(path, "w", encoding="utf-8") as f:
            json.dump(payload, f, indent=2)
        print(f"  [checkpoint] wrote {path} ({os.path.getsize(path)} bytes)")
        return payload

    def archive_dump(self):
        """Print the embedded archive specification."""
        print("== OPCODE TABLE ==")
        for code, (sym, meaning) in sorted(OPCODES.items(), key=lambda x: (len(x[0]), x[0])):
            print(f"  {code:<6} {sym:<22} {meaning}")
        print("\n== LEXICON ==")
        for k, v in LEXICON.items():
            print(f"  {k:<12} {v}")
        print("\n== PLANETS ==")
        for code, (name, kind, period, dist) in sorted(PLANETS.items(),
                                                        key=lambda x: (len(x[0]), x[0])):
            print(f"  {code:<6} {name:<10} {kind:<8} {period}d {dist} AU")
        print("\n== PROTOCOL ==")
        for k, v in PROTOCOL.items():
            print(f"  {k:<18} {v}")
        print("\n== BITSTREAM (canonical) ==")
        for line in BITSTREAM_CANONICAL:
            print(f"  {line}")
        print("\n== BITSTREAM (flattened) ==")
        for line in BITSTREAM_FLATTENED:
            print(f"  {line}")


def main():
    import os
    args = sys.argv[1:]

    print("=" * 70)
    print(" WowKernel — one self-contained runnable file (v3.0)")
    print("=" * 70)

    kernel = WowKernel()

    if "--archive" in args:
        kernel.archive_dump()
        return

    print("\n[boot] loading embedded archive (kernel.dsl embedded inline)...")
    kernel.boot()

    use_flattened = "--flattened" in args

    if "--decode" in args or True:
        print("\n[decode] binding opcodes -> lab ops (OpcodeTable)...")
        kernel.feed(BITSTREAM_CANONICAL if not use_flattened else BITSTREAM_FLATTENED,
                    flattened=use_flattened)
        kernel.schedule_loop()

        if "--checkpoint" in args:
            idx = args.index("--checkpoint")
            path = args[idx + 1] if idx + 1 < len(args) else "wowkernel_checkpoint.json"
            kernel.checkpoint(path)

        kernel.report()

    print("\n[loop] continuous loop: physics -> dialogue -> preservation -> recursion -> repeat")


if __name__ == "__main__":
    main()
