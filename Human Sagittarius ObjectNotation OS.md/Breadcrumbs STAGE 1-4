  entity Pando_Canonical_Model {
    type  = DYNAMICAL_SYSTEM
    role  = ECOLOGICAL_MODEL
    state = FORMALIZED

    domain {
      space       = R2_RIEMANNIAN
      metric      = g_ij
      coords      = [x, y]
      time        = t
      volume_form = sqrt(det g) dx dy
    }

    state_variables {
      presence_field       u(x,y,t)
      stem_lattice         n_i(t) ∈ {0,1}
      genome               G^{(k)}(t)
      epigenetic_state     E^{(k)}_l(t)
      hormone_fields       h_j(x,y,t)
      microbiome_density   m(x,y,t)
      root_network         R(t) = (V,E)
      climate_forcing      C(x,y,t) = {T,P,W}
      herbivory_pressure   H(x,y,t)
      fire_intensity       F(x,y,t)
      mechanical_displacement w(x,y,t)
    }

    dynamics {
      presence_equation {
        ∂u/∂t = D ∇_i(g^{ij}∇_j u) + r F_C(C) R(x,y) u(1-u) - δ G_C(C) u + λ Σ_i (n_i - u(x_i)) δ(x-x_i)
      }
      stem_energy {
        E_stems = -J Σ_{<i,j>} n_i n_j + α Σ_i n_i
      }
      genome_energy {
        E_genome = β Σ_k d_k
        E_genome_stem = β Σ_k d_k n_k
        dynamics = G^{(k)}(t+Δt) = G^{(k)}(t) - β ∇ d_k + Δε^{(k)}(t)
      }
      turnover_energy {
        E_turnover = γ (N - N*)^2
        dN/dt = (b - d) N
        b = b0 u(x_i,t)
        d = d0 + η(1 - u(x_i,t)) + η_H H(x_i,t)
      }
      coupling_energy {
        E_coupling = λ Σ_i (n_i - u(x_i,t))^2
      }
      hormone_dynamics {
        ∂h_j/∂t = D_j ∇² h_j + S_j(u,m,R) - δ_j h_j
      }
      epigenetic_dynamics {
        dE^{(k)}_l/dt = φ(stress,h_j) - ψ(E^{(k)}_l)
      }
      microbiome_dynamics {
        ∂m/∂t = D_m ∇² m + G_m(u,R) - δ_m m
      }
      root_network_dynamics {
        dE/dt = f(soil,u,stress)
        dx_tip/dt = ∇ R(x,y)
      }
      mechanical_dynamics {
        D_m^{(w)} ∇⁴ w = F_wind + F_snow
      }
    }

    action_functional {
      Lagrangian = L_field + L_stems + L_genome + L_turnover + L_coupling + L_bio + L_micro + L_mech + L_env
      components = {
        L_field = 1/2 D g^{ij} ∂i u ∂j u + r F_C(C) R u(1-u) - δ G_C(C) u²
        L_stems = -J Σ n_i n_j + α Σ n_i
        L_genome = β Σ d_k n_k
        L_turnover = γ (N - N*)²
        L_coupling = λ Σ (n_i - u(x_i))²
        L_bio = Σ_j [1/2 D_j |∇h_j|² + S_j h_j - 1/2 δ_j h_j²]
        L_micro = 1/2 D_m |∇m|² + G_m m - 1/2 δ_m m²
        L_mech = 1/2 D_m^{(w)} (∇²w)² - w(F_wind+F_snow)
        L_env = L_climate(C) + L_herbivory(H) + L_fire(F)
      }
      action = ∫ dt ∫ d²x L
    }

    variational_equations {
      δS/δu = 0, δS/δn_i = 0, δS/δG^{(k)} = 0, δS/δE^{(k)}_l = 0,
      δS/δh_j = 0, δS/δm = 0, δS/δw = 0
    }

    stochastic_stem_update {
      Pr[n_i(t+Δt)=1] = σ(-ΔE_i / kT)
      local_energy E_i = -J Σ_{j∈nbr(i)} n_j + α n_i + β d_i n_i + 2λ(n_i-u(x_i))² + 2γ(N-N*)²
    }

    canonical_object = (Ω, g_ij, S(t), S[S])
  }

