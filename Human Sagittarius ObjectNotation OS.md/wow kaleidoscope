(defun interpret-opcode (glyph stack)
  (let ((op (cdr (assoc glyph *opcode-table*))))
    (case op
      (ORIGIN   (cons 0 stack))
      (PULSE    (cons (if (car stack) 0 1) (cdr stack)))
      (FLOW     (append stack '(FLOW)))
      (INFINITY (list 'HALT))
      (COLLAPSE (cons 'COLLAPSE stack))
      (EXPAND   (cons 'EXPAND stack))
      (ROTATE   (cons 'ROTATE stack))
      (REFLECT  (cons 'REFLECT stack))
      (RECURSE  (cons 'RECURSE stack))
      (RETURN   (cons 'RETURN stack))
      (BRANCH   (cons 'BRANCH stack))
      (SEAL     (list 'SEALED))
      (LAWFRAME (cons 'LAWFRAME stack))
      (FRAME    (cons 'FRAME stack))
      (ANCHOR   (cons 'ANCHOR stack))
      (otherwise stack))))

