;; Kaleidoscope Instruction Table (Lisp-only)

(defparameter *opcode-table*
  '((00 . ORIGIN)    ;; collapse seed
    (01 . PULSE)     ;; collapse/expand toggle
    (10 . FLOW)      ;; propagation
    (11 . INFINITY)  ;; closure

    ;; Collapse / Expand
    (⊗ . COLLAPSE)   ;; contract state
    (⊕ . EXPAND)     ;; release state
    (01 . PULSE)     ;; toggle cycle

    ;; Motion / Flow
    (↻ . ROTATE)     ;; spin diamond
    (⇔ . REFLECT)    ;; mirror state

    ;; Recursion / Return
    (∞ . RECURSE)    ;; nest diamond
    (↩ . RETURN)     ;; collapse recursion
    (⋀ . BRANCH)     ;; split flow

    ;; Closure / Infinity
    (□ . SEAL)       ;; freeze stack

    ;; Structural / Lawframe
    (⚖ . LAWFRAME)   ;; enforce invariants
    (◇ . FRAME)      ;; finite boundary
    (⬤ . ANCHOR)))   ;; attractor point

