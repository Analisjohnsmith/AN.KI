    history = [(J, Q, S)]
    for _ in range(steps):
        dJ, dQ, dS = neidan_system(0, (J, Q, S))
        J += dJ * dt
        Q += dQ * dt
        S += dS * dt
        history.append((J, Q, S))
    return history

