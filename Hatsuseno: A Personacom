# │           python scroll1 run <s> [args...] | --version                │
# └───────────────────────────────────────────────────────────────────────┘

# SCROLLPACK CORE v1.0 — condensed sovereign package manager
# scroll1 is a self-contained registry of "scrolls" (condensed containers).
# Each scroll = manifest (name/version/language/kind) + zlib+base64 payload.
# Payloads are stored compressed (like a normal language registry) and
# extracted/verified/run on demand.
import sys, os, io, json, base64, zlib, hashlib, tempfile, subprocess

VERSION = "1.0"
NAME = "SCROLLPACK"
SCROLLS = {}


def _decode_blob(blob):
    return json.loads(zlib.decompress(base64.b64decode(blob)).decode("utf-8"))


def _human(n):
    for u in ("B", "KB", "MB", "GB"):
        if n < 1024:
            return "%.1f%s" % (n, u)
        n /= 1024.0
    return "%.1fGB" % n


def cmd_list():
    print("%s v%s — condensed scroll package manager" % (NAME, VERSION))
    print("")
    print("%-10s %-12s %-8s %-10s %-6s %-12s" % ("SCROLL", "KIND", "VERSION", "LANG", "FILES", "PAYLOAD"))
    print("-" * 68)
    tot = 0
    for name, s in SCROLLS.items():
        m = s["manifest"]
        tot += m.get("size", 0)
        print("%-10s %-12s %-8s %-10s %-6d %-12s" % (
            name, m.get("kind", "?"), m.get("version", "?"),
            m.get("language", "?"), len(m.get("files", [])), _human(m.get("size", 0))))
    print("-" * 68)
    print("total: %d scrolls, %s payload" % (len(SCROLLS), _human(tot)))
    return 0


def cmd_info(name):
    s = SCROLLS.get(name)
    if not s:
        print("no such scroll: %s" % name)
        return 1
    m = s["manifest"]
    print("name       : %s" % name)
    print("kind       : %s" % m.get("kind"))
    print("version    : %s" % m.get("version"))
    print("language   : %s" % m.get("language"))
    print("description: %s" % m.get("description", ""))
    print("entry      : %s" % m.get("entry", ""))
    print("payload    : %s (compressed) / %s (raw)" % (
        _human(len(s.get("blob", ""))), _human(m.get("size", 0))))
    print("files:")
    for f in m.get("files", []):
        print("  - %s" % f)
    return 0


def _checksum(payload):
    return hashlib.sha256(payload.encode("utf-8")).hexdigest()


def cmd_verify(name=None):
    names = [name] if name else list(SCROLLS)
    allok = True
    for n in names:
        s = SCROLLS.get(n)
        if not s:
            print("%-12s MISSING" % n)
            allok = False
            continue
        m = s["manifest"]
        try:
            data = _decode_blob(s["blob"])
        except Exception as e:
            print("%-12s CORRUPT (%s)" % (n, e))
            allok = False
            continue
        # round-trip: every manifest file must be present and byte-exact
        files = data.get("files", {})
        ok = len(files) == len(m.get("files", []))
        missing = [f for f in m.get("files", []) if f not in files]
        if missing:
            ok = False
        # checksum over the decompressed payload
        raw = zlib.decompress(base64.b64decode(s["blob"]))
        good = hashlib.sha256(raw).hexdigest() == m.get("payload_sha256", "")
        status = "OK (no loss)" if ok and good else "CORRUPT"
        if not ok:
            status += " missing=%s" % (missing or "?")
        print("%-12s %s" % (n, status))
        allok = allok and ok and good
    return 0 if allok else 1


def cmd_extract(name, dest=None):
    s = SCROLLS.get(name)
    if not s:
        print("no such scroll: %s" % name)
        return 1
    if dest is None:
        dest = name
    data = _decode_blob(s["blob"])
    os.makedirs(dest, exist_ok=True)
    n = 0
    for rel, content in data.get("files", {}).items():
        p = os.path.join(dest, rel.replace("/", os.sep))
        os.makedirs(os.path.dirname(p), exist_ok=True) if os.path.dirname(p) else None
        with io.open(p, "w", encoding="utf-8", newline="\n") as f:
            f.write(content)
        n += 1
    print("extracted %d files from %s -> %s" % (n, name, dest))
    return 0


def cmd_run(name, args=None):
    args = args or []
    s = SCROLLS.get(name)
    if not s:
        print("no such scroll: %s" % name)
        return 1
    m = s["manifest"]
    entry = m.get("entry")
    if not entry:
        print("scroll %s has no entry point" % name)
        return 1
    data = _decode_blob(s["blob"])
    files = data.get("files", {})
    if entry not in files:
        print("entry %s not found in scroll %s" % (entry, name))
        return 1
    td = tempfile.mkdtemp(prefix="scrollpack_")
    for rel, content in files.items():
        p = os.path.join(td, rel.replace("/", os.sep))
        d = os.path.dirname(p)
        if d:
            os.makedirs(d, exist_ok=True)
        with io.open(p, "w", encoding="utf-8", newline="\n") as f:
            f.write(content)
    cmd = [sys.executable, os.path.join(td, entry.replace("/", os.sep))] + list(args)
    print("$ %s" % " ".join(cmd))
    return subprocess.call(cmd, cwd=td)


USAGE = """%s v%s — condensed scroll package manager
scroll1 = a single file that IS a registry. Scrolls are compressed containers.

usage:
  python scroll1 list                list all scrolls
  python scroll1 info <scroll>       show a scroll's manifest
  python scroll1 verify [scroll]     verify integrity (no loss)
  python scroll1 extract <scroll>    extract a scroll to ./<scroll>/
  python scroll1 run <scroll> [args] run a scroll's entry point
  python scroll1 --version           show version
""" % (NAME, VERSION)


def main(argv=None):
    argv = argv if argv is not None else sys.argv[1:]
    if not argv or argv[0] in ("--help", "-h", "help"):
        print(USAGE)
        return 0
    if argv[0] == "--version":
        print("%s v%s" % (NAME, VERSION))
        return 0
    cmd = argv[0]
    if cmd == "list":
        return cmd_list()
    if cmd == "info":
        if len(argv) < 2:
            print("usage: scroll1 info <scroll>")
            return 1
        return cmd_info(argv[1])
    if cmd == "verify":
        return cmd_verify(argv[1] if len(argv) > 1 else None)
    if cmd == "extract":
        if len(argv) < 2:
            print("usage: scroll1 extract <scroll>")
            return 1
        return cmd_extract(argv[1], argv[2] if len(argv) > 2 else None)
    if cmd == "run":
        if len(argv) < 2:
            print("usage: scroll1 run <scroll> [args...]")
            return 1
        return cmd_run(argv[1], argv[2:])
    print("unknown command: %s" % cmd)
    print(USAGE)
    return 1



