class Scene:
    def __init__(self, engine=None):
        self.engine=engine; self.entities=[]; self.camera=Camera()
        self.input=InputManager() if not engine else engine.input
        self.active=True; self.paused=False

    def add_entity(self, entity):
        entity.scene=self; self.entities.append(entity); return entity

    def remove_entity(self, entity):
        if entity in self.entities: self.entities.remove(entity)

    def find_by_tag(self, tag):
        return [e for e in self.entities if e.tag==tag]

    def find_by_name(self, name):
        return [e for e in self.entities if e.name==name]

    def update(self, dt):
        if not self.active or self.paused: return
        for entity in self.entities[:]:
            if entity.active: entity.update(dt)
            else: self.entities.remove(entity)
        self.camera.update(dt)

    def render(self, canvas):
        if not self.active: return
        canvas.clear()
        for entity in self.entities:
            if entity.active: entity.render(canvas)

    def on_enter(self): pass
    def on_exit(self): pass


class SceneManager:
    def __init__(self): self.scenes={}; self.current=None; self.transition=None
    def add(self,name,scene): self.scenes[name]=scene
    def switch(self,name):
        if self.current: self.current.on_exit()
        self.current=self.scenes.get(name)
        if self.current: self.current.on_enter()


class Timer:
    def __init__(self): self.timers={}
    def set(self,name,duration,repeat=False,callback=None):
        self.timers[name]={'remaining':duration,'duration':duration,'repeat':repeat,'callback':callback,'active':True}
    def update(self,dt):
        for name,timer in list(self.timers.items()):
            if timer['active']:
                timer['remaining']-=dt
                if timer['remaining']<=0:
                    if timer['callback']: timer['callback']()
                    if timer['repeat']: timer['remaining']=timer['duration']
                    else: del self.timers[name]
    def cancel(self,name): self.timers.pop(name,None)
    def is_done(self,name): return name not in self.timers


class EventSystem:
    def __init__(self): self.listeners={}

    def on(self, event_type, callback):
        self.listeners.setdefault(event_type,[]).append(callback)

    def off(self, event_type, callback):
        if event_type in self.listeners:
            self.listeners[event_type]=[cb for cb in self.listeners[event_type] if cb!=callback]

    def emit(self, event_type, data=None):
        for cb in self.listeners.get(event_type,[]):
            cb(data)

    def clear(self): self.listeners.clear()


class GameEngine:
    def __init__(self, w=80, h=24, title="MarrowWeave Game"):
        self.width=w; self.height=h; self.title=title
        self.canvas=Canvas2D(w,h)
        self.input=InputManager()
        self.scenes=SceneManager()
        self.events=EventSystem()
        self.timers=Timer()
        self.resources=ResourceManager()
        self.running=False; self.fps=0; self.frame_count=0
        self.last_time=0; self.delta_time=0
        self.gravity=Vector2(0,200)
        self.systems=[]

    def add_system(self, system): self.systems.append(system)

    def update(self, dt):
        self.input.update()
        self.timers.update(dt)
        if self.scenes.current:
            self.scenes.current.input=self.input
            self.scenes.current.update(dt)
        for system in self.systems: system.update(dt)
        self.frame_count+=1

    def render(self):
        if self.scenes.current:
            self.scenes.current.render(self.canvas)
        TermUI.clear()
        print(self.canvas.to_terminal())

    def run(self, max_frames=None):
        self.running=True; self.last_time=time.time(); frames=0
        TermUI.enable_alt_buffer(); TermUI.hide_cursor()
        try:
            while self.running:
                now=time.time(); self.delta_time=min(0.1,now-self.last_time); self.last_time=now
                self.update(self.delta_time)
                self.render()
                self.fps=1.0/self.delta_time if self.delta_time>0 else 0
                frames+=1
                if max_frames and frames>=max_frames: break
                time.sleep(0.033)
        except KeyboardInterrupt: pass
        finally:
            TermUI.show_cursor(); TermUI.disable_alt_buffer()

    def stop(self): self.running=False


