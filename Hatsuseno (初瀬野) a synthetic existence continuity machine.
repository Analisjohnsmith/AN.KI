class ActivationFunction(Enum):
    SIGMOID=auto(); RELU=auto(); TANH=auto(); LEAKY_RELU=auto()
    SOFTMAX=auto(); ELU=auto(); SWISH=auto(); GELU=auto()

def apply_activation(x, func):
    if func==ActivationFunction.SIGMOID: return _sigmoid(x)
    elif func==ActivationFunction.RELU: return _relu(x)
    elif func==ActivationFunction.TANH: return math.tanh(x)
    elif func==ActivationFunction.LEAKY_RELU: return x if x>0 else 0.01*x
    elif func==ActivationFunction.ELU: return x if x>0 else math.exp(x)-1
    elif func==ActivationFunction.SWISH: return x*_sigmoid(x)
    elif func==ActivationFunction.GELU: return 0.5*x*(1+math.tanh(math.sqrt(2/math.pi)*(x+0.044715*x**3)))
    return x

def apply_activation_deriv(x, func):
    if func==ActivationFunction.SIGMOID: s=_sigmoid(x); return s*(1-s)
    elif func==ActivationFunction.RELU: return 1.0 if x>0 else 0.0
    elif func==ActivationFunction.TANH: t=math.tanh(x); return 1-t*t
    elif func==ActivationFunction.LEAKY_RELU: return 1.0 if x>0 else 0.01
    elif func==ActivationFunction.ELU: return math.exp(x) if x>0 else math.exp(x)
    elif func==ActivationFunction.SWISH: s=_sigmoid(x); return s+x*s*(1-s)
    return 1.0

class DenseLayer:
    def __init__(self, in_sz, out_sz, act=ActivationFunction.RELU):
        scale = math.sqrt(2.0/in_sz)
        self.weights = [[random.gauss(0,scale) for _ in range(out_sz)] for _ in range(in_sz)]
        self.biases = [0.0]*out_sz; self.activation = act
        self.input_cache = [0.0]*in_sz; self.z_cache = [0.0]*out_sz

    def forward(self, inputs):
        self.input_cache = inputs[:]
        outputs = []
        for j in range(len(self.biases)):
            z = self.biases[j]
            for i in range(len(inputs)): z += inputs[i]*self.weights[i][j]
            self.z_cache[j] = z
            outputs.append(apply_activation(z, self.activation))
        return outputs

    def backward(self, d_out, lr=0.001):
        d_inputs = [0.0]*len(self.input_cache)
        for j in range(len(self.biases)):
            dz = d_out[j]*apply_activation_deriv(self.z_cache[j], self.activation)
            self.biases[j] += dz*lr
            for i in range(len(self.input_cache)):
                self.weights[i][j] += dz*self.input_cache[i]*lr
                d_inputs[i] += dz*self.weights[i][j]
        return d_inputs

class NeuralNetwork:
    def __init__(self, layer_sizes, activations=None):
        self.layers = []
        if activations is None:
            activations = [ActivationFunction.RELU]*(len(layer_sizes)-2)+[ActivationFunction.SIGMOID]
        for i in range(len(layer_sizes)-1):
            self.layers.append(DenseLayer(layer_sizes[i], layer_sizes[i+1], activations[i]))

    def forward(self, x):
        for layer in self.layers: x = layer.forward(x)
        return x

    def train_step(self, x, y_true, lr=0.001):
        y_pred = self.forward(x)
        loss = sum((p-t)**2 for p,t in zip(y_pred,y_true))/len(y_true)
        d_out = [2*(p-t)/len(y_true) for p,t in zip(y_pred,y_true)]
        for layer in reversed(self.layers): d_out = layer.backward(d_out, lr)
        return loss

    def train(self, data, epochs=100, lr=0.001):
        losses = []
        for ep in range(epochs):
            el = 0.0
            for x,y in data: el += self.train_step(x,y,lr)
            losses.append(el/len(data))
        return losses

    def predict(self, x): return self.forward(x)


class ReinforcementLearningAgent:
    def __init__(self, state_sz, action_sz, lr=0.1, discount=0.95, epsilon=0.1):
        self.q_table={}; self.lr=lr; self.discount=discount
        self.epsilon=epsilon; self.action_sz=action_sz

    def get_key(self, state): return json.dumps([round(s,2) for s in state])

    def choose_action(self, state):
        if random.random()<self.epsilon: return random.randint(0,self.action_sz-1)
        sk = self.get_key(state)
        qs = [self.q_table.get(f"{sk}:{a}",0.0) for a in range(self.action_sz)]
        return qs.index(max(qs))

    def learn(self, state, action, reward, next_state):
        sk, nk = self.get_key(state), self.get_key(next_state)
        cq = self.q_table.get(f"{sk}:{action}",0.0)
        mnq = max(self.q_table.get(f"{nk}:{a}",0.0) for a in range(self.action_sz))
        self.q_table[f"{sk}:{action}"] = cq+self.lr*(reward+self.discount*mnq-cq)


class GeneticAlgorithm:
    def __init__(self, fitness_fn, pop_sz=100, gene_len=10, mut_rate=0.01):
        self.fitness_fn=fitness_fn; self.pop_sz=pop_sz
        self.gene_len=gene_len; self.mut_rate=mut_rate
        self.pop=[[random.random() for _ in range(gene_len)] for _ in range(pop_sz)]

    def evolve(self, generations=100):
        for _ in range(generations):
            fit = [self.fitness_fn(ind) for ind in self.pop]
            bi = fit.index(max(fit))
            new_pop = [self.pop[bi][:]]
            while len(new_pop)<self.pop_sz:
                p = random.sample(range(self.pop_sz),2)
                if self.gene_len>1:
                    cr = random.randint(1,self.gene_len-1)
                    child = self.pop[p[0]][:cr]+self.pop[p[1]][cr:]
                else:
                    child = self.pop[p[0]][:]
                for i in range(self.gene_len):
                    if random.random()<self.mut_rate: child[i]+=random.gauss(0,0.1)
                new_pop.append(child)
            self.pop = new_pop
        fit = [self.fitness_fn(i) for i in self.pop]
        bi = fit.index(max(fit))
        return self.pop[bi], max(fit)


