]

OP: Dict[str, int] = {name: i for i, name in enumerate(OPCODES)}
REV_OP: Dict[int, str] = {v: k for k, v in OP.items()}

SYMBOLS: Dict[str, str] = {
    "NOP": ".", "LOAD": "\u25ce", "SET": "\u2605",
    "STORE": "\u25c9", "ADD": "+", "SUB": "-",
    "MUL": "\u00d7", "DIV": "\u00f7", "JUMP": "\u21ba",
