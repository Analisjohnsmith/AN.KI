    @staticmethod
    def bg_rgb(r,g,b): return f"\033[48;2;{r};{g};{b}m"
    RESET="\033[0m"; BOLD="\033[1m"; DIM="\033[2m"; ITALIC="\033[3m"
    UNDERLINE="\033[4m"; REVERSE="\033[7m"; STRIKETHROUGH="\033[9m"
    RED="\033[31m"; GREEN="\033[32m"; YELLOW="\033[33m"; BLUE="\033[34m"
    MAGENTA="\033[35m"; CYAN="\033[36m"; WHITE="\033[37m"; BLACK="\033[30m"
    BG_RED="\033[41m"; BG_GREEN="\033[42m"; BG_YELLOW="\033[43m"; BG_BLUE="\033[44m"
    BG_MAGENTA="\033[45m"; BG_CYAN="\033[46m"; BG_WHITE="\033[47m"; BG_BLACK="\033[40m"

    @staticmethod
    def gradient(text, c1, c2):
        result=[]
        for i,ch in enumerate(text):
            t=i/max(1,len(text)-1)
            r=int(c1[0]+(c2[0]-c1[0])*t); g=int(c1[1]+(c2[1]-c1[1])*t); b=int(c1[2]+(c2[2]-c1[2])*t)
            result.append(f"{TermColor.rgb(r,g,b)}{ch}")
        return ''.join(result)+TermColor.RESET

    @staticmethod
    def rainbow(text):
        result=[]
        for i,ch in enumerate(text):
            hue=(i*30)%360
            r,g,b=[int(v*255) for v in colorsys.hsv_to_rgb(hue/360.0,1.0,1.0)]
            result.append(f"{TermColor.rgb(r,g,b)}{ch}")
        return ''.join(result)+TermColor.RESET

    @staticmethod
    def fire(text):
        colors=[(255,0,0),(255,128,0),(255,255,0),(255,128,0),(255,0,0)]
        result=[]
        for i,ch in enumerate(text):
            t=(i/max(1,len(text)-1))*(len(colors)-1)
            idx=min(int(t),len(colors)-2); frac=t-idx
            c1,c2=colors[idx],colors[idx+1]
            c=tuple(int(c1[j]+(c2[j]-c1[j])*frac) for j in range(3))
            result.append(f"{TermColor.rgb(*c)}{ch}")
        return ''.join(result)+TermColor.RESET

    @staticmethod
    def ocean(text):
        colors=[(0,100,200),(0,200,255),(100,255,255),(0,200,255),(0,100,200)]
        result=[]
        for i,ch in enumerate(text):
            t=(i/max(1,len(text)-1))*(len(colors)-1)
            idx=min(int(t),len(colors)-2); frac=t-idx
            c1,c2=colors[idx],colors[idx+1]
            c=tuple(int(c1[j]+(c2[j]-c1[j])*frac) for j in range(3))
            result.append(f"{TermColor.rgb(*c)}{ch}")
        return ''.join(result)+TermColor.RESET


class TermUI:
    @staticmethod
    def clear(): os.system('cls' if os.name=='nt' else 'clear')
    @staticmethod
    def get_size():
        try: return os.get_terminal_size()
        except: return type('',(),{'columns':80,'lines':24})()
    @staticmethod
    def set_cursor(x,y): print(f"\033[{y};{x}H",end='')
    @staticmethod
    def hide_cursor(): print("\033[?25l",end='')
    @staticmethod
    def show_cursor(): print("\033[?25h",end='')
    @staticmethod
    def enable_alt_buffer(): print("\033[?1049h",end=''); TermUI.clear()
    @staticmethod
    def disable_alt_buffer(): print("\033[?1049l",end='')

    @staticmethod
    def progress_bar(value, width=30):
        filled=int(value*width); empty=width-filled
        if value<0.3: color=TermColor.RED
        elif value<0.7: color=TermColor.YELLOW
        else: color=TermColor.GREEN
        return f"{color}{'█'*filled}{TermColor.DIM}{'░'*empty}{TermColor.RESET} {value*100:.1f}%"

    @staticmethod
    def sparkline(values, width=20):
        sparks=" ▁▂▃▄▅▆▇█"
        mn,mx=min(values) if values else 0,max(values) if values else 1
        rng=mx-mn if mx!=mn else 1
        return ''.join(sparks[max(0,min(7,int((v-mn)/rng*7)))] for v in values[-width:])

    @staticmethod
    def bar_chart(values, width=40, height=10):
        if not values: return ["No data"]
        mx=max(values) if max(values)>0 else 1
        lines=[]
        for row in range(height-1,-1,-1):
            line=""
            threshold=(row+1)/height*mx
            for val in values:
                bw=max(1,int(val/mx*width/len(values)))
                if val>=threshold: line+=TermColor.GREEN+"█"*bw+TermColor.RESET+" "
                elif val>=threshold*0.5: line+=TermColor.YELLOW+"▓"*bw+TermColor.RESET+" "
                else: line+=" "*(bw+1)
            lines.append(line)
        return lines

    @staticmethod
    def table(headers, rows, cw=15):
        lines=[]
        sep="+"+"+".join("-"*(cw+2) for _ in headers)+"+"
        hl="|"+"|".join(f" {TermColor.BOLD}{h:^{cw}}{TermColor.RESET} " for h in headers)+"|"
        lines.append(sep); lines.append(hl); lines.append(sep)
        for row in rows:
            rl="|"+"|".join(f" {str(c):^{cw}} " for c in row)+"|"
            lines.append(rl)
        lines.append(sep)
        return lines

    @staticmethod
    def histogram(data, bins=10, width=40, height=10):
        if not data: return ["No data"]
        mn,mx=min(data),max(data)
        bs=(mx-mn)/bins if mx>mn else 1
        counts=[0]*bins
        for v in data: counts[min(int((v-mn)/bs),bins-1)]+=1
        mc=max(counts) if counts else 1
        lines=[]
        for row in range(height-1,-1,-1):
            line=""; threshold=(row+1)/height*mc
            for count in counts:
                bw=max(1,width//bins)
                if count>=threshold: line+=TermColor.CYAN+"█"*bw+TermColor.RESET
                else: line+=" "*bw
            lines.append(line)
        return lines

    @staticmethod
    def line_graph(data, width=60, height=15, label="Value"):
        lines=[f" {TermColor.BOLD}{label}{TermColor.RESET}"]
        if not data: return lines+["No data"]
        mn,mx=min(data),max(data)
        rng=mx-mn if mx!=mn else 1
        grid=[[' ' for _ in range(width)] for _ in range(height)]
        prev_y=None
        for i,val in enumerate(data[-width:]):
            y=height-1-int((val-mn)/rng*(height-1))
            y=max(0,min(height-1,y))
            if prev_y is not None and abs(y-prev_y)>1:
                step=1 if y>prev_y else -1
                for cy in range(prev_y,y+step,step):
                    if 0<=cy<height: grid[cy][i]='│' if cy!=y else '●'
            elif 0<=y<height: grid[y][i]='●'
            prev_y=y
        for row in grid: lines.append(''.join(row))
        lines.append(f" Min:{mn:.2f} Max:{mx:.2f}")
        return lines

    @staticmethod
    def heatmap(data, width=40, height=20):
        if not data or not data[0]: return ["No data"]
        mn=min(min(r) for r in data); mx=max(max(r) for r in data)
        rng=mx-mn if mx>mn else 1
        lines=[]
        for r in range(min(len(data),height)):
            line=""
            for c in range(min(len(data[0]),width//2)):
                val=data[r][c]; n=(val-mn)/rng
                rc=int(255*n); gc=int(255*(1-n)); bc=int(128*(1-abs(n-0.5)*2))
                line+=f"{TermColor.rgb(rc,gc,bc)}██{TermColor.RESET}"
            lines.append(line)
        return lines

    @staticmethod
    def radar_chart(values, labels, size=15):
        n=len(values)
        if n<3: return ["Need at least 3 values"]
        mx=max(values) if max(values)>0 else 1
        grid=[[' ' for _ in range(size*2+1)] for _ in range(size+1)]
        cx,cy=size,size
        for ring in range(1,4):
            r=size*ring/3
            for angle in range(0,360,10):
                x=int(cx+r*math.cos(math.radians(angle)))
                y=int(cy+r*math.sin(math.radians(angle)))
                if 0<=x<len(grid[0]) and 0<=y<len(grid): grid[y][x]='·'
        pts=[]
        for i in range(n):
            angle=math.tau*i/n-math.pi/2; r=values[i]/mx*size
            x=int(cx+r*math.cos(angle)); y=int(cy+r*math.sin(angle))
            pts.append((x,y))
            if 0<=x<len(grid[0]) and 0<=y<len(grid): grid[y][x]='●'
        for i in range(n):
            j=(i+1)%n; x1,y1=pts[i]; x2,y2=pts[j]
            steps=max(abs(x2-x1),abs(y2-y1))
            if steps==0: continue
            for s in range(steps+1):
                t=s/steps; x=int(x1+(x2-x1)*t); y=int(y1+(y2-y1)*t)
                if 0<=x<len(grid[0]) and 0<=y<len(grid) and grid[y][x]==' ': grid[y][x]='·'
        return [''.join(row) for row in grid]


