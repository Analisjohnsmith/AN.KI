class UnifiedContainer:
    """
    The Unified Container C = (X, S, F, G, E).
    Implements the full dynamical system from the mathematics.
    """
    dim: int = 8
    gamma: float = 0.95
    lam: float = 0.01
    eta: float = 0.005
    tau_rise: float = 5.0
    tau_decay: float = 10.0
    tau_choice: float = 1.0
    epsilon: float = 1e-6
    rho: float = 0.1
    kappa: float = 0.5
    delta_t: float = 0.1
    B: float = 1.0

    def __post_init__(self):
        d = self.dim
        self.P = [0.0] * d
        self.M = [0.0] * d
        self.alpha = 0.5
        self.phi = 0.0
        self.w = [1.0 / d] * d
        self.E = 0.0
        self.t = 0

    def beta(self) -> float:
        return 1.0 - self.alpha * self.phi

    def surplus(self, X: List[float]) -> float:
        s = 0.0
        for i in range(self.dim):
            s += (X[i] - self.M[i]) ** 2
        return math.sqrt(s)

    def utility(self, X: List[float]) -> float:
        s = 0.0
        for i in range(self.dim):
            s += self.w[i] * X[i]
        return s

    def novelty(self, X: List[float]) -> float:
        return self.surplus(X)

    def familiarity(self, X: List[float]) -> float:
        s2 = self.surplus(X) ** 2
        return math.exp(-s2)

    def feedback_map(self, E: float) -> float:
        return E

    def update_perception(self, X: List[float]) -> List[float]:
        b = self.beta()
        return [b * X[i] + (1 - b) * self.M[i] for i in range(self.dim)]

    def update_memory(self, X: List[float]) -> List[float]:
        return [self.gamma * self.M[i] + (1 - self.gamma) * X[i]
                for i in range(self.dim)]

    def update_attention(self, X: List[float]) -> float:
        s = self.surplus(X)
        u = self.utility(X)
        return max(0.0, min(1.0,
            self.alpha + self.lam * (s * u - self.alpha)))

    def update_fatigue(self, active: bool) -> float:
        if active:
            dphi = (1.0 - self.phi) / self.tau_rise
        else:
            dphi = -self.phi / self.tau_decay
        return max(0.0, min(1.0, self.phi + self.delta_t * dphi))

    def update_preference(self, X: List[float]) -> List[float]:
        f = self.feedback_map(self.E)
        raw = [self.w[i] + self.eta * f * X[i] for i in range(self.dim)]
        total = sum(max(0.0, v) for v in raw) or 1.0
        return [max(0.0, v) / total for v in raw]

    def project_onto_K(self, vec: List[float]) -> List[float]:
        norm = math.sqrt(sum(v * v for v in vec)) or 1.0
        scale = min(1.0, self.B / norm)
        return [v * scale for v in vec]

    def step(self, X: List[float], E: float, active: bool = True) -> List[float]:
        self.E = E
        self.P = self.project_onto_K(self.update_perception(X))
        self.M = self.project_onto_K(self.update_memory(X))
        self.alpha = self.update_attention(X)
        self.phi = self.update_fatigue(active)
        self.w = self.update_preference(X)
        self.t += 1
        return self.P

    def choice_distribution(self, candidates: List[List[float]]) -> List[float]:
        tau_eff = self.tau_choice / max(self.epsilon, self.alpha)
        scores = []
        for X in candidates:
            u = self.utility(X)
            n = self.novelty(X)
            f = self.familiarity(X)
            scores.append((u + self.rho * n - self.kappa * f) / tau_eff)
        max_s = max(scores)
        exps = [math.exp(s - max_s) for s in scores]
        total = sum(exps) or 1.0
        return [e / total for e in exps]

    def output(self) -> List[float]:
        return list(self.P)

    def state_vector(self) -> Dict[str, Any]:
        return {
            "P": list(self.P), "M": list(self.M),
            "alpha": self.alpha, "phi": self.phi,
            "w": list(self.w), "E": self.E, "t": self.t
        }


