    neighbors: List["LifeNode"] = field(default_factory=list)

    def next_state(self) -> "LifeNode":
        alive_n = sum(1 for n in self.neighbors if n.alive)
        if self.alive and alive_n in (2, 3):
            return LifeNode("\u2022", True, self.neighbors)
