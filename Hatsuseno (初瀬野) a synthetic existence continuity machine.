def demo_game_engine():
    print(f"\n{TermColor.CYAN}{TermColor.BOLD}{'='*60}")
    print(f"  GAME ENGINE DEMONSTRATION")
    print(f"{'='*60}{TermColor.RESET}\n")

    engine = GameEngine(w=60, h=20, title="MarrowWeave Game Demo")

    class MenuScene(Scene):
        def on_enter(self):
            self.selected = 0
            self.options = ["New Game", "Settings", "Quit"]

        def update(self, dt):
            if self.input.is_key_pressed('w') or self.input.is_key_pressed('up'):
                self.selected = (self.selected - 1) % len(self.options)
            if self.input.is_key_pressed('s') or self.input.is_key_pressed('down'):
                self.selected = (self.selected + 1) % len(self.options)

        def render(self, canvas):
            canvas.clear((10, 10, 30, 255))
            title = "MARROWWEAVE"
            for i, ch in enumerate(title):
                canvas.set_pixel(25+i, 3, (0, 255, 255, 255))
            for i, opt in enumerate(self.options):
                color = (255, 255, 0, 255) if i == self.selected else (200, 200, 200, 255)
                prefix = "> " if i == self.selected else "  "
                for j, ch in enumerate(prefix + opt):
                    canvas.set_pixel(20+j, 10+i*2, color)

    class GameScene(Scene):
        def on_enter(self):
            self.player = Entity("player")
            self.player.transform.position = Vector2(30, 10)
            self.player.transform.friction = 0.9
            self.player.tag = "player"
            self.particles = ParticleComponent(200)
            self.player.add(self.particles)
            self.player.health = HealthComponent(100)
            self.add_entity(self.player)

            self.score = 0
            self.enemies = []
            for i in range(5):
                e = Entity(f"enemy_{i}")
                e.transform.position = Vector2(random.randint(5,55), random.randint(3,17))
                e.tag = "enemy"
                e.ai = AIAgentComponent('patrol')
                e.ai.patrol_points = [
                    Vector2(random.randint(5,55), random.randint(3,17))
                    for _ in range(3)
                ]
                e.ai.speed = 30
                e.add(e.ai)
                self.enemies.append(e)
                self.add_entity(e)

            self.camera.target = self.player

        def update(self, dt):
            t = self.player.transform
            if self.input.is_key_down('a'): t.acceleration = Vector2(-300, 0)
            elif self.input.is_key_down('d'): t.acceleration = Vector2(300, 0)
            elif self.input.is_key_down('w'): t.acceleration = Vector2(0, -300)
            elif self.input.is_key_down('s'): t.acceleration = Vector2(0, 300)
            else: t.acceleration = Vector2()

            if self.input.is_key_pressed('space'):
                self.particles.emit(t.position.x, t.position.y, Color4.cyan(), count=20)

            for e in self.enemies[:]:
                if e.transform.position.distance(t.position) < 3:
                    self.particles.emit(e.transform.position.x, e.transform.position.y, Color4.red(), count=30)
                    self.enemies.remove(e)
                    self.score += 100
                    if self.enemies:
                        new_e = Entity("new_enemy")
                        new_e.transform.position = Vector2(random.randint(5,55), random.randint(3,17))
                        new_e.tag = "enemy"
                        self.enemies.append(new_e)
                        self.add_entity(new_e)

            super().update(dt)

        def render(self, canvas):
            canvas.clear((5, 5, 15, 255))
            for e in self.entities:
                t = e.transform
                sx, sy = self.camera.world_to_screen(t.position)
                if e.tag == "player":
                    canvas.set_pixel(sx, sy, (0, 255, 255, 255))
                    canvas.set_pixel(sx-1, sy, (0, 200, 200, 255))
                    canvas.set_pixel(sx+1, sy, (0, 200, 200, 255))
                    canvas.set_pixel(sx, sy-1, (0, 200, 200, 255))
                elif e.tag == "enemy":
                    canvas.set_pixel(sx, sy, (255, 50, 50, 255))
                    canvas.set_pixel(sx-1, sy, (200, 0, 0, 255))
                    canvas.set_pixel(sx+1, sy, (200, 0, 0, 255))
            score_text = f"Score: {self.score}"
            for i, ch in enumerate(score_text):
                canvas.set_pixel(2+i, 1, (255, 255, 0, 255))

    menu = MenuScene(engine)
    game = GameScene(engine)
    engine.scenes.add("menu", menu)
    engine.scenes.add("game", game)
    engine.scenes.switch("menu")

    print(f"  Game Engine Components:")
