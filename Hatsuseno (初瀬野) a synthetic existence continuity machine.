Coord = Tuple[int, int]


@dataclass
class Cell:
    x: int
    y: int
    opcode: int = 0
    arg: float = 0.0


@dataclass
class MandalaCPU:
    center: Coord
    radius: int
    rings: Dict[int, List[Cell]] = field(default_factory=dict)
    registers: Dict[int, float] = field(default_factory=dict)
    pc: Dict[int, int] = field(default_factory=dict)
    memory: Dict[Coord, float] = field(default_factory=dict)
    temples: Dict[str, Any] = field(default_factory=dict)
    cluster: Any = None

    def __post_init__(self):
        self._init_rings()

    def _init_rings(self):
        cx, cy = self.center
        for r in range(1, self.radius + 1):
            cells = []
            for angle_idx in range(8 * r):
                angle = 2 * math.pi * angle_idx / (8 * r)
                x = int(cx + r * math.cos(angle))
                y = int(cy + r * math.sin(angle))
                cells.append(Cell(x, y))
            self.rings[r] = cells
            self.registers[r] = 0.0
            self.pc[r] = 0

    def tick(self):
        for r in range(1, self.radius + 1):
            self._step_ring(r)

    def _step_ring(self, r: int):
        cells = self.rings[r]
        idx = self.pc[r]
        cell = cells[idx]
        acc = self.registers[r]
        op = cell.opcode
        arg = cell.arg

        if op == OP["SET"]:
            acc = arg
        elif op == OP["LOAD"]:
            acc = self.memory.get((cell.x, cell.y), 0.0)
        elif op == OP["STORE"]:
            self.memory[(cell.x, cell.y)] = acc
        elif op == OP["ADD"]:
            acc += 1
        elif op == OP["SUB"]:
            acc -= 1
        elif op == OP["MUL"]:
            acc *= 2
        elif op == OP["DIV"]:
            if acc != 0:
                acc /= 2
        elif op == OP["JUMP"]:
            self.pc[r] = (idx + int(arg)) % len(cells)
            self.registers[r] = acc
            return
        elif op == OP["MUTATE"]:
            target = random.choice(cells)
            target.opcode = random.choice(list(OP.values()))
        elif op == OP["CALL_TEMPLE"]:
            if arg in self.temples:
                acc = self.temples[arg](self, acc)
        elif op == OP["CALL_CLUSTER"]:
            if self.cluster:
                acc = self.cluster.route(self, acc)

        self.registers[r] = acc
        self.pc[r] = (idx + 1) % len(cells)

    def dump_registers(self) -> Dict[int, float]:
        return dict(self.registers)

    def dump_memory(self) -> Dict[Coord, float]:
        return dict(self.memory)


