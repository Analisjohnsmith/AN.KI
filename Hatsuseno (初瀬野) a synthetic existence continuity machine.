# IFS generators: f_j(z) = r_j * e^{i*theta_j} * z + t_j
# 27 phonemes mapped from Greek -> Sanskrit


PHI = (1 + 5 ** 0.5) / 2


def _fibonacci(n: int) -> int:
    if n <= 0:
        return 0
    if n == 1:
        return 1
    a, b = 0, 1
    for _ in range(2, n + 1):
        a, b = b, a + b
    return b


def _is_vowel(j: int) -> bool:
    return j in (1, 2, 3, 7, 8, 9)


PHONEME_NAMES = [
    "Alpha", "Beta", "Gamma", "Delta", "Epsilon",
    "Zeta", "Eta", "Theta", "Iota", "Kappa",
    "Lambda", "Mu", "Nu", "Xi", "Omicron",
    "Pi", "Rho", "Sigma", "Tau", "Upsilon",
    "Phi", "Chi", "Psi", "Omega", "Sampi",
    "Koppa", "Stigma"
]


@dataclass
class PhonemeParams:
    index: int
    name: str
    r: float
    theta: float
    w: float
    t_real: float
    t_imag: float


def make_phoneme_params(j: int, w0: float = 1.0, alpha: float = 0.35,
                         rho: float = 0.01) -> PhonemeParams:
    p = 0.5 + (j - 1) / 6.0
    r = PHI ** (-p)
    mj = j % 12
    fib_n = _fibonacci(mj)
    fib_np1 = _fibonacci(mj + 1)
    theta = 2 * math.pi * (fib_n / fib_np1) if fib_np1 != 0 else 0.0
    w = w0 * (1.0 + alpha * (1.0 if _is_vowel(j) else 0.0))
    t_r = rho * math.cos(j * 0.5)
    t_i = rho * math.sin(j * 0.5)
    name = PHONEME_NAMES[j - 1] if 1 <= j <= len(PHONEME_NAMES) else f"Phoneme_{j}"
    return PhonemeParams(j, name, r, theta, w, t_r, t_i)


def iterated_attractor(z0_r: float, z0_i: float, r: float, theta: float,
                        t_r: float, t_i: float, w: float,
                        T: int = 12) -> Tuple[float, float]:
    zr, zi = z0_r, z0_i
    acc_r = w * zr
    acc_i = w * zi
    cos_t = math.cos(theta)
    sin_t = math.sin(theta)
    for _ in range(T):
        new_zr = r * (zr * cos_t - zi * sin_t) + t_r
        new_zi = r * (zr * sin_t + zi * cos_t) + t_i
        zr, zi = new_zr, new_zi
        acc_r += w * zr
        acc_i += w * zi
    return acc_r, acc_i


@dataclass
class PhonemeCont:
    """Fractal-augmented phoneme continuity element."""
    index: int
    name: str
    z0_r: float = 0.0
    z0_i: float = 0.0
    place_r: float = 0.0
    place_i: float = 0.0
    mother_r: float = 0.0
    mother_i: float = 0.0
    witness_r: float = 0.0
    witness_i: float = 0.0
    final_r: float = 0.0
    final_i: float = 0.0


def phoneme_continuity(
    n: int, i_idx: int, m: int, j: int,
    r0: float = 1.0, k: float = 0.98,
    beta_mother: float = 0.2, kappa: float = 0.5,
    T: int = 12
) -> PhonemeCont:
    params = make_phoneme_params(j)
    r0k = r0 * (k ** n)
    theta_base = 2 * math.pi * (i_idx % 12) / 12.0
    Fm = _fibonacci(m)
    theta_sum = theta_base + params.theta
    cos_ts = math.cos(theta_sum)
    sin_ts = math.sin(theta_sum)
    z0_r = r0k * cos_ts * Fm
    z0_i = r0k * sin_ts * Fm
    fz_r, fz_i = iterated_attractor(
        z0_r, z0_i, params.r, params.theta,
        params.t_real, params.t_imag, params.w, T
    )
    place_r = fz_r
    place_i = fz_i
    mother_r = (1 - beta_mother) * place_r + beta_mother * place_r
    mother_i = (1 - beta_mother) * place_i - beta_mother * place_i
    coherence = max(0.0, min(1.0, 0.5 + 0.5 * math.sin(j * 0.3)))
    witness_r = mother_r * (1 + kappa * coherence)
    witness_i = mother_i * (1 + kappa * coherence)
    L, U = 1e-8, 1e8
    final_r = max(L, min(U, witness_r))
    final_i = max(L, min(U, witness_i))
    return PhonemeCont(
        j, params.name, z0_r, z0_i,
        place_r, place_i, mother_r, mother_i,
        witness_r, witness_i, final_r, final_i
    )


def universal_continuity(
    n: int, i_idx: int, m: int,
    Theta: float = 1.0, num_phonemes: int = 27,
    **kwargs
) -> Tuple[float, float]:
    total_r, total_i = 0.0, 0.0
    for j in range(1, num_phonemes + 1):
        pc = phoneme_continuity(n, i_idx, m, j, **kwargs)
        total_r += pc.final_r
        total_i += pc.final_i
    return Theta * total_r, Theta * total_i


# ============================================================
#  w-operator (harmonic bridge)
# ============================================================


def w_operator(a: float, b: float) -> float:
    """w(a,b) = 2ab / (a+b). Harmonic bridge between two values."""
    s = a + b
    return (2.0 * a * b / s) if s != 0 else 0.0


def w_operator_p(a: float, b: float, p: float) -> float:
    """Generalized w-operator: w_p(a,b) = ((a^-p + b^-p)/2)^(-1/p)"""
    if a <= 0 or b <= 0 or p == 0:
        return w_operator(a, b)
    inv_p = -p
    return ((a ** inv_p + b ** inv_p) / 2.0) ** (-1.0 / p)


