class DecisionTree:
    def __init__(self, max_depth=10, min_samples=5):
        self.max_depth=max_depth; self.min_samples=min_samples; self.root=None

    def _gini(self, labels):
        if not labels: return 0.0
        counts = {}
        for l in labels: counts[l]=counts.get(l,0)+1
        return 1.0-sum((c/len(labels))**2 for c in counts.values())

    def _build(self, X, y, depth):
        if len(set(y))==1 or depth>=self.max_depth or len(y)<self.min_samples:
            return DecisionTreeNode(value=max(set(y),key=y.count))
        best_gain, bf, bt = -1, 0, 0.0
        pg = self._gini(y)
        for feat in range(len(X[0])):
            vals = sorted(set(X[i][feat] for i in range(len(X))))
            for i in range(len(vals)-1):
                th = (vals[i]+vals[i+1])/2
                ll = [y[j] for j in range(len(X)) if X[j][feat]<=th]
                rl = [y[j] for j in range(len(X)) if X[j][feat]>th]
                if not ll or not rl: continue
                wg = (len(ll)*self._gini(ll)+len(rl)*self._gini(rl))/len(y)
                gain = pg-wg
                if gain>best_gain: best_gain, bf, bt = gain, feat, th
        if best_gain<=0: return DecisionTreeNode(value=max(set(y),key=y.count))
        lx=[X[i] for i in range(len(X)) if X[i][bf]<=bt]
        ly=[y[i] for i in range(len(X)) if X[i][bf]<=bt]
        rx=[X[i] for i in range(len(X)) if X[i][bf]>bt]
        ry=[y[i] for i in range(len(X)) if X[i][bf]>bt]
        return DecisionTreeNode(feature=bf,threshold=bt,left=self._build(lx,ly,depth+1),right=self._build(rx,ry,depth+1))

    def fit(self, X, y): self.root = self._build(X,y,0)

    def predict(self, X): return [self._p(x,self.root) for x in X]

    def _p(self, x, n):
        if n.value is not None: return n.value
        return self._p(x,n.left) if x[n.feature]<=n.threshold else self._p(x,n.right)


class KMeans:
    def __init__(self, k=3, max_iters=100): self.k=k; self.max_iters=max_iters
    def fit(self, X):
        n, dim = len(X), len(X[0])
        self.centroids = [X[i][:] for i in random.sample(range(n),self.k)]
        for _ in range(self.max_iters):
            self.labels = []
            for pt in X:
                ds = [sum((pt[d]-c[d])**2 for d in range(dim)) for c in self.centroids]
                self.labels.append(ds.index(min(ds)))
            nc = [[0.0]*dim for _ in range(self.k)]; cnt=[0]*self.k
            for i,pt in enumerate(X):
                cl=self.labels[i]; cnt[cl]+=1
                for d in range(dim): nc[cl][d]+=pt[d]
            for c in range(self.k):
                if cnt[c]>0:
                    for d in range(dim): nc[c][d]/=cnt[c]
            if nc==self.centroids: break
            self.centroids=nc

    def predict(self, X):
        dim=len(X[0])
        return [min(range(self.k),key=lambda c:sum((X[i][d]-self.centroids[c][d])**2 for d in range(dim))) for i in range(len(X))]


class LSTMCell:
    def __init__(self, in_sz, hidden_sz):
        self.h = hidden_sz
        s = lambda r,c: [[random.gauss(0,math.sqrt(2.0/(r+c))) for _ in range(c)] for _ in range(r)]
        self.Wf=s(hidden_sz,in_sz); self.Uf=s(hidden_sz,hidden_sz); self.bf=[-1.0]*hidden_sz
        self.Wi=s(hidden_sz,in_sz); self.Ui=s(hidden_sz,hidden_sz); self.bi=[0.0]*hidden_sz
        self.Wc=s(hidden_sz,in_sz); self.Uc=s(hidden_sz,hidden_sz); self.bc=[0.0]*hidden_sz
        self.Wo=s(hidden_sz,in_sz); self.Uo=s(hidden_sz,hidden_sz); self.bo=[0.0]*hidden_sz

    def forward(self, x, h_prev, c_prev):
        h = self.h
        def gate(W,U,b,x,prev,act=_sigmoid):
            z=b[:]
            for j in range(h):
                for i in range(len(x)): z[j]+=W[j][i]*x[i]
                for i in range(h): z[j]+=U[j][i]*prev[i]
                z[j]=act(z[j])
            return z
        f=gate(self.Wf,self.Uf,self.bf,x,h_prev)
        i=gate(self.Wi,self.Ui,self.bi,x,h_prev)
        ch=gate(self.Wc,self.Uc,self.bc,x,h_prev,math.tanh)
        cn=[f[j]*c_prev[j]+i[j]*ch[j] for j in range(h)]
        o=gate(self.Wo,self.Uo,self.bo,x,h_prev)
        hn=[o[j]*math.tanh(cn[j]) for j in range(h)]
        return hn, cn

    def forward_seq(self, sequence):
        h=[0.0]*self.h; c=[0.0]*self.h
        for x in sequence: h,c=self.forward(x,h,c)
        return h,c


class TransformerAttention:
    def __init__(self, d_model, num_heads):
        self.d_model=d_model; self.d_k=d_model//num_heads
        sc=math.sqrt(self.d_k)
        self.Wq=[[random.gauss(0,sc) for _ in range(d_model)] for _ in range(d_model)]
        self.Wk=[[random.gauss(0,sc) for _ in range(d_model)] for _ in range(d_model)]
        self.Wv=[[random.gauss(0,sc) for _ in range(d_model)] for _ in range(d_model)]
        self.Wo=[[random.gauss(0,sc) for _ in range(d_model)] for _ in range(d_model)]

    def self_attention(self, x):
        def mv(M,v): return [sum(M[i][j]*v[j] for j in range(len(v))) for i in range(len(M))]
        q,k,v = mv(self.Wq,x), mv(self.Wk,x), mv(self.Wv,x)
        scores=[q[i]*k[i]/math.sqrt(self.d_k) for i in range(self.d_k)]
        w=_softmax(scores)
        out=[w[i]*v[i] for i in range(self.d_k)]
        return mv(self.Wo, out+[0.0]*(self.d_model-self.d_k))


class TransformerBlock:
    def __init__(self, d_model, num_heads, d_ff):
        self.att=TransformerAttention(d_model,num_heads)
        self.norm1=[1.0]*d_model; self.norm2=[1.0]*d_model
        sc1,sc2=math.sqrt(2.0/d_model),math.sqrt(2.0/d_ff)
        self.ff_w1=[[random.gauss(0,sc1) for _ in range(d_ff)] for _ in range(d_model)]
        self.ff_b1=[0.0]*d_ff
        self.ff_w2=[[random.gauss(0,sc2) for _ in range(d_model)] for _ in range(d_ff)]
        self.ff_b2=[0.0]*d_model

    def forward(self, x):
        a=self.att.self_attention(x); x=[x[i]+a[i] for i in range(len(x))]
        x=[x[i]/(self.norm1[i]+1e-6) for i in range(len(x))]
        fo=[]
        for j in range(len(self.ff_b1)):
            z=self.ff_b1[j]
            for i in range(len(x)): z+=self.ff_w1[i][j]*x[i]
            fo.append(_relu(z))
        res=[]
        for j in range(len(self.ff_b2)):
            z=self.ff_b2[j]
            for i in range(len(fo)): z+=self.ff_w2[i][j]*fo[i]
            res.append(z)
        x=[x[i]+res[i] for i in range(len(x))]
        return [x[i]/(self.norm2[i]+1e-6) for i in range(len(x))]


class SentimentAnalyzer:
    POS={'good','great','excellent','amazing','wonderful','fantastic','happy','love','best','awesome','beautiful','perfect','brilliant','outstanding','superb','magnificent','delightful','pleasant','joy','success','win','positive','nice','like','yes','true'}
