class Vector2:
    def __init__(self,x=0,y=0): self.x=x; self.y=y
    def __add__(self,o): return Vector2(self.x+o.x,self.y+o.y)
    def __sub__(self,o): return Vector2(self.x-o.x,self.y-o.y)
    def __mul__(self,s): return Vector2(self.x*s,self.y*s)
    def __truediv__(self,s): return Vector2(self.x/s,self.y/s) if s else Vector2(0,0)
    def __eq__(self,o): return self.x==o.x and self.y==o.y
    def length(self): return math.sqrt(self.x**2+self.y**2)
    def normalize(self):
        l=self.length()
        return Vector2(self.x/l,self.y/l) if l>0 else Vector2(0,0)
    def dot(self,o): return self.x*o.x+self.y*o.y
    def distance(self,o): return (self-o).length()
    def lerp(self,o,t): return Vector2(self.x+(o.x-self.x)*t,self.y+(o.y-self.y)*t)
    def angle(self): return math.atan2(self.y,self.x)
    def rotate(self,angle):
        c,s=math.cos(angle),math.sin(angle)
        return Vector2(self.x*c-self.y*s,self.x*s+self.y*c)
    def copy(self): return Vector2(self.x,self.y)
    def __repr__(self): return f"V({self.x:.1f},{self.y:.1f})"

    @staticmethod
    def from_angle(a,l=1): return Vector2(math.cos(a)*l,math.sin(a)*l)


class Rect:
    def __init__(self,x,y,w,h): self.x=x; self.y=y; self.w=w; self.h=h
    @property
    def left(self): return self.x
    @property
    def right(self): return self.x+self.w
    @property
    def top(self): return self.y
    @property
    def bottom(self): return self.y+self.h
    @property
    def center(self): return Vector2(self.x+self.w/2,self.y+self.h/2)
    @property
    def size(self): return Vector2(self.w,self.h)
    def contains(self,pt): return self.x<=pt.x<=self.right and self.y<=pt.y<=self.bottom
    def intersects(self,other):
        return not(self.right<other.x or self.x>other.right or self.bottom<other.y or self.y>other.bottom)
    def to_tuple(self): return (self.x,self.y,self.w,self.h)


class Color4:
    def __init__(self,r=255,g=255,b=255,a=255): self.r=r; self.g=g; self.b=b; self.a=a
    def to_tuple(self): return (self.r,self.g,self.b,self.a)
    def lerp(self,o,t):
        return Color4(int(self.r+(o.r-self.r)*t),int(self.g+(o.g-self.g)*t),int(self.b+(o.b-self.b)*t),int(self.a+(o.a-self.a)*t))
    @staticmethod
    def red(): return Color4(255,0,0)
    @staticmethod
    def green(): return Color4(0,255,0)
    @staticmethod
    def blue(): return Color4(0,0,255)
    @staticmethod
    def white(): return Color4(255,255,255)
    @staticmethod
    def black(): return Color4(0,0,0)
    @staticmethod
    def yellow(): return Color4(255,255,0)
    @staticmethod
    def cyan(): return Color4(0,255,255)
    @staticmethod
    def magenta(): return Color4(255,0,255)


class Component(ABC):
    def __init__(self): self.entity=None
    @abstractmethod
    def update(self,dt): pass
    @abstractmethod
    def render(self,canvas): pass

class TransformComponent(Component):
    def __init__(self,pos=None,rotation=0,scale=1):
        super().__init__(); self.position=pos or Vector2(); self.rotation=rotation; self.scale=scale
        self.velocity=Vector2(); self.acceleration=Vector2()
        self.friction=0.98; self.max_speed=500
    def update(self,dt):
        self.velocity=self.velocity+self.acceleration*dt
        self.velocity=self.velocity*self.friction
        if self.velocity.length()>self.max_speed:
            self.velocity=self.velocity.normalize()*self.max_speed
        self.position=self.position+self.velocity*dt
    def render(self,canvas): pass

class SpriteComponent(Component):
    def __init__(self,sprite=None,color=None):
        super().__init__(); self.sprite=sprite; self.color=color or Color4.white()
        self.visible=True; self.alpha=1.0; self.flip_x=False; self.flip_y=False
    def update(self,dt): pass
    def render(self,canvas):
        if not self.visible or not self.sprite: return
        t=self.entity.transform if self.entity else None
        if t:
            x,y=int(t.position.x),int(t.position.y)
            if self.sprite:
                self.sprite.render(canvas,x,y)

class ColliderComponent(Component):
    def __init__(self,rect=None,trigger=False):
        super().__init__(); self.rect=rect; self.trigger=trigger
        self.collisions=[]; self.is_static=False; self.layer=0
    def update(self,dt): pass
    def render(self,canvas): pass
    def get_rect(self):
        if self.rect: return self.rect
        if self.entity and hasattr(self.entity,'transform'):
            t=self.entity.transform
            return Rect(t.position.x,t.position.y,32,32)
        return Rect(0,0,32,32)

class HealthComponent(Component):
    def __init__(self,max_hp=100):
        super().__init__(); self.max_hp=max_hp; self.hp=max_hp
        self.invulnerable=False; self.invuln_timer=0; self.invuln_duration=1.0
        self.on_hit=None; self.on_death=None; self.dead=False
    def update(self,dt):
        if self.invuln_timer>0:
            self.invuln_timer-=dt
            if self.invuln_timer<=0: self.invulnerable=False
    def render(self,canvas): pass
    def take_damage(self,amount):
        if self.invulnerable or self.dead: return False
        self.hp=max(0,self.hp-amount)
        self.invulnerable=True; self.invuln_timer=self.invuln_duration
        if self.on_hit: self.on_hit(self.hp,amount)
        if self.hp<=0:
            self.dead=True
            if self.on_death: self.on_death()
        return True

class AIAgentComponent(Component):
    def __init__(self,agent_type='patrol'):
        super().__init__()
        self.agent_type=agent_type; self.speed=100
        self.patrol_points=[]; self.current_patrol=0
        self.target=None; self.detection_range=200
        self.attack_range=50; self.attack_cooldown=1.0
        self.attack_timer=0; self.state='idle'
    def update(self,dt):
        t=self.entity.transform if self.entity else None
        if not t: return
        self.attack_timer=max(0,self.attack_timer-dt)
        if self.agent_type=='patrol' and self.patrol_points:
            target=self.patrol_points[self.current_patrol]
            diff=target-t.position
            if diff.length()<5:
                self.current_patrol=(self.current_patrol+1)%len(self.patrol_points)
            else:
                t.velocity=diff.normalize()*self.speed
        elif self.agent_type=='chase' and self.target:
            diff=self.target-t.position
            if diff.length()<self.attack_range:
                self.state='attack'; self.do_attack()
            elif diff.length()<self.detection_range:
                self.state='chase'; t.velocity=diff.normalize()*self.speed
            else:
                self.state='idle'; t.velocity=Vector2()
    def do_attack(self):
        if self.attack_timer<=0:
            self.attack_timer=self.attack_cooldown
            return True
        return False
    def render(self,canvas): pass

class ParticleComponent(Component):
    def __init__(self,max_particles=100):
        super().__init__(); self.particles=[]; self.max_particles=max_particles
    def update(self,dt):
        self.particles=[p for p in self.particles if p['life']>0]
        for p in self.particles:
            p['life']-=dt; p['x']+=p['vx']*dt; p['y']+=p['vy']*dt
            p['vy']+=p.get('gravity',0)*dt
    def render(self,canvas):
        for p in self.particles:
            if p['life']>0:
                a=max(0,min(255,int(p['life']/p['max_life']*255)))
                c=Color4(p['r'],p['g'],p['b'],a)
                x,y=int(p['x']),int(p['y'])
                canvas.set_pixel(x,y,c.to_tuple())
    def emit(self,x,y,color=None,count=10,spread=2.0,life=1.0,gravity=200):
        c=color or Color4(255,200,50)
        for _ in range(min(count,self.max_particles-len(self.particles))):
            angle=random.uniform(0,math.tau); speed=random.uniform(50,200)*spread
            self.particles.append({
                'x':x,'y':y,'vx':math.cos(angle)*speed,'vy':math.sin(angle)*speed,
                'r':c.r,'g':c.g,'b':c.b,'life':life*random.uniform(0.5,1),'max_life':life,'gravity':gravity
            })

class AnimationComponent(Component):
    def __init__(self):
        super().__init__(); self.animations={}; self.current=None
        self.frame=0; self.timer=0; self.speed=1.0; self.loop=True; self.finished=False
    def add(self,name,frames,fps=10):
        self.animations[name]={'frames':frames,'fps':fps}
    def play(self,name,reset=True):
        if self.current!=name or reset: self.current=name; self.frame=0; self.timer=0; self.finished=False
    def update(self,dt):
        if not self.current or self.finished: return
        anim=self.animations[self.current]; self.timer+=dt
        frame_dur=1.0/(anim['fps']*self.speed)
        if self.timer>=frame_dur:
            self.timer-=frame_dur; self.frame+=1
            if self.frame>=len(anim['frames']):
                if self.loop: self.frame=0
                else: self.frame=len(anim['frames'])-1; self.finished=True
    def get_frame(self):
        if self.current and self.current in self.animations:
            return self.animations[self.current]['frames'][self.frame]
        return None
    def render(self,canvas): pass


class Entity:
    _next_id=0
    def __init__(self,name=""):
        self.id=Entity._next_id; Entity._next_id+=1
        self.name=name; self.active=True; self.tag=""
        self.components={}; self.children=[]; self.parent=None
        self.transform=TransformComponent(); self.add(self.transform)
        self._sorted_components=[]

    def add(self, component):
        component.entity=self
        self.components[type(component).__name__]=component
        self._sorted_components=sorted(self.components.values(),key=lambda c: isinstance(c,(AnimationComponent,ParticleComponent)))
        return self

    def get(self, comp_type):
        return self.components.get(comp_type.__name__)

    def remove(self, comp_type):
        if comp_type.__name__ in self.components:
            del self.components[comp_type.__name__]

    def has(self, comp_type):
        return comp_type.__name__ in self.components

    def update(self, dt):
        for comp in self._sorted_components:
            if self.active: comp.update(dt)

    def render(self, canvas):
        for comp in self._sorted_components:
            if self.active: comp.render(canvas)

    def distance_to(self, other):
        return self.transform.position.distance(other.transform.position)


class Camera:
    def __init__(self):
        self.position=Vector2(); self.target=None; self.smoothing=0.1
        self.zoom=1.0; self.screen_w=80; self.screen_h=24
        self.shake_amount=0; self.shake_timer=0

    def update(self, dt):
        if self.target:
            diff=self.target.transform.position-self.position
            self.position=self.position+diff*self.smoothing
        if self.shake_timer>0:
            self.shake_timer-=dt

    def world_to_screen(self, pos):
        dx=pos.x-self.position.x+self.screen_w/2
        dy=pos.y-self.position.y+self.screen_h/2
        if self.shake_timer>0:
            dx+=random.uniform(-self.shake_amount,self.shake_amount)
            dy+=random.uniform(-self.shake_amount,self.shake_amount)
        return int(dx),int(dy)

    def screen_to_world(self, pos):
        return Vector2(pos[0]+self.position.x-self.screen_w/2, pos[1]+self.position.y-self.screen_h/2)

    def shake(self, amount=2.0, duration=0.3):
        self.shake_amount=amount; self.shake_timer=duration

    def is_visible(self, rect, margin=5):
        sx,sy=self.world_to_screen(rect.center)
        return -margin<sx<self.screen_w+margin and -margin<sy<self.screen_h+margin


class InputManager:
    def __init__(self):
        self.keys=set(); self.pressed=set(); self.released=set()
        self.mouse_pos=Vector2(); self.mouse_pressed=set(); self.mouse_released=set()
        self._prev_keys=set()

    def update(self):
        self.pressed=self.keys-self._prev_keys
        self.released=self._prev_keys-self.keys
        self._prev_keys=self.keys.copy()

    def is_key_down(self,k): return k in self.keys
    def is_key_pressed(self,k): return k in self.pressed
    def is_key_released(self,k): return k in self.released
    def is_mouse_down(self,b=0): return b in self.mouse_pressed
    def is_mouse_pressed(self,b=0): return b in self.mouse_pressed


