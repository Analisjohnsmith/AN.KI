    def analyze(self, text):
        words=text.lower().split()
        pos=sum(1 for w in words if w in self.POS)
        neg=sum(1 for w in words if w in self.NEG)
        total=max(1,len(words)); compound=(pos-neg)/max(1,pos+neg)
        return {'positive':max(0,compound),'negative':max(0,-compound),'neutral':1-abs(compound),'confidence':abs(compound)}


