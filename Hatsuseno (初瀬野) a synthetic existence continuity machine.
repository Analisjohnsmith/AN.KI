class Canvas2D:
    def __init__(self, w, h):
        self.width=w; self.height=h
        self.pixels=[[(0,0,0,255) for _ in range(w)] for _ in range(h)]

    def clear(self, c=None):
        c=c or (0,0,0,255)
        for y in range(self.height):
            for x in range(self.width): self.pixels[y][x]=c

    def set_pixel(self,x,y,c):
        if 0<=x<self.width and 0<=y<self.height: self.pixels[y][x]=c

    def get_pixel(self,x,y):
        return self.pixels[y][x] if 0<=x<self.width and 0<=y<self.height else (0,0,0,0)

    def draw_line(self,x0,y0,x1,y1,c=(255,255,255,255)):
        dx,dy=abs(x1-x0),-abs(y1-y0); sx=1 if x0<x1 else -1; sy=1 if y0<y1 else -1; err=dx+dy
        while True:
            self.set_pixel(x0,y0,c)
            if x0==x1 and y0==y1: break
            e2=2*err
            if e2>=dy: err+=dy; x0+=sx
            if e2<=dx: err+=dx; y0+=sy

    def draw_rect(self,x,y,w,h,c=(255,255,255,255),filled=False):
        if filled:
            for py in range(y,y+h):
                for px in range(x,x+w): self.set_pixel(px,py,c)
        else:
            for px in range(x,x+w): self.set_pixel(px,y,c); self.set_pixel(px,y+h-1,c)
            for py in range(y,y+h): self.set_pixel(x,py,c); self.set_pixel(x+w-1,py,c)

    def draw_circle(self,cx,cy,r,c=(255,255,255,255),filled=False):
        for y in range(cy-r,cy+r+1):
            for x in range(cx-r,cx+r+1):
                d=math.sqrt((x-cx)**2+(y-cy)**2)
                if filled and d<=r: self.set_pixel(x,y,c)
                elif abs(d-r)<0.5: self.set_pixel(x,y,c)

    def draw_ellipse(self,cx,cy,rx,ry,c=(255,255,255,255)):
        for a in range(360):
            rad=math.radians(a)
            self.set_pixel(int(cx+rx*math.cos(rad)),int(cy+ry*math.sin(rad)),c)

    def fill_gradient_v(self,y0,y1,ct,cb):
        for y in range(y0,y1):
            t=(y-y0)/max(1,y1-y0-1)
            c=tuple(int(ct[i]+(cb[i]-ct[i])*t) for i in range(3))+(255,)
            for x in range(self.width): self.set_pixel(x,y,c)

    def fill_gradient_h(self,x0,x1,cl,cr):
        for x in range(x0,x1):
            t=(x-x0)/max(1,x1-x0-1)
            c=tuple(int(cl[i]+(cr[i]-cl[i])*t) for i in range(3))+(255,)
            for y in range(self.height): self.set_pixel(x,y,c)

    def render_mandelbrot(self,x0=-2.0,y0=-1.5,x1=1.0,y1=1.5,mx=100):
        for y in range(self.height):
            for x in range(self.width):
                cx=x0+(x/self.width)*(x1-x0); cy=y0+(y/self.height)*(y1-y0)
                it=DaoMath.mandelbrot(cx,cy,mx)
                if it==mx: self.set_pixel(x,y,(0,0,0,255))
                else:
                    h=it/mx; r,g,b=[int(v*255) for v in colorsys.hsv_to_rgb(h,1.0,1.0)]
                    self.set_pixel(x,y,(r,g,b,255))

    def render_julia(self,cx=-0.7,cy=0.27015,x0=-2.0,y0=-2.0,x1=2.0,y1=2.0,mx=100):
        for y in range(self.height):
            for x in range(self.width):
                zx=x0+(x/self.width)*(x1-x0); zy=y0+(y/self.height)*(y1-y0)
                it=DaoMath.julia(zx,zy,cx,cy,mx)
                if it==mx: self.set_pixel(x,y,(0,0,0,255))
                else:
                    h=it/mx; r,g,b=[int(v*255) for v in colorsys.hsv_to_rgb(h,1.0,1.0)]
                    self.set_pixel(x,y,(r,g,b,255))

    def render_plasma(self,t=0):
        for y in range(self.height):
            for x in range(self.width):
                v1=math.sin(x*0.05+t); v2=math.sin(y*0.05+t)
                v3=math.sin((x+y)*0.05+t)
                v4=math.sin(math.sqrt((x-self.width/2)**2+(y-self.height/2)**2)*0.05+t)
                v=(v1+v2+v3+v4)/4
                r=int((math.sin(v*math.pi)+1)/2*255)
                g=int((math.sin(v*math.pi+2.094)+1)/2*255)
                b=int((math.sin(v*math.pi+4.189)+1)/2*255)
                self.set_pixel(x,y,(r,g,b,255))

    def render_fractal_tree(self,x,y,angle,length,depth,c=(100,200,50,255)):
        if depth<=0 or length<2: return
        x2=int(x+length*math.cos(angle)); y2=int(y-length*math.sin(angle))
        f=depth/10; self.draw_line(x,y,x2,y2,(int(c[0]*f),int(c[1]*f),int(c[2]*f),255))
        self.render_fractal_tree(x2,y2,angle+0.4,length*0.7,depth-1,c)
        self.render_fractal_tree(x2,y2,angle-0.4,length*0.7,depth-1,c)

    def render_perlin_terrain(self,scale=0.05,seed=42):
        for y in range(self.height):
            for x in range(self.width):
                v=DaoMath.fractal_noise(x*scale,y*scale,6,0.5,seed); v=(v+1)/2
                if v<0.3: c=(0,0,int(v/0.3*100)+155,255)
                elif v<0.5: c=(34,139,34,255)
                elif v<0.7: c=(139,119,42,255)
                elif v<0.9: c=(128,128,128,255)
                else: c=(255,255,255,255)
                self.set_pixel(x,y,c)

    def to_terminal(self):
        lines=[]
        for y in range(0,self.height,2):
            line=[]
            for x in range(self.width):
                r1,g1,b1,_=self.get_pixel(x,y)
                r2,g2,b2,_=self.get_pixel(x,min(y+1,self.height-1))
                line.append(f"{TermColor.rgb(r1,g1,b1)}▄{TermColor.rgb(r2,g2,b2)}▀{TermColor.RESET}")
            lines.append(''.join(line))
        return '\n'.join(lines)

    def save_bmp(self, filepath):
        row_size=(self.width*3+3)&~3; pds=row_size*self.height
        with open(filepath,'wb') as f:
            f.write(b'BM')
            f.write(struct.pack('<I',54+pds)); f.write(struct.pack('<I',0)); f.write(struct.pack('<I',54))
            f.write(struct.pack('<I',40)); f.write(struct.pack('<i',self.width)); f.write(struct.pack('<i',-self.height))
            f.write(struct.pack('<HHIIIIII',1,24,0,pds,0,0,0,0))
            for y in range(self.height):
                for x in range(self.width):
                    r,g,b,_=self.pixels[y][x]; f.write(struct.pack('BBB',b,g,r))
                f.write(b'\x00'*(row_size-self.width*3))


