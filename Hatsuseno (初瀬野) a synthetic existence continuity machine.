    def matrix_add(a, b): return [[a[i][j]+b[i][j] for j in range(len(a[0]))] for i in range(len(a))]

    @staticmethod
    def matrix_scale(a, s): return [[c*s for c in row] for row in a]

    @staticmethod
    def eigen_2x2(m):
        a,b,c,d = m[0][0],m[0][1],m[1][0],m[1][1]
        t, det = a+d, a*d-b*c
        disc = math.sqrt(max(0, t*t-4*det))
        return (t+disc)/2, (t-disc)/2

    @staticmethod
    def fft(signal):
        n = len(signal)
        if n <= 1: return signal
        if n & (n-1) != 0:
            p2 = 1
            while p2 < n: p2 <<= 1
            signal = signal + [0j]*(p2-n); n = p2
        even, odd = DaoMath.fft(signal[0::2]), DaoMath.fft(signal[1::2])
        result = [0j]*n
        for k in range(n//2):
            t = complex(math.cos(math.tau*k/n), math.sin(math.tau*k/n)) * odd[k]
            result[k], result[k+n//2] = even[k]+t, even[k]-t
        return result

    @staticmethod
    def ifft(spectrum):
        n = len(spectrum)
        return [z/n for z in DaoMath.fft([z.conjugate() for z in spectrum])]

    @staticmethod
    def prime_sieve(limit):
        sp = [True]*(limit+1); sp[0]=sp[1]=False
        for i in range(2, int(limit**0.5)+1):
            if sp[i]:
                for j in range(i*i, limit+1, i): sp[j]=False
        return [i for i in range(limit+1) if sp[i]]

    @staticmethod
    def continued_fraction(x, mx=20):
        terms = []
        for _ in range(mx):
            a = int(x); terms.append(a); frac = x-a
            if abs(frac)<1e-10: break
            x = 1.0/frac
        return terms

    @staticmethod
    def mod_exp(base, exp, mod):
        result = 1; base %= mod
        while exp > 0:
            if exp & 1: result = (result*base)%mod
            exp >>= 1; base = (base*base)%mod
        return result

    @staticmethod
    def gcd(a, b):
        while b: a, b = b, a%b
        return abs(a)

    @staticmethod
    def extended_gcd(a, b):
        if a == 0: return b, 0, 1
        g, x, y = DaoMath.extended_gcd(b%a, a)
        return g, y-(b//a)*x, x

    @staticmethod
    def fibonacci(n):
        if n<=1: return n
        a,b=0,1
        for _ in range(2,n+1): a,b=b,a+b
        return b

    @staticmethod
    def mandelbrot(cx, cy, mx=100):
        zx,zy=0.0,0.0
        for i in range(mx):
            zx,zy = zx*zx-zy*zy+cx, 2*zx*zy+cy
            if zx*zx+zy*zy>4: return i
        return mx

    @staticmethod
    def julia(zx, zy, cx, cy, mx=100):
        for i in range(mx):
            zx,zy = zx*zx-zy*zy+cx, 2*zx*zy+cy
            if zx*zx+zy*zy>4: return i
        return mx

    @staticmethod
    def noise2d(x, y, seed=0):
        def fade(t): return t*t*t*(t*(t*6-15)+10)
        def grad(h,x,y):
            h&=3
            return (x+y if h==0 else -x+y if h==1 else x-y if h==2 else -x-y)
        xi,yi = int(math.floor(x))&255, int(math.floor(y))&255
        xf,yf = x-math.floor(x), y-math.floor(y)
        u,v = fade(xf), fade(yf)
        p = list(range(256)); rng = random.Random(seed); rng.shuffle(p); p = p+p
        aa,ab = p[p[xi]+yi], p[p[xi]+yi+1]
        ba,bb = p[p[xi+1]+yi], p[p[xi+1]+yi+1]
        def lerp(a,b,t): return a+t*(b-a)
        return lerp(lerp(grad(aa,xf,yf),grad(ba,xf-1,yf),u),lerp(grad(ab,xf,yf-1),grad(bb,xf-1,yf-1),u),v)

    @staticmethod
    def fractal_noise(x, y, octaves=6, persistence=0.5, seed=0):
        total=0.0; freq=1.0; amp=1.0; mx=0.0
        for i in range(octaves):
            total += DaoMath.noise2d(x*freq,y*freq,seed+i*1000)*amp
            mx+=amp; amp*=persistence; freq*=2.0
        return total/mx


