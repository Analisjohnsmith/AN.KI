    print(f"  - InputManager, EventSystem, Timer")
    print(f"  - ResourceManager, SceneManager")
    print(f"  - Canvas2D rendering to terminal")
    print(f"\n  {TermColor.YELLOW}Run engine.run() to start the game!{TermColor.RESET}")


