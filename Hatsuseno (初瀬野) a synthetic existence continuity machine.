class MPLCompiler:
    def compile(self, src: str) -> Dict[int, List[Tuple[int, float]]]:
        program: Dict[int, List[Tuple[int, float]]] = {}
        current_ring: Optional[int] = None
        for line in src.splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            if line.startswith("ring"):
                _, num = line.split()
                current_ring = int(num.strip(":"))
                program[current_ring] = []
                continue
            parts = line.split()
            op = parts[0].upper()
            arg = float(parts[1]) if len(parts) > 1 else 0.0
            if op not in OP:
                raise ValueError(f"Unknown opcode: {op}")
            program[current_ring].append((OP[op], arg))
        return program


class MPLLoader:
    def load(self, cpu: MandalaCPU,
             program: Dict[int, List[Tuple[int, float]]]):
        for r, instructions in program.items():
            cells = cpu.rings[r]
            for i, (opcode, arg) in enumerate(instructions):
                if i >= len(cells):
                    raise ValueError(
                        f"Too many instructions for ring {r}"
                    )
                cells[i].opcode = opcode
                cells[i].arg = arg


class MPLVM:
    def __init__(self, cpu: MandalaCPU):
        self.cpu = cpu

    def run(self, ticks: int = 1):
        for _ in range(ticks):
            self.cpu.tick()


