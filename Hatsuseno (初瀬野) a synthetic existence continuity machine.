# ============================================================


def environmental_scalar(n: int, t: float, mu: float = 1.0,
                          lam: float = 0.1, gamma: float = 0.05,
                          Phi: float = 0.0) -> float:
    """E(n,t) = mu * (1 + lam*Phi(t)) * e^{-gamma*n}"""
    return mu * (1.0 + lam * Phi) * math.exp(-gamma * n)


