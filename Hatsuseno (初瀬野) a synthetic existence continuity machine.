        if ch=='\n': self.line+=1; self.col=1
        else: self.col+=1
        return ch

    def skip_ws(self):
        while self.pos<len(self.src) and self.src[self.pos] in ' \t\n\r': self.advance()

    def skip_comment(self):
        if self.pos+1<len(self.src):
            if self.src[self.pos:self.pos+2]=='//':
                while self.pos<len(self.src) and self.src[self.pos]!='\n': self.advance()
                return True
            elif self.src[self.pos:self.pos+2]=='/*':
                self.advance(); self.advance()
                while self.pos+1<len(self.src):
                    if self.src[self.pos:self.pos+2]=='*/': self.advance(); self.advance(); return True
                    self.advance()
        return False

    def read_number(self):
        s,l,c=self.pos,self.line,self.col; hd=False
        while self.pos<len(self.src) and (self.src[self.pos].isdigit() or self.src[self.pos]=='.'):
            if self.src[self.pos]=='.':
                if hd: break
                hd=True
            self.advance()
        v=float(self.src[s:self.pos]) if hd else int(self.src[s:self.pos])
        return DToken(DTokenType.NUMBER,v,l,c)

    def read_string(self):
        l,c=self.line,self.col; q=self.advance(); r=[]
        while self.pos<len(self.src) and self.src[self.pos]!=q:
            if self.src[self.pos]=='\\':
                self.advance()
                if self.pos<len(self.src):
                    e=self.advance(); esc={'n':'\n','t':'\t','\\':'\\',q:q}; r.append(esc.get(e,e))
            else: r.append(self.advance())
        if self.pos<len(self.src): self.advance()
        return DToken(DTokenType.STRING,''.join(r),l,c)

    def read_ident(self):
        s,l,c=self.pos,self.line,self.col
        while self.pos<len(self.src) and (self.src[self.pos].isalnum() or self.src[self.pos]=='_'): self.advance()
        w=self.src[s:self.pos]; tt=self.KW.get(w,DTokenType.IDENT)
        return DToken(tt,w,l,c)

    def tokenize(self):
        tokens=[]
        while self.pos<len(self.src):
            self.skip_ws()
            if self.pos>=len(self.src): break
            if self.skip_comment(): continue
            ch=self.peek()
            if ch is None: break
            if ch.isdigit(): tokens.append(self.read_number())
            elif ch in '"\'': tokens.append(self.read_string())
            elif ch.isalpha() or ch=='_': tokens.append(self.read_ident())
            elif ch=='+': tokens.append(DToken(DTokenType.PLUS,'+',self.line,self.col)); self.advance()
            elif ch=='-': tokens.append(DToken(DTokenType.MINUS,'-',self.line,self.col)); self.advance()
            elif ch=='*': tokens.append(DToken(DTokenType.STAR,'*',self.line,self.col)); self.advance()
            elif ch=='/': tokens.append(DToken(DTokenType.SLASH,'/',self.line,self.col)); self.advance()
            elif ch=='%': tokens.append(DToken(DTokenType.PERCENT,'%',self.line,self.col)); self.advance()
            elif ch=='^': tokens.append(DToken(DTokenType.CARET,'^',self.line,self.col)); self.advance()
            elif ch=='=':
                self.advance()
                if self.peek()=='=': self.advance(); tokens.append(DToken(DTokenType.EQ,'==',self.line,self.col))
                else: tokens.append(DToken(DTokenType.ASSIGN,'=',self.line,self.col))
            elif ch=='!':
                self.advance()
                if self.peek()=='=': self.advance(); tokens.append(DToken(DTokenType.NEQ,'!=',self.line,self.col))
                else: tokens.append(DToken(DTokenType.NOT,'!',self.line,self.col))
            elif ch=='<':
                self.advance()
                if self.peek()=='=': self.advance(); tokens.append(DToken(DTokenType.LTE,'<=',self.line,self.col))
                else: tokens.append(DToken(DTokenType.LT,'<',self.line,self.col))
            elif ch=='>':
                self.advance()
                if self.peek()=='=': self.advance(); tokens.append(DToken(DTokenType.GTE,'>=',self.line,self.col))
                else: tokens.append(DToken(DTokenType.GT,'>',self.line,self.col))
            elif ch=='(': tokens.append(DToken(DTokenType.LPAREN,'(',self.line,self.col)); self.advance()
            elif ch==')': tokens.append(DToken(DTokenType.RPAREN,')',self.line,self.col)); self.advance()
            elif ch=='[': tokens.append(DToken(DTokenType.LBRACKET,'[',self.line,self.col)); self.advance()
            elif ch==']': tokens.append(DToken(DTokenType.RBRACKET,']',self.line,self.col)); self.advance()
            elif ch=='{': tokens.append(DToken(DTokenType.LBRACE,'{',self.line,self.col)); self.advance()
            elif ch=='}': tokens.append(DToken(DTokenType.RBRACE,'}',self.line,self.col)); self.advance()
            elif ch==',': tokens.append(DToken(DTokenType.COMMA,',',self.line,self.col)); self.advance()
            elif ch==';': tokens.append(DToken(DTokenType.SEMICOLON,';',self.line,self.col)); self.advance()
            elif ch==':': tokens.append(DToken(DTokenType.COLON,':',self.line,self.col)); self.advance()
            elif ch=='.': tokens.append(DToken(DTokenType.DOT,'.',self.line,self.col)); self.advance()
            else: raise SyntaxError(f"Unexpected '{ch}' at line {self.line}:{self.col}")
        tokens.append(DToken(DTokenType.EOF,None,self.line,self.col))
        return tokens


class DASTNode(ABC): pass
class DNumberLit(DASTNode):
    def __init__(self,v): self.value=v
class DStringLit(DASTNode):
    def __init__(self,v): self.value=v
class DBoolLit(DASTNode):
    def __init__(self,v): self.value=v
class DNilLit(DASTNode): pass
class DIdent(DASTNode):
    def __init__(self,n): self.name=n
class DBinOp(DASTNode):
    def __init__(self,l,op,r): self.left=l; self.op=op; self.right=r
class DUnaryOp(DASTNode):
    def __init__(self,op,operand): self.op=op; self.operand=operand
class DAssign(DASTNode):
    def __init__(self,n,v): self.name=n; self.value=v
class DIndexAccess(DASTNode):
    def __init__(self,obj,idx): self.obj=obj; self.index=idx
class DIndexAssign(DASTNode):
    def __init__(self,obj,idx,v): self.obj=obj; self.index=idx; self.value=v
class DFuncDef(DASTNode):
    def __init__(self,name,params,body): self.name=name; self.params=params; self.body=body
class DLambdaDef(DASTNode):
    def __init__(self,params,body): self.params=params; self.body=body
class DFuncCall(DASTNode):
    def __init__(self,cal,args): self.callee=cal; self.args=args
class DIfStmt(DASTNode):
    def __init__(self,cond,tb,eb=None): self.condition=cond; self.then_body=tb; self.else_body=eb
class DWhileLoop(DASTNode):
    def __init__(self,cond,body): self.condition=cond; self.body=body
class DForLoop(DASTNode):
    def __init__(self,var,start,end,body,step=None): self.var=var; self.start=start; self.end=end; self.body=body; self.step=step
class DLoopStmt(DASTNode):
    def __init__(self,body): self.body=body
class DReturnStmt(DASTNode):
    def __init__(self,v=None): self.value=v
class DBreakStmt(DASTNode): pass
class DContinueStmt(DASTNode): pass
class DPrintStmt(DASTNode):
    def __init__(self,args): self.args=args
class DArrayLit(DASTNode):
    def __init__(self,elems): self.elements=elems
class DMapLit(DASTNode):
    def __init__(self,pairs): self.pairs=pairs
class DPropAccess(DASTNode):
    def __init__(self,obj,prop): self.obj=obj; self.prop=prop
class DBlockExpr(DASTNode):
    def __init__(self,stmts): self.stmts=stmts


class DParser:
    def __init__(self,tokens): self.tokens=tokens; self.pos=0
    def peek(self): return self.tokens[self.pos] if self.pos<len(self.tokens) else DToken(DTokenType.EOF,None)
    def advance(self): t=self.tokens[self.pos]; self.pos+=1; return t
    def expect(self,tt):
        t=self.peek()
        if t.type!=tt: raise SyntaxError(f"Expected {tt}, got {t.type} ('{t.value}') at line {t.line}")
        return self.advance()

    def expect_stmt_end(self):
        if self.peek().type==DTokenType.SEMICOLON: self.advance()

    def parse(self):
        stmts=[]
        while self.peek().type!=DTokenType.EOF: stmts.append(self.parse_stmt())
        return stmts

    def parse_stmt(self):
        t=self.peek()
        if t.type==DTokenType.LET: return self.parse_let()
        if t.type==DTokenType.CONST: return self.parse_let()
        if t.type==DTokenType.FUNCTION: return self.parse_func_def()
        if t.type==DTokenType.IF: return self.parse_if()
        if t.type==DTokenType.WHILE: return self.parse_while()
        if t.type==DTokenType.FOR: return self.parse_for()
        if t.type==DTokenType.LOOP: return self.parse_loop()
        if t.type==DTokenType.RETURN: return self.parse_return()
        if t.type==DTokenType.BREAK: self.advance(); return DBreakStmt()
        if t.type==DTokenType.CONTINUE: self.advance(); return DContinueStmt()
        if t.type==DTokenType.PRINT: return self.parse_print()
        if t.type==DTokenType.SEMICOLON: self.advance(); return self.parse_stmt()
        return self.parse_expr_stmt()

    def parse_let(self):
        self.advance(); n=self.expect(DTokenType.IDENT).value
        self.expect(DTokenType.ASSIGN); v=self.parse_expr()
        self.expect_stmt_end(); return DAssign(n,v)

    def parse_func_def(self):
        self.advance(); n=self.expect(DTokenType.IDENT).value
        self.expect(DTokenType.LPAREN); params=[]
        if self.peek().type!=DTokenType.RPAREN:
            params.append(self.expect(DTokenType.IDENT).value)
            while self.peek().type==DTokenType.COMMA: self.advance(); params.append(self.expect(DTokenType.IDENT).value)
        self.expect(DTokenType.RPAREN); self.expect(DTokenType.LBRACE); body=[]
        while self.peek().type!=DTokenType.RBRACE: body.append(self.parse_stmt())
        self.expect(DTokenType.RBRACE); return DFuncDef(n,params,body)

    def parse_if(self):
        self.advance(); cond=self.parse_expr()
        self.expect(DTokenType.LBRACE); tb=[]
        while self.peek().type!=DTokenType.RBRACE: tb.append(self.parse_stmt())
        self.expect(DTokenType.RBRACE); eb=None
        if self.peek().type==DTokenType.ELSE:
            self.advance()
            if self.peek().type==DTokenType.IF: eb=[self.parse_if()]
            else:
                self.expect(DTokenType.LBRACE); eb=[]
                while self.peek().type!=DTokenType.RBRACE: eb.append(self.parse_stmt())
                self.expect(DTokenType.RBRACE)
        return DIfStmt(cond,tb,eb)

    def parse_while(self):
        self.advance(); cond=self.parse_expr()
        self.expect(DTokenType.LBRACE); body=[]
        while self.peek().type!=DTokenType.RBRACE: body.append(self.parse_stmt())
        self.expect(DTokenType.RBRACE); return DWhileLoop(cond,body)

    def parse_for(self):
        self.advance(); var=self.expect(DTokenType.IDENT).value
        self.expect(DTokenType.ASSIGN); start=self.parse_expr()
        self.expect(DTokenType.COMMA); end=self.parse_expr()
        step=None
        if self.peek().type==DTokenType.COMMA: self.advance(); step=self.parse_expr()
        self.expect(DTokenType.LBRACE); body=[]
        while self.peek().type!=DTokenType.RBRACE: body.append(self.parse_stmt())
        self.expect(DTokenType.RBRACE); return DForLoop(var,start,end,body,step)

    def parse_loop(self):
        self.advance(); self.expect(DTokenType.LBRACE); body=[]
        while self.peek().type!=DTokenType.RBRACE: body.append(self.parse_stmt())
        self.expect(DTokenType.RBRACE); return DLoopStmt(body)

    def parse_return(self):
        self.advance(); v=None
        if self.peek().type!=DTokenType.SEMICOLON: v=self.parse_expr()
        self.expect_stmt_end(); return DReturnStmt(v)

    def parse_print(self):
        self.advance(); args=[]
        if self.peek().type==DTokenType.LPAREN:
            self.advance()
            if self.peek().type!=DTokenType.RPAREN:
                args.append(self.parse_expr())
                while self.peek().type==DTokenType.COMMA:
                    self.advance(); args.append(self.parse_expr())
            self.expect(DTokenType.RPAREN)
        else:
            while self.peek().type!=DTokenType.SEMICOLON:
                args.append(self.parse_expr())
                if self.peek().type==DTokenType.COMMA: self.advance()
        self.expect_stmt_end(); return DPrintStmt(args)

    def parse_expr_stmt(self):
        expr=self.parse_expr()
        if self.peek().type==DTokenType.ASSIGN:
            self.advance(); v=self.parse_expr(); self.expect_stmt_end()
            if isinstance(expr,DIdent): return DAssign(expr.name,v)
            if isinstance(expr,DIndexAccess): return DIndexAssign(expr.obj,expr.index,v)
            if isinstance(expr,DPropAccess): return DAssign(expr.prop,v)
        self.expect_stmt_end(); return expr

    def parse_expr(self): return self.parse_or()
    def parse_or(self):
        l=self.parse_and()
        while self.peek().type==DTokenType.OR: self.advance(); r=self.parse_and(); l=DBinOp(l,'or',r)
        return l
    def parse_and(self):
        l=self.parse_not()
        while self.peek().type==DTokenType.AND: self.advance(); r=self.parse_not(); l=DBinOp(l,'and',r)
        return l
    def parse_not(self):
        if self.peek().type==DTokenType.NOT: self.advance(); return DUnaryOp('not',self.parse_comp())
        return self.parse_comp()
    def parse_comp(self):
        l=self.parse_add()
        while self.peek().type in (DTokenType.EQ,DTokenType.NEQ,DTokenType.LT,DTokenType.GT,DTokenType.LTE,DTokenType.GTE):
            op=self.advance().value; r=self.parse_add(); l=DBinOp(l,op,r)
        return l
    def parse_add(self):
        l=self.parse_mul()
        while self.peek().type in (DTokenType.PLUS,DTokenType.MINUS):
            op=self.advance().value; r=self.parse_mul(); l=DBinOp(l,op,r)
        return l
    def parse_mul(self):
        l=self.parse_pow()
        while self.peek().type in (DTokenType.STAR,DTokenType.SLASH,DTokenType.PERCENT):
            op=self.advance().value; r=self.parse_pow(); l=DBinOp(l,op,r)
        return l
    def parse_pow(self):
        l=self.parse_unary()
        if self.peek().type==DTokenType.CARET: self.advance(); return DBinOp(l,'^',self.parse_pow())
        return l
    def parse_unary(self):
        if self.peek().type==DTokenType.MINUS: self.advance(); return DUnaryOp('-',self.parse_postfix())
        return self.parse_postfix()

    def parse_postfix(self):
        node=self.parse_primary()
        while True:
            if self.peek().type==DTokenType.LPAREN:
                self.advance(); args=[]
                if self.peek().type!=DTokenType.RPAREN:
                    args.append(self.parse_expr())
                    while self.peek().type==DTokenType.COMMA: self.advance(); args.append(self.parse_expr())
                self.expect(DTokenType.RPAREN); node=DFuncCall(node,args)
            elif self.peek().type==DTokenType.LBRACKET:
                self.advance(); idx=self.parse_expr(); self.expect(DTokenType.RBRACKET); node=DIndexAccess(node,idx)
            elif self.peek().type==DTokenType.DOT:
                self.advance(); prop=self.expect(DTokenType.IDENT).value; node=DPropAccess(node,prop)
            else: break
        return node

    def parse_primary(self):
        t=self.peek()
        if t.type==DTokenType.NUMBER: self.advance(); return DNumberLit(t.value)
        if t.type==DTokenType.STRING: self.advance(); return DStringLit(t.value)
        if t.type==DTokenType.TRUE: self.advance(); return DBoolLit(True)
        if t.type==DTokenType.FALSE: self.advance(); return DBoolLit(False)
        if t.type==DTokenType.NIL: self.advance(); return DNilLit()
        if t.type==DTokenType.IDENT: self.advance(); return DIdent(t.value)
        if t.type==DTokenType.LPAREN: self.advance(); e=self.parse_expr(); self.expect(DTokenType.RPAREN); return e
        if t.type==DTokenType.LBRACKET: return self.parse_array()
        if t.type==DTokenType.LBRACE: return self.parse_map()
        if t.type==DTokenType.FUNCTION: return self.parse_lambda()
        raise SyntaxError(f"Unexpected {t.type} ('{t.value}') at line {t.line}")

    def parse_array(self):
        self.advance(); elems=[]
        if self.peek().type!=DTokenType.RBRACKET:
            elems.append(self.parse_expr())
            while self.peek().type==DTokenType.COMMA: self.advance(); elems.append(self.parse_expr())
        self.expect(DTokenType.RBRACKET); return DArrayLit(elems)

    def parse_map(self):
        self.advance(); pairs=[]
        if self.peek().type!=DTokenType.RBRACE:
            k=self.parse_expr(); self.expect(DTokenType.COLON); v=self.parse_expr(); pairs.append((k,v))
            while self.peek().type==DTokenType.COMMA:
                self.advance(); k=self.parse_expr(); self.expect(DTokenType.COLON); v=self.parse_expr(); pairs.append((k,v))
        self.expect(DTokenType.RBRACE); return DMapLit(pairs)

    def parse_lambda(self):
        self.advance(); self.expect(DTokenType.LPAREN); params=[]
        if self.peek().type!=DTokenType.RPAREN:
            params.append(self.expect(DTokenType.IDENT).value)
            while self.peek().type==DTokenType.COMMA: self.advance(); params.append(self.expect(DTokenType.IDENT).value)
        self.expect(DTokenType.RPAREN); self.expect(DTokenType.LBRACE); body=[]
        while self.peek().type!=DTokenType.RBRACE: body.append(self.parse_stmt())
        self.expect(DTokenType.RBRACE)
        return DLambdaDef(params, body[0] if len(body)==1 else DBlockExpr(body))

class DBreakException(Exception): pass
class DContinueException(Exception): pass
class DReturnException(Exception):
    def __init__(self,v=None): self.value=v

class DScriptFunc:
    def __init__(self,params,body,closure): self.params=params; self.body=body; self.closure=closure
class DScriptLambda:
    def __init__(self,params,body,closure): self.params=params; self.body=body; self.closure=closure

class DInterpreter:
    def __init__(self):
        self.globals={}; self.output_buffer=[]
        self.builtins = {
            'len':lambda a: float(len(a[0])) if a else 0.0,
            'str':lambda a: str(a[0]) if a else '',
            'num':lambda a: float(a[0]) if a else 0.0,
            'abs':lambda a: abs(float(a[0])) if a else 0.0,
            'min':lambda a: min(float(x) for x in a),
            'max':lambda a: max(float(x) for x in a),
            'sqrt':lambda a: math.sqrt(float(a[0])) if a else 0.0,
            'sin':lambda a: math.sin(float(a[0])) if a else 0.0,
            'cos':lambda a: math.cos(float(a[0])) if a else 0.0,
            'tan':lambda a: math.tan(float(a[0])) if a else 0.0,
            'log':lambda a: math.log(float(a[0])) if a else 0.0,
            'exp':lambda a: math.exp(float(a[0])) if a else 0.0,
            'floor':lambda a: float(math.floor(float(a[0]))) if a else 0.0,
            'ceil':lambda a: float(math.ceil(float(a[0]))) if a else 0.0,
            'round':lambda a: round(float(a[0]),int(a[1]) if len(a)>1 else 0),
            'range':lambda a: list(range(int(a[0]))) if len(a)==1 else list(range(int(a[0]),int(a[1]))) if len(a)==2 else list(range(int(a[0]),int(a[1]),int(a[2]))),
            'push':lambda a: a[0].append(a[1]) if isinstance(a[0],list) else None,
            'pop':lambda a: a[0].pop() if isinstance(a[0],list) and a[0] else None,
            'type':lambda a: type(a[0]).__name__ if a else 'nil',
            'chr':lambda a: chr(int(a[0])) if a else '',
            'ord':lambda a: float(ord(str(a[0])[0])) if a else 0.0,
            'random':lambda a: random.random() if not a else random.uniform(0,float(a[0])) if len(a)==1 else random.uniform(float(a[0]),float(a[1])),
            'time':lambda a: time.time(),
            'hash':lambda a: hashlib.md5(str(a[0]).encode()).hexdigest() if a else '',
            'keys':lambda a: list(a[0].keys()) if isinstance(a[0],dict) else [],
            'values':lambda a: list(a[0].values()) if isinstance(a[0],dict) else [],
            'sort':lambda a: sorted(a[0]) if a else [],
            'reverse':lambda a: list(reversed(a[0])) if a else [],
            'sum':lambda a: sum(float(x) for x in a[0]) if a and isinstance(a[0],list) else 0.0,
            'split':lambda a: str(a[0]).split(str(a[1])) if len(a)>=2 else str(a[0]).split(),
            'join':lambda a: str(a[1]).join(str(x) for x in a[0]) if len(a)>=2 else '',
            'replace':lambda a: str(a[0]).replace(str(a[1]),str(a[2])) if len(a)>=3 else str(a[0]),
            'hex':lambda a: hex(int(a[0])) if a else '0x0',
            'factorial':lambda a: float(math.factorial(int(a[0]))) if a else 1.0,
            'is_prime':lambda a: all(int(a[0])%i!=0 for i in range(2,int(math.sqrt(int(a[0])))+1)) if a else False,
            'fibonacci':lambda a: float(DaoMath.fibonacci(int(a[0]))) if a else 0.0,
            'matrix_mul':lambda a: DaoMath.matrix_multiply(a[0],a[1]) if len(a)>=2 else [],
            'fft':lambda a: DaoMath.fft(a[0]),
            'softmax':lambda a: _softmax(a[0]),
            'sigmoid':lambda a: _sigmoid(float(a[0])),
            'relu':lambda a: _relu(float(a[0])),
            'mandelbrot':lambda a: float(DaoMath.mandelbrot(float(a[0]),float(a[1]))),
            'noise':lambda a: DaoMath.noise2d(float(a[0]),float(a[1])),
            'fractal_noise':lambda a: DaoMath.fractal_noise(float(a[0]),float(a[1])),
        }

    def _print(self, args):
        parts=[]
        for arg in args:
            if isinstance(arg,float) and arg==int(arg): parts.append(str(int(arg)))
            elif isinstance(arg,list): parts.append('['+', '.join(str(x) for x in arg)+']')
            elif isinstance(arg,dict): parts.append('{'+', '.join(f'{k}:{v}' for k,v in arg.items())+'}')
            else: parts.append(str(arg))
        line=' '.join(parts); self.output_buffer.append(line); print(line); return line

    def run(self, program):
        for stmt in program: self.execute(stmt, self.globals)

    def execute(self, node, env):
        if isinstance(node,DNumberLit): return float(node.value)
        if isinstance(node,DStringLit): return node.value
        if isinstance(node,DBoolLit): return node.value
        if isinstance(node,DNilLit): return None
        if isinstance(node,DIdent):
            if node.name in env: return env[node.name]
            if node.name in self.builtins: return self.builtins[node.name]
            if node.name in self.globals: return self.globals[node.name]
            raise NameError(f"Undefined '{node.name}'")
        if isinstance(node,DBinOp): return self.exec_bin(node,env)
        if isinstance(node,DUnaryOp):
            val=self.execute(node.operand,env)
            return -float(val) if node.op=='-' else not val
        if isinstance(node,DAssign):
            val=self.execute(node.value,env); env[node.name]=val; self.globals[node.name]=val; return val
        if isinstance(node,DIndexAccess):
            obj=self.execute(node.obj,env); idx=self.execute(node.index,env)
            if isinstance(obj,list): return obj[int(idx)]
            if isinstance(obj,dict): return obj.get(str(idx))
            if isinstance(obj,str): return obj[int(idx)]
        if isinstance(node,DIndexAssign):
            obj=self.execute(node.obj,env); idx=self.execute(node.index,env); val=self.execute(node.value,env)
            if isinstance(obj,list): obj[int(idx)]=val
            elif isinstance(obj,dict): obj[str(idx)]=val
            return val
        if isinstance(node,DFuncDef): env[node.name]=DScriptFunc(node.params,node.body,env.copy()); return env[node.name]
        if isinstance(node,DFuncCall): return self.exec_call(node,env)
        if isinstance(node,DLambdaDef): return DScriptLambda(node.params,node.body,env.copy())
        if isinstance(node,DIfStmt):
            if self.execute(node.condition,env):
                be=env.copy()
                for s in node.then_body: self.execute(s,be)
                env.update(be)
            elif node.else_body:
                be=env.copy()
                for s in node.else_body: self.execute(s,be)
                env.update(be)
            return None
        if isinstance(node,DWhileLoop):
            while self.execute(node.condition,env):
                be=env.copy()
                try:
                    for s in node.body: self.execute(s,be)
                    env.update(be)
                except DBreakException: break
                except DContinueException: continue
            return None
        if isinstance(node,DForLoop):
            st=int(self.execute(node.start,env)); en=int(self.execute(node.end,env))
            step=int(self.execute(node.step,env)) if node.step else (1 if st<=en else -1)
            for i in range(st,en,step):
                env[node.var]=float(i); be=env.copy()
                try:
                    for s in node.body: self.execute(s,be)
                    env.update(be)
                except DBreakException: break
                except DContinueException: continue
            return None
        if isinstance(node,DLoopStmt):
            while True:
                try:
                    for s in node.body: self.execute(s,env)
                except DBreakException: break
            return None
        if isinstance(node,DReturnStmt): raise DReturnException(self.execute(node.value,env) if node.value else None)
        if isinstance(node,DBreakStmt): raise DBreakException()
        if isinstance(node,DContinueStmt): raise DContinueException()
        if isinstance(node,DPrintStmt): return self._print([self.execute(a,env) for a in node.args])
        if isinstance(node,DArrayLit): return [self.execute(e,env) for e in node.elements]
        if isinstance(node,DMapLit): return {str(self.execute(k,env)):self.execute(v,env) for k,v in node.pairs}
        if isinstance(node,DPropAccess):
            obj=self.execute(node.obj,env)
            if isinstance(obj,dict): return obj.get(node.prop)
            return None
        if isinstance(node,DBlockExpr):
            result=None; be=env.copy()
            for s in node.stmts: result=self.execute(s,be)
            env.update(be); return result
        return None

    def exec_bin(self, node, env):
        if node.op=='and': l=self.execute(node.left,env); return l if not l else self.execute(node.right,env)
        if node.op=='or': l=self.execute(node.left,env); return l if l else self.execute(node.right,env)
        l=self.execute(node.left,env); r=self.execute(node.right,env)
        if node.op=='+': return str(l)+str(r) if isinstance(l,str) or isinstance(r,str) else float(l)+float(r)
        if node.op=='-': return float(l)-float(r)
        if node.op=='*': return float(l)*float(r)
        if node.op=='/': return float(l)/float(r) if float(r)!=0 else 0
        if node.op=='%': return float(l)%float(r)
        if node.op=='^': return float(l)**float(r)
        if node.op=='==': return l==r
        if node.op=='!=': return l!=r
        if node.op=='<': return float(l)<float(r)
        if node.op=='>': return float(l)>float(r)
        if node.op=='>=': return float(l)>=float(r)
        if node.op=='<=': return float(l)<=float(r)
        return None

    def exec_call(self, node, env):
        callee=self.execute(node.callee,env)
        args=[self.execute(a,env) for a in node.args]
        if callable(callee) and not isinstance(callee,(DScriptFunc,DScriptLambda)): return callee(args)
        if isinstance(callee,(DScriptFunc,DScriptLambda)):
            fe=callee.closure.copy()
            for i,p in enumerate(callee.params): fe[p]=args[i] if i<len(args) else None
            try:
                if isinstance(callee.body,list):
                    result=None
                    for s in callee.body: result=self.execute(s,fe)
                    return result
                return self.execute(callee.body,fe)
            except DReturnException as e: return e.value
        raise TypeError(f"Cannot call non-function")


class DaoScriptEngine:
    def __init__(self): self.interp=DInterpreter(); self._load_stdlib()
    def _load_stdlib(self):
        lib="""
            fn factorial(n) { if n<=1 { return 1; } return n*factorial(n-1); }
            fn fibonacci(n) { if n<=0 { return 0; } if n==1 { return 1; } let a=0; let b=1; let i=2; while i<=n { let t=a+b; a=b; b=t; i=i+1; } return b; }
            fn bubble_sort(arr) { let n=len(arr); let i=0; while i<n { let j=0; while j<n-i-1 { if arr[j]>arr[j+1] { let t=arr[j]; arr[j]=arr[j+1]; arr[j+1]=t; } j=j+1; } i=i+1; } return arr; }
            fn quick_sort(arr) { if len(arr)<=1 { return arr; } let p=arr[0]; let l=[]; let r=[]; let i=1; while i<len(arr) { if arr[i]<p { push(l,arr[i]); } else { push(r,arr[i]); } i=i+1; } let res=[]; let sl=quick_sort(l); let sr=quick_sort(r); i=0; while i<len(sl) { push(res,sl[i]); i=i+1; } push(res,p); i=0; while i<len(sr) { push(res,sr[i]); i=i+1; } return res; }
            fn sum_array(arr) { let t=0; let i=0; while i<len(arr) { t=t+arr[i]; i=i+1; } return t; }
            fn is_prime(n) { if n<2 { return false; } if n<4 { return true; } if n%2==0 or n%3==0 { return false; } let i=5; while i*i<=n { if n%i==0 or n%(i+2)==0 { return false; } i=i+6; } return true; }
            fn primes_up_to(limit) { let r=[]; let i=2; while i<=limit { if is_prime(i) { push(r,i); } i=i+1; } return r; }
            fn gcd(a,b) { while b!=0 { let t=b; b=a%b; a=t; } return a; }
            fn power(base,exp) { let r=1; let i=0; while i<exp { r=r*base; i=i+1; } return r; }
            fn collatz(n) { let steps=0; while n!=1 { if n%2==0 { n=n/2; } else { n=3*n+1; } steps=steps+1; } return steps; }
            fn reverse_string(s) { let r=""; let i=len(s)-1; while i>=0 { r=r+s[i]; i=i-1; } return r; }
            fn hanoi(n,from,to,aux) { if n==1 { print("Move disk 1 from",from,"to",to); return; } hanoi(n-1,from,aux,to); print("Move disk",n,"from",from,"to",to); hanoi(n-1,aux,to,from); }
            fn knapsack(values,weights,capacity) { let n=len(values); let dp=[]; let i=0; while i<=n { let row=[]; let j=0; while j<=capacity { push(row,0); j=j+1; } push(dp,row); i=i+1; } i=1; while i<=n { let j=1; while j<=capacity { dp[i][j]=dp[i-1][j]; if weights[i-1]<=j { let v=values[i-1]+dp[i-1][j-weights[i-1]]; if v>dp[i][j] { dp[i][j]=v; } } j=j+1; } i=i+1; } return dp[n][capacity]; }
        """
        tokens=DLexer(lib).tokenize(); ast=DParser(tokens).parse(); self.interp.run(ast)

    def execute(self, code):
        tokens=DLexer(code).tokenize(); ast=DParser(tokens).parse()
        self.interp.output_buffer.clear(); self.interp.run(ast); return self.interp.output_buffer[:]


