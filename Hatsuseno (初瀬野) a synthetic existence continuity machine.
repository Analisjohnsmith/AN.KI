class StreetBus:
    def __init__(self, cpu: MandalaCPU, path: List[Coord]):
        self.cpu = cpu
        self.path = path

    def transfer(self, value: float) -> float:
        v = value
        for coord in self.path:
            if coord in self.cpu.memory:
                v += self.cpu.memory[coord]
        return v

    @staticmethod
    def line(a: Coord, b: Coord) -> List[Coord]:
        x1, y1 = a
        x2, y2 = b
        steps = max(abs(x2 - x1), abs(y2 - y1))
        if steps == 0:
            return [a]
        return [
            (int(x1 + (x2 - x1) * i / steps),
             int(y1 + (y2 - y1) * i / steps))
            for i in range(steps + 1)
        ]


