@dataclass
class MandalaCluster:
    nodes: Dict[str, MandalaCPU] = field(default_factory=dict)

    def add(self, name: str, cpu: MandalaCPU) -> None:
        self.nodes[name] = cpu
        cpu.cluster = self

    def tick_all(self):
        for cpu in self.nodes.values():
            cpu.tick()

    def route(self, source_cpu: MandalaCPU, value: float) -> float:
        for cpu in self.nodes.values():
            if cpu is not source_cpu:
                cpu.registers[1] += value
        return value

    def transfer_between(self, src_name: str, dst_name: str,
                         src_coord: Coord, dst_coord: Coord,
                         value: float) -> float:
        src = self.nodes[src_name]
        dst = self.nodes[dst_name]
        v = value + src.memory.get(src_coord, 0.0)
        dst.memory[dst_coord] = v
        return v


