    def render(self) -> str:
        cx, cy = self.cpu.center
        offset = self.size // 2
        grid = [[" " for _ in range(self.size)]
                for _ in range(self.size)]
        for r, cells in self.cpu.rings.items():
            pc = self.cpu.pc[r]
            for i, cell in enumerate(cells):
                x = cell.x - cx + offset
                y = cell.y - cy + offset
                if 0 <= x < self.size and 0 <= y < self.size:
                    if i == pc:
                        grid[y][x] = "@"
                    else:
                        name = REV_OP.get(cell.opcode, "?")
