// ================================================================

#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct StateMachine {
    pub registers: HashMap<String, i64>,
    pub log: Vec<ExecutionState>,
}

impl StateMachine {
    pub fn new() -> Self {
        Self {
            registers: HashMap::new(),
            log: Vec::new(),
        }
    }
    
    pub fn apply(&mut self, command: &str) {
        match command {
            "Fractal" => {
                *self.registers.entry("fractal_count".to_string()).or_insert(0) += 1;
            }
            "Chaos" => {
                *self.registers.entry("chaos_count".to_string()).or_insert(0) += 1;
            }
            "SoundPulse" => {
                *self.registers.entry("sound_count".to_string()).or_insert(0) += 1;
            }
            "Render" => {
                *self.registers.entry("render_count".to_string()).or_insert(0) += 1;
            }
            "Symbolic" => {
                *self.registers.entry("symbolic_count".to_string()).or_insert(0) += 1;
            }
            "NOP" => {}
            _ => {}
        }
    }
    
    pub fn apply_state(&mut self, state: &ExecutionState) {
        for cmd in &state.commands {
            self.apply(cmd);
        }
        self.log.push(state.clone());
    }
    
    pub fn snapshot(&self) -> serde_json::Value {
        serde_json::json!({
            "registers": self.registers,
            "log_length": self.log.len(),
        })
    }
}

