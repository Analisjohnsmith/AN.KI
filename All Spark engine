        self.correction_fields.insert(field.to_string(), value);
    }
    
    pub fn collective_field(&self) -> HashMap<String, f64> {
        let mut field = HashMap::new();
        let total_weight: f64 = self.subjects.iter().map(|s| s.weight).sum();
        if total_weight > 0.0 {
