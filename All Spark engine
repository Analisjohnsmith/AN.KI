            .x_label_area_size(40)
            .y_label_area_size(40)
            .build_cartesian_2d(0..max_x, min_y..max_y)?;
        
        chart.configure_mesh().draw()?;
        chart.draw_series(LineSeries::new(data.iter().map(|(x, y)| (*x, *y as i32)), &RED))?
            .label("Revenue")
            .legend(|(x, y)| PathElement::new(vec![(x, y), (x + 20, y)], &RED));
        
        chart.configure_series_labels()
            .background_style(&WHITE.mix(0.8))
            .border_style(&BLACK)
            .draw()?;
        
        Ok(())
    }
    
    // Cognition graph export (JSON-LD compatible)
    pub fn export_cognition_graph(persona: &Persona) -> Result<(), Box<dyn std::error::Error>> {
        let graph = serde_json::json!({
            "@context": "https://schema.org",
            "@type": "Graph",
            "nodes": persona.states.iter().enumerate().map(|(i, state)| {
                serde_json::json!({
                    "id": i,
                    "features": state,
                    "type": "cognitive_state",
                })
            }).collect::<Vec<_>>(),
            "edges": persona.expressions.iter().map(|(k, v)| {
                serde_json::json!({
                    "from": k,
                    "weight": v,
                })
            }).collect::<Vec<_>>(),
        });
        
        let json = serde_json::to_string_pretty(&graph)?;
        std::fs::write("cognition_graph.json", json)?;
        Ok(())
    }
    
    // Ritual export
    pub fn export_ritual_state(ecology: &RitualEcology) -> Result<(), Box<dyn std::error::Error>> {
        let ritual_state = serde_json::json!({
            "active_ritual": ecology.active_ritual,
            "total_rituals": ecology.rituals.len(),
            "rituals": ecology.rituals,
        });
        
        let json = serde_json::to_string_pretty(&ritual_state)?;
        std::fs::write("ritual_state.json", json)?;
        Ok(())
    }
