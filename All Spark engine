#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct ConsensusStatus {
    pub leader: String,
    pub term: u64,
    pub votes: usize,
    pub quorum: usize,
}

pub struct ConsensusNode {
    pub id: String,
    pub current_term: u64,
    pub voted_for: Option<String>,
    pub is_leader: bool,
    pub peers: Vec<String>,
    pub log: Vec<ExecutionState>,
}

impl ConsensusNode {
    pub fn new(id: &str) -> Self {
        Self {
            id: id.to_string(),
            current_term: 0,
            voted_for: None,
            is_leader: false,
            peers: Vec::new(),
            log: Vec::new(),
        }
    }
    
    pub fn add_peer(&mut self, peer_id: &str) {
        self.peers.push(peer_id.to_string());
    }
    
    pub fn election_timeout(&mut self) -> bool {
        rand::thread_rng().gen_bool(0.3)
    }
    
    pub fn elect_leader(&mut self) -> ConsensusStatus {
        self.current_term += 1;
        let mut rng = rand::thread_rng();
        let leader_id = if rng.gen_bool(0.5) {
            self.id.clone()
        } else {
            self.peers.first().unwrap_or(&"unknown".to_string()).clone()
        };
        self.is_leader = leader_id == self.id;
        self.voted_for = Some(leader_id.clone());
        
        ConsensusStatus {
            leader: leader_id,
            term: self.current_term,
            votes: self.peers.len() / 2 + 1,
            quorum: self.peers.len() / 2 + 1,
        }
    }
    
    pub fn replicate_log(&mut self, state: &ExecutionState) {
        self.log.push(state.clone());
    }
    
    pub fn snapshot(&self) -> serde_json::Value {
        serde_json::json!({
            "id": self.id,
            "term": self.current_term,
            "is_leader": self.is_leader,
            "peers": self.peers,
            "log_length": self.log.len(),
        })
    }
}

