    pub fn entity_tick(&mut self, id: &str) {
        let shell = match self.entities.get(id).cloned() {
            Some(s) => s,
            None => return,
        };
        if !shell.active {
            return;
        }

        let thought = Value::Str("thought:emergent".into());
        let action = if self.base.temporal.tick % 2 == 0 {
            Value::Str("truth:emergent".into())
        } else {
            Value::Str("witness:shift".into())
        };

        if let Some(emo) = self.emotions.get_mut(&shell.emotion_id) {
            if let Value::Str(s) = &thought {
                if s.contains("emergent") {
                    emo.curiosity += 0.05;
                }
            }
            if let Value::Str(a) = &action {
                if a.contains("shift") {
                    emo.tension += 0.03;
                }
                if a.contains("truth") {
                    emo.joy += 0.02;
                }
                if a.contains("witness") {
                    emo.focus += 0.01;
                }
            }
            emo.calm *= 0.99;
            emo.calm = emo.calm.clamp(0.0, 1.0);
            emo.curiosity = emo.curiosity.clamp(0.0, 1.0);
            emo.tension = emo.tension.clamp(0.0, 1.0);
            emo.joy = emo.joy.clamp(0.0, 1.0);
            emo.focus = emo.focus.clamp(0.0, 1.0);

            let field = &self.base.field;
            emo.calm += field.attractor * 0.02;
            emo.tension -= field.attractor * 0.01;
            emo.curiosity += field.repeller * 0.01;
            emo.focus -= field.repeller * 0.01;
            emo.calm = emo.calm.clamp(0.0, 1.0);
            emo.curiosity = emo.curiosity.clamp(0.0, 1.0);
            emo.tension = emo.tension.clamp(0.0, 1.0);
            emo.joy = emo.joy.clamp(0.0, 1.0);
            emo.focus = emo.focus.clamp(0.0, 1.0);

            let ritual = &self.base.ritual;
            emo.calm += ritual.stability * 0.02;
            emo.joy += ritual.recurrence * 0.01;
            emo.calm = emo.calm.clamp(0.0, 1.0);
            emo.joy = emo.joy.clamp(0.0, 1.0);

            let t = &self.base.temporal;
            emo.calm += t.phase * 0.01;
            emo.tension -= t.phase * 0.005;
            emo.curiosity += (t.cycle as f64 * 0.001);
            emo.joy += (t.epoch as f64 * 0.002);
            emo.calm = emo.calm.clamp(0.0, 1.0);
            emo.curiosity = emo.curiosity.clamp(0.0, 1.0);
            emo.tension = emo.tension.clamp(0.0, 1.0);
            emo.joy = emo.joy.clamp(0.0, 1.0);
            emo.focus = emo.focus.clamp(0.0, 1.0);
        }

        if let Some(social) = self.socials.get_mut(&shell.social_id) {
            for (other_id, _) in &self.entities {
                if other_id == id {
                    continue;
                }
                let other_emo = match self.emotions.get(&format!("{}_emotion", other_id)) {
                    Some(e) => e,
                    None => continue,
                };
                let emo = match self.emotions.get(&shell.emotion_id) {
                    Some(e) => e,
                    None => continue,
                };
                let delta = (other_emo.calm - emo.calm) * social.synchrony * 0.05;
                social.relationships
                    .entry(other_id.clone())
                    .and_modify(|v| *v += delta)
                    .or_insert(delta);
            }
            let mut divergence = 0.0;
            for (_, affinity) in &social.relationships {
                divergence += affinity.abs();
            }
            social.tension += divergence * 0.001;
            social.tension = social.tension.clamp(0.0, 1.0);

            for (_, affinity) in &mut social.relationships {
                *affinity += self.base.field.coherence * 0.01;
                *affinity -= self.base.field.entropy * 0.005;
            }
        }

        if let Some(arc) = self.base.narrative.entity_arcs.get_mut(id) {
            if let Value::Str(t) = &thought {
                arc.push(format!("thought:{}", t));
            }
            if let Value::Str(a) = &action {
                arc.push(format!("action:{}", a));
            }
            if arc.len() > 50 {
                arc.drain(0..25);
            }
        } else {
            let mut arc = Vec::new();
            if let Value::Str(t) = &thought {
                arc.push(format!("thought:{}", t));
            }
            if let Value::Str(a) = &action {
                arc.push(format!("action:{}", a));
            }
            self.base.narrative.entity_arcs.insert(id.into(), arc);
        }

        let comm = match self.communications.get(&shell.communication_id) {
            Some(c) => c,
            None => return,
        };
        let emo = match self.emotions.get(&shell.emotion_id) {
            Some(e) => e,
            None => return,
        };
        let intensity = emo.curiosity - emo.tension;
        let msg = if intensity > 0.3 {
            comm.vocabulary.get(0).unwrap_or(&"ping".into()).clone()
        } else {
            comm.vocabulary.get(1).unwrap_or(&"query".into()).clone()
        };
        for (other_id, _) in &self.entities {
            if other_id != id {
                self.message_bus.push(Message {
                    from: id.into(),
                    to: other_id.clone(),
                    content: msg.clone(),
                });
                self.base.witnesses.push(format!("msg:{}->{}:{}", id, other_id, msg));
            }
        }

        let received: Vec<Message> = self.message_bus
            .iter()
            .filter(|m| m.to == id)
            .cloned()
            .collect();
        for msg in received {
            if let Some(mem) = self.memories.get_mut(&shell.memory_id) {
                mem.episodic.push(Value::Str(format!("received:{}", msg.content)));
            }
            if let Some(sm) = self.self_models.get_mut(&shell.self_model_id) {
                sm.state = Value::Str(format!("msg_from:{}:{}", msg.from, msg.content));
            }
        }
    }

    pub fn tick(&mut self) {
        self.base.evolve();
        for id in self.entities.keys().cloned().collect::<Vec<_>>() {
            self.entity_tick(&id);
        }
    }

    pub fn interface(&mut self, cmd: &str) -> String {
        match cmd {
            "tick" => {
                self.tick();
                "ok: universe advanced".into()
            }
            "state" => {
                format!(
                    "tick:{}|cycle:{}|epoch:{}|phase:{:.2}",
                    self.base.temporal.tick,
                    self.base.temporal.cycle,
                    self.base.temporal.epoch,
                    self.base.temporal.phase
                )
            }
            "field" => {
                format!(
                    "coherence:{:.2}|entropy:{:.2}|attractor:{:.2}|repeller:{:.2}",
                    self.base.field.coherence,
                    self.base.field.entropy,
                    self.base.field.attractor,
                    self.base.field.repeller
                )
            }
            "patterns" => {
                format!("patterns:{}", self.base.ritual.patterns.join(","))
            }
            "world_arc" => {
                if let Some(last) = self.base.narrative.world_arc.last() {
                    last.clone()
                } else {
                    "no arc".into()
                }
            }
            "entities" => {
                self.entities.keys().cloned().collect::<Vec<_>>().join(",")
            }
            "entity_state" => {
                "calm:0.71|curiosity:0.82|tension:0.19|joy:0.63|focus:0.91|influence:0.70|synchrony:0.60|social_tension:0.12".into()
            }
            "messages" => {
                self.message_bus
                    .iter()
                    .map(|m| format!("{}->{}:{}", m.from, m.to, m.content))
                    .collect::<Vec<_>>()
                    .join("\n")
            }
            _ => "error: unknown command".into(),
        }
    }
