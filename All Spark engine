pub struct Universe {
    black_box: BlackBox,
    entities: HashMap<String, Entity>,
    observations: Vec<Emergence>,
}

impl Universe {
    pub fn new() -> Self {
        Universe {
            black_box: BlackBox::new(),
            entities: HashMap::new(),
            observations: Vec::new(),
        }
    }
    
    pub fn add_entity(&mut self, entity: Entity) {
        self.entities.insert(entity.id.clone(), entity);
    }
    
    pub fn tick(&mut self) -> Emergence {
        // Black Box evolves (math hidden)
        let emergence = self.black_box.tick();
        
        // Store observation
        self.observations.push(emergence.clone());
        if self.observations.len() > 1000 {
            self.observations.remove(0);
        }
        
        // Entities observe emergence (never math)
        for entity in self.entities.values_mut() {
            entity.observe(&emergence);
        }
        
        emergence
    }
    
    pub fn observe(&self) -> UniverseState {
        let emergence = self.black_box.observe();
        UniverseState {
            emergence,
            entity_count: self.entities.len(),
            entity_states: self.entities.values().map(|e| {
                (e.id.clone(), e.express())
            }).collect(),
        }
    }
    
    pub fn perturb(&mut self, strength: f64, focus: &str) -> Emergence {
        self.black_box.perturb(strength, focus)
    }
}

