    pub consensus: ConsensusNode,
    pub population: PopulationEngine,
    pub children: Vec<SyntheticDevice>,
}

impl SyntheticDevice {
    pub fn new(id: &str, owner: &str) -> Self {
        Self {
            platform: Platform::new(id, owner, "Synthetic-OS-Persona"),
            state_machine: StateMachine::new(),
            manifold: Manifold::new(),
            persona: Persona::new(),
            consensus: ConsensusNode::new(id),
            population: PopulationEngine::new(),
            children: Vec::new(),
        }
    }
    
    pub fn add_peer(&mut self, peer_id: &str) {
        self.consensus.add_peer(peer_id);
    }
    
    pub fn spawn_child(&mut self, id: &str, owner: &str) {
        let child = SyntheticDevice::new(id, owner);
        self.children.push(child);
        self.platform.register(Node {
            name: format!("child_{}", id),
            kind: "device".to_string(),
            payload: serde_json::json!({ "id": id }),
            metadata: HashMap::new(),
        });
    }
    
    pub fn execute(&mut self, commands: Vec<String>) -> ExecutionState {
        let mut state = ExecutionState::new(commands);
        state.tick();
        
        // Apply to state machine
        self.state_machine.apply_state(&state);
        
        // Express through persona
        self.persona.apply_state(&state);
        
        // Evolve manifold
        let manifold_state = self.manifold.step();
        self.persona.express_state(manifold_state.0);
        
        // Consensus
        if self.consensus.election_timeout() {
            let consensus = self.consensus.elect_leader();
            self.platform.nodes.insert(
                "consensus".to_string(),
                Node {
                    name: "consensus".to_string(),
                    kind: "kernel".to_string(),
                    payload: serde_json::json!(consensus),
                    metadata: HashMap::new(),
                }
            );
        }
        self.consensus.replicate_log(&state);
        
        state
    }
    
    pub fn activate(&mut self) {
        self.platform.register(Node {
            name: "state_machine".to_string(),
            kind: "kernel".to_string(),
            payload: self.state_machine.snapshot(),
            metadata: HashMap::new(),
        });
        
        self.platform.register(Node {
            name: "manifold".to_string(),
            kind: "atlas".to_string(),
            payload: self.manifold.spectral_field(),
            metadata: HashMap::new(),
        });
        
        self.platform.register(Node {
            name: "persona".to_string(),
            kind: "synthetic".to_string(),
            payload: self.persona.snapshot(),
            metadata: HashMap::new(),
        });
        
        self.platform.register(Node {
            name: "consensus".to_string(),
            kind: "kernel".to_string(),
            payload: self.consensus.snapshot(),
            metadata: HashMap::new(),
        });
        
        for child in &mut self.children {
            child.activate();
        }
    }
    
    pub fn status(&self) -> serde_json::Value {
        serde_json::json!({
            "platform": self.platform.status(),
            "state_machine": self.state_machine.snapshot(),
            "manifold": self.manifold.spectral_field(),
            "persona": self.persona.snapshot(),
            "consensus": self.consensus.snapshot(),
            "children_count": self.children.len(),
        })
    }
}

