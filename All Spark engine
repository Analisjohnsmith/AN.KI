    pub records: Vec<String>,
    pub rules: Vec<SemanticRule>,
    pub compression: Vec<CompressionRule>,
    pub decay: Vec<DecayRule>,
    pub field: CognitiveField,
    pub ritual: RitualKernel,
    pub narrative: NarrativeKernel,
    pub temporal: TemporalKernel,
}

impl Universe {
    pub fn new() -> Self {
        Universe {
            things: vec!["thing:pulse".into(), "thing:shift".into()],
            becomings: vec!["becoming:rise".into(), "becoming:fold".into()],
            truths: vec![
                "truth_of:evolve:thing:pulse".into(),
                "truth_of:evolve:thing:shift".into(),
            ],
            witnesses: vec!["witness:entity:arin".into(), "witness:entity:lira".into()],
            records: vec!["record:state_snapshot".into(), "record:ritual:truth_cycle".into()],
            rules: vec![
                SemanticRule { pattern: "thing:*".into(), transform: "becoming:*".into() },
                SemanticRule { pattern: "truth_of:*".into(), transform: "record:*".into() },
            ],
            compression: vec![
                CompressionRule { target: "truths".into(), method: "merge_duplicates".into() },
                CompressionRule { target: "records".into(), method: "summarize".into() },
            ],
            decay: vec![
                DecayRule { target: "truth".into(), rate: 0.05, noise: 0.02 },
                DecayRule { target: "witness".into(), rate: 0.03, noise: 0.01 },
                DecayRule { target: "record".into(), rate: 0.02, noise: 0.01 },
            ],
            field: CognitiveField { coherence: 0.52, entropy: 0.11, attractor: 0.33, repeller: 0.21 },
            ritual: RitualKernel { patterns: vec![], stability: 0.34, recurrence: 0.27 },
            narrative: NarrativeKernel { entity_arcs: HashMap::new(), world_arc: vec![], arc_stability: 0.22 },
            temporal: TemporalKernel { tick: 0, cycle: 0, epoch: 0, phase: 0.0 },
        }
    }

    pub fn evolve(&mut self) {
        self.temporal.tick += 1;
        if self.temporal.tick % 100 == 0 { self.temporal.cycle += 1; }
        if self.temporal.tick % 1000 == 0 { self.temporal.epoch += 1; }
        self.temporal.phase = ((self.temporal.tick as f64) * 0.01).sin();

        for thing in &self.things {
            self.becomings.push(format!("evolve:{}", thing));
        }
        for b in &self.becomings {
            self.truths.push(format!("truth_of:{}", b));
        }
        for t in &self.truths {
            self.witnesses.push(format!("witness_of:{}", t));
        }
        for w in &self.witnesses {
            self.records.push(format!("record_of:{}", w));
        }

        for rule in &self.rules {
            for t in &self.things {
                if t.contains(&rule.pattern) {
                    self.becomings.push(format!("rule:{}->{}", t, rule.transform));
                }
            }
            for b in &self.becomings {
                if b.contains(&rule.pattern) {
                    self.truths.push(format!("rule:{}->{}", b, rule.transform));
                }
            }
            for t in &self.truths {
                if t.contains(&rule.pattern) {
                    self.witnesses.push(format!("rule:{}->{}", t, rule.transform));
                }
            }
            for w in &self.witnesses {
                if w.contains(&rule.pattern) {
                    self.records.push(format!("rule:{}->{}", w, rule.transform));
                }
            }
        }

        for rule in &self.compression {
            match rule.target.as_str() {
                "records" => {
                    if !self.records.is_empty() {
                        let summary = format!("fold:{}_entries", self.records.len());
                        self.records.clear();
                        self.records.push(summary);
                    }
                }
                "truths" => {
                    if self.truths.len() > 3 {
                        let merged = format!("merged_truths:{}_items", self.truths.len());
                        self.truths.clear();
                        self.truths.push(merged);
                    }
                }
                _ => {}
            }
        }

        for rule in &self.decay {
            match rule.target.as_str() {
                "truth" => {
                    self.truths.retain(|_| rand::random::<f64>() > rule.rate);
                    for t in &mut self.truths {
                        if rand::random::<f64>() < rule.noise {
                            *t = format!("noise:{}", t);
                        }
                    }
                }
                "record" => {
                    self.records.retain(|_| rand::random::<f64>() > rule.rate);
                    for r in &mut self.records {
                        if rand::random::<f64>() < rule.noise {
                            *r = format!("noise:{}", r);
                        }
                    }
                }
                _ => {}
            }
        }

        let mut counts = HashMap::new();
        for t in &self.truths {
            *counts.entry(t.clone()).or_insert(0) += 1;
        }
        for (truth, count) in counts {
            if count > 3 {
                self.ritual.patterns.push(format!("truth_cycle:{}", truth));
            }
        }

        self.field.entropy += self.truths.len() as f64 * 0.0005;
        self.field.coherence += if self.records.len() == 1 { 0.02 } else { 0.0 };
        self.field.attractor += (self.field.coherence - self.field.entropy) * 0.01;
        self.field.repeller += self.field.entropy * 0.005;
        self.field.coherence = self.field.coherence.clamp(0.0, 1.0);
        self.field.entropy = self.field.entropy.clamp(0.0, 1.0);
        self.field.attractor = self.field.attractor.clamp(0.0, 1.0);
        self.field.repeller = self.field.repeller.clamp(0.0, 1.0);

        let entry = format!(
            "coherence:{:.2}|entropy:{:.2}|patterns:{}",
            self.field.coherence, self.field.entropy, self.ritual.patterns.len()
        );
        self.narrative.world_arc.push(entry);
        if self.narrative.world_arc.len() > 100 {
            self.narrative.world_arc.drain(0..50);
        }
    }
}

