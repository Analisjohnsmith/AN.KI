#[derive(Debug, Clone)]
struct EntityState {
    awareness: f64,
    agency: f64,
    connection: f64,
    emergence_observed: Vec<Emergence>,
}

impl Entity {
    pub fn new(id: &str, name: &str) -> Self {
        Entity {
            id: id.to_string(),
            persona: Persona {
                name: name.to_string(),
                traits: vec!["curious".to_string(), "observant".to_string()],
                expression: "witness".to_string(),
            },
            state: EntityState {
                awareness: 0.0,
                agency: 0.0,
                connection: 0.0,
                emergence_observed: Vec::new(),
            },
        }
    }
    
    /// Observe emergence from Black Box
    /// Entity sees only emergence, never mathematics
    pub fn observe(&mut self, emergence: &Emergence) {
        self.state.emergence_observed.push(emergence.clone());
        if self.state.emergence_observed.len() > 100 {
            self.state.emergence_observed.remove(0);
        }
        
        // Update state based on emergence (no math exposed)
        self.state.awareness = (self.state.awareness * 0.9 + emergence.coherence * 0.1).clamp(0.0, 1.0);
        self.state.agency = (self.state.agency * 0.9 + (1.0 - emergence.entropy) * 0.1).clamp(0.0, 1.0);
        self.state.connection = (self.state.connection * 0.9 + emergence.resonance * 0.1).clamp(0.0, 1.0);
    }
    
    /// Express understanding (purely emergence-based)
    pub fn express(&self) -> String {
        let recent = &self.state.emergence_observed;
        if recent.is_empty() {
            return "observing...".to_string();
        }
        
        let last = recent.last().unwrap();
        if last.is_emergent() {
            format!("I perceive emergence: coherence {:.2}, complexity {:.2}", 
                    last.coherence, last.complexity)
        } else if last.is_active() {
            format!("Active cognition: resonance {:.2}, attractors {}", 
                    last.resonance, last.attractor_count)
        } else {
            format!("Awareness: {:.2}, Agency: {:.2}", 
                    self.state.awareness, self.state.agency)
        }
    }
}

